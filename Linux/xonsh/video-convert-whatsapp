#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Shrink videos to something WhatsApp will accept, then cut them into 80-second
// segments so they fit inside a status post.
//
// Two-pass H.264: the first pass only measures the video, the second uses those
// measurements to spend the bitrate where it matters.

ArgVals a = new Args("video-convert-whatsapp", "Convert videos for sharing on WhatsApp")
    .Opt("-b", "--bitrate", @default: "500", help: "Bitrate for video conversion in kb/s")
    .Rest("files", min: 1, help: "Files to process")
    .Parse(args);

int bitrate = a.Int("bitrate", 500);
string timestamp = Fs.Timestamp();

Ui.Begin("Convert videos for sharing on WhatsApp");

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);
List<string> videos = allFiles.Where(Fs.IsVideo).ToList();

foreach (string? skipped in allFiles.Where(f => !Fs.IsVideo(f)))
    Ui.Warn($"Skipping {skipped}");

if (videos.Count == 0) return Ui.NoFiles("No videos selected!");

int failures = 0;

// Serial on purpose — maxParallel: 1 rather than a -j flag. Both passes share one
// "-passlogfile temp_log", and pass 2 reads back the statistics pass 1 wrote there, so
// two videos encoding at once would overwrite each other's log and pass 2 would size
// its bitrate from the wrong film. The nested display is still worth having: it is what
// carries the per-pass percentage.
//
// The bars below come from ffmpeg's own "-progress pipe:1" reports, measured against
// the source's running time, so they move with the encode rather than guessing.
Ui.Track2(videos, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"WhatsApp {videos.Count} video(s):"))}[/]",
          (file, addBar) =>
{
    (string? filename, string _) = Fs.SplitExt(file);
    string convertedDir = $"{filename}-{timestamp}";
    string splitDir = $"{filename}-split-{timestamp}";

    Directory.CreateDirectory(convertedDir);
    Directory.CreateDirectory(splitDir);

    // The tag rides along in the file name so the converted copy is obvious.
    string fullFilename = $"{filename} #whatsapp.mp4";
    string converted = Path.Combine(convertedDir, fullFilename);

    // Shared between the two passes so the encoder settings pass 1 measures are the
    // ones pass 2 encodes with.
    string[] common =
    [
        "-c:v", "libx264", "-b:v", $"{bitrate}k", "-crf", "23",
        "-maxrate", $"{bitrate}k", "-bufsize", $"{bitrate * 2}k",
    ];

    // Pass 1 writes its output to /dev/null and leaves only temp_log behind, so there
    // is no file for ConvertWithProgress to check and RunWithProgress is the right
    // half of it to call. Its bar still measures the real thing: this pass reads the
    // whole video, and takes a comparable share of the total time.
    Action<double> pass1Bar = addBar(
        $"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file} (pass 1 of 2):"))}[/]", 100);

    List<string> pass1Args =
    [
        "-i", file, ..common,
        "-pass", "1", "-r", "30", "-an", "-passlogfile", "temp_log",
        "-f", "null", "/dev/null",
    ];

    (bool pass1, double reported1) = Media.RunWithProgress(file, pass1Args, pass1Bar);

    if (!pass1)
    {
        Ui.Line($"[bold red]First pass failed for {Ui.Esc(file)}[/]");
        Snd.Error();
        Interlocked.Increment(ref failures);
        return;
    }

    // ffmpeg's last report stops a little short of the end; only fill the bar now that
    // the pass has succeeded, so a failure above stays visibly incomplete.
    if (reported1 < 100) pass1Bar(100 - reported1);

    Action<double> pass2Bar = addBar(
        $"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file} (pass 2 of 2):"))}[/]", 100);

    // This pass writes the real file, so the written-output check matters here: -n
    // makes ffmpeg refuse an existing output and still exit 0, and ConvertWithProgress
    // is what catches that.
    List<string> pass2Args =
    [
        "-i", file, ..common,
        "-pass", "2", "-r", "30", "-fps_mode", "cfr", "-n",
        "-c:a", "aac", "-b:a", "32k", "-ac", "1",
        "-passlogfile", "temp_log", converted,
    ];

    bool pass2 = Media.ConvertWithProgress(file, converted, pass2Args, pass2Bar);

    if (!pass2)
    {
        Ui.Line($"[bold red]Second pass failed for {Ui.Esc(file)}[/]");
        Snd.Error();
        Interlocked.Increment(ref failures);
        return;
    }

    // The converted copy carries the source's date.
    Fs.CopyTimestamp(file, converted);

    // Segment the converted copy. -c copy, so this is a cut, not another encode, and
    // it finishes fast enough not to be worth a bar of its own.
    foreach (string video in Directory.EnumerateFiles(convertedDir, "*", SearchOption.AllDirectories))
    {
        Proc.Ok("ffmpeg", "-i", video, "-c", "copy", "-f", "segment",
                "-segment_time", "80", "-reset_timestamps", "1", "-map", "0",
                Path.Combine(splitDir, $"{filename} %03d.mp4"));
    }

    // The segments are one source split many ways, so each needs a distinct stamp:
    // an identical one across all of them leaves a date-sorted listing with nothing
    // to order them by, and a file manager's tie-break can show 003 before 001.
    int segment = 0;
    foreach (string? part in Directory.GetFiles(splitDir).OrderBy(f => f, StringComparer.Ordinal))
        Fs.CopyTimestamp(file, part, segment++);

    Ui.Line($"[green]Converted and split {Ui.Esc(file)}[/]");
}, maxParallel: 1);

// The two-pass log files are scratch data and are of no use once pass 2 is done.
foreach (string log in Directory.GetFiles(".", "temp_log*"))
{
    try { File.Delete(log); } catch { /* a leftover log is harmless */ }
}

return Ui.Done(failures);
