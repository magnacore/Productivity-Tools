#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Convert audio to Opus (or FLAC) at a bitrate chosen by what the audio is for.
//
// Opus handles 6-510 kb/s, 8-48 kHz, CBR and VBR, speech and music, which is why
// one codec covers every case below. Bitrates follow Xiph's recommendations:
//     https://wiki.xiph.org/Opus_Recommended_Settings
//
//     Usage: audio-convert-foss 128 *

var a = Jobs.Add(new Args("audio-convert-foss", "Convert audio files to Opus or FLAC")
    .Pos("bitrate", "Bitrate in kb/s (Opus accepts 6-510; ignored for FLAC)")
    .Opt("-c", "--codec", @default: "opus", choices: ["opus", "flac"],
         help: "Target codec; flac is lossless and ignores the bitrate")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Audio/")
    .Rest("files", min: 1, help: "Files to convert"))
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);
// Opus refuses anything outside this range.
int bitrate = Math.Clamp(a.Int("bitrate", 128), 6, 510);

bool lossless = a.Str("codec") == "flac";
var codec = lossless ? "flac" : "libopus";
var newExtension = lossless ? ".flac" : ".opus";

Ui.Begin(lossless
    ? "Converting audio to FLAC (lossless)..."
    : $"Converting audio to variable {bitrate}kbps Opus...");

// Slugify first so the generated output names are predictable.
var cleanFileNames = Fs.RenameToValid(allFiles);

bool deleteOriginals = a.Flag("delete");

// Independent per file, and the encoder is single-core, so run several at once.
// -j 1 for a spinning disk, where concurrent streams cost more than they gain.
int failures = 0;

Ui.Track2(cleanFileNames,
          $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Converting {cleanFileNames.Count}:"))}[/]",
          (file, addBar) =>
{
    if (!Fs.IsAudio(file)) return;

    var (name, extension) = Fs.SplitExt(file);
    extension = extension.ToLowerInvariant().Trim();

    // Opus to Opus would collide with its own source name.
    var filename = extension == ".opus" ? name + "-converted" + newExtension : name + newExtension;

    if (lossless && extension == ".flac")
    {
        Ui.Line($"[bold red]Skipping converting {Ui.Esc(file)} to .flac[/]");
        return;
    }

    var advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 100);

    if (Media.ConvertWithProgress(
            file, filename,
            ["-i", file, "-c:a", codec, "-b:a", $"{bitrate}k",
             "-vn", "-af", "volume=1.0", "-vbr", "on", filename], advance))
    {
        // Carry the date across before the original is moved away, so a
        // modified-time sort keeps the collection in its original order.
        Fs.CopyTimestamp(file, filename);
        Ui.Line($"[green]Converted {Ui.Esc(file)} to {Ui.Esc(filename)}[/]");
        Fs.HandleOriginal(file, deleteOriginals, "Audio");
    }
    else
    {
        Ui.Line($"[bold red]Unable to convert {Ui.Esc(file)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
