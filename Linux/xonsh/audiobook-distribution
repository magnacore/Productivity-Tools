#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package ScottPlot@5.1.59
#:property Configuration=Release
#:include utilities.cs

// Chart how the audiobook library is spread across its numeric prefixes, and drop
// the image into the capture inbox to be looked at later.
//
// Each prefix gets its own bar, and a dashed line marks the mean, so an uneven
// distribution is obvious at a glance.

using System.Text.RegularExpressions;

var a = new Args("audiobook-distribution", "Plot the distribution of numeric filename prefixes")
    .Opt("-d", "--directory", help: "Directory to examine (defaults to the audiobook bin)")
    .Opt("-o", "--output", help: "Where to write the PNG (defaults to the capture inbox)")
    .Parse(args);

var directory = a.StrOrNull("directory")
    ?? Path.Combine(Paths.ProductivitySystem, "04 BIN", "04 RA RP SP", "TRAVEL", "BIN", "2 NON-FICTION");

if (!Directory.Exists(directory))
{
    Ui.Err($"No such directory: {directory}");
    return 1;
}

Ui.Begin("Audiobook distribution");

// A prefix of exactly 3 or 4 digits, not followed by another digit.

var numbers = new List<int>();
foreach (var path in Directory.GetFileSystemEntries(directory))
{
    var match = Pattern.NumericPrefix().Match(Path.GetFileName(path));
    if (match.Success) numbers.Add(int.Parse(match.Groups[1].Value));
}

if (numbers.Count == 0)
{
    Ui.Warn("No valid 3 or 4 digit prefix files found.");
    Ui.End();
    return 1;
}

int minNum = numbers.Min();
int maxNum = numbers.Max();

// One bin per integer in the range, so nothing is smoothed away.
var counts = new Dictionary<int, int>();
foreach (var n in numbers) counts[n] = counts.GetValueOrDefault(n) + 1;

double meanFreq = counts.Values.Average();

var plot = new ScottPlot.Plot();

var bars = Enumerable.Range(minNum, maxNum - minNum + 1)
    .Select(value => new ScottPlot.Bar
    {
        Position = value,
        Value = counts.GetValueOrDefault(value),
        FillColor = ScottPlot.Color.FromHex("#0504aa"),
        FillStyle = { AntiAlias = true },
        LineWidth = 0,
    })
    .ToList();

plot.Add.Bars(bars);

// The mean line is what turns a bar chart into a judgement about balance.
var meanLine = plot.Add.HorizontalLine(meanFreq);
meanLine.Color = ScottPlot.Colors.Red;
meanLine.LineWidth = 2;
meanLine.LinePattern = ScottPlot.LinePattern.Dashed;

plot.XLabel("Value");
plot.YLabel("Frequency");
plot.Title("Histogram of Filename Prefixes");
plot.Axes.Margins(bottom: 0);

var savePath = a.StrOrNull("output")
    ?? Path.Combine(Paths.TaskCaptureBin, $"audiobook-{Fs.Timestamp()}.png");

var parent = Path.GetDirectoryName(savePath);
if (!string.IsNullOrEmpty(parent)) Directory.CreateDirectory(parent);

// 1280x720, matching the original's 12.8x7.2 inches at 100 dpi.
plot.SavePng(savePath, 1280, 720);

Ui.Ok($"Wrote {savePath}");
Ui.Line($"[dim]{numbers.Count} files, prefixes {minNum}-{maxNum}, mean frequency {meanFreq:0.##}[/]");

Ui.End();
return 0;

/// Source-generated matchers. Emitted at build time, so nothing parses a pattern
/// at startup — which matters for a program that runs for well under a second.
internal static partial class Pattern
{
    /// A filename prefix of exactly 3 or 4 digits.
    [GeneratedRegex(@"^(\d{3,4})(?!\d)")]
    internal static partial Regex NumericPrefix();
}
