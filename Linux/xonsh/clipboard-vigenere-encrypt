#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Vigenere-encrypt the clipboard in place, using the keyword stored in
// ~/Documents/SENSITIVE DATA/vigenere_master_password.txt.
//
// A Vigenere cipher is trivially breakable by anyone who tries. This is for
// keeping notes unreadable at a glance, not for protecting secrets.

ArgVals a = new Args("clipboard-vigenere-encrypt", "Vigenere-encrypt the clipboard in place")
    .Parse(args);

Ui.Begin("Encrypting clipboard using Vigenere Cipher...");

string keyFile = Path.Combine(Paths.SensitiveData, "vigenere_master_password.txt");

if (!File.Exists(keyFile))
{
    Ui.Err($"Missing keyword file: {keyFile}");
    Snd.Error();
    Ui.End();
    return 1;
}

string? keyword = File.ReadLines(keyFile).FirstOrDefault()?.Trim();

if (string.IsNullOrEmpty(keyword))
{
    Ui.Err("The keyword file is empty.");
    Snd.Error();
    Ui.End();
    return 1;
}

string clipboardContent = Clip.Paste();

if (clipboardContent.Length == 0)
{
    Ui.Err("Clipboard is empty.");
    Snd.Error();
    Ui.End();
    return 1;
}

// A trailing newline shifts every position on decryption, so refuse it outright
// rather than silently producing something that will not come back.
if (clipboardContent.EndsWith('\n') || clipboardContent.EndsWith('\r'))
{
    Ui.Err("Error: Content ends with a newline. Remove newline and try again.");
    Snd.Error();
    Ui.End();
    return 1;
}

string key = Crypto.VigenereKey(clipboardContent, keyword);
string cipherText = Crypto.Encrypt(clipboardContent, key);

Clip.Copy(cipherText);

// Decrypt what actually landed on the clipboard, so a mangled round trip is
// caught here rather than when the text is needed back.
string plainText = Crypto.Decrypt(Clip.Paste(), key);

if (plainText != clipboardContent)
{
    Ui.Err("ERROR!");
    Snd.Error();
    Ui.End();
    return 1;
}

Ui.Line($"Copied: Vigenere encryption of [bold cyan]{Ui.Esc(clipboardContent)}[/] " +
        $"is [bold green]{Ui.Esc(cipherText)}[/]");

// Edge spaces are invisible when pasted and silently break decryption.
string visible = cipherText.Replace(" ", "<SPACE>");
if (cipherText[0] == ' ')
    Ui.Err($"Warning: Ciphertext contains a leading space! {visible}");
else if (cipherText[^1] == ' ')
    Ui.Err($"Warning: Ciphertext contains a trailing space! {visible}");

return Ui.Done();
