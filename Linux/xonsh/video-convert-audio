#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Lift the audio track out of videos without re-encoding it.
//
// The output is .mka because not every video carries Opus audio, and the ogg
// container only accepts Opus. Matroska takes whatever codec is already there.

ArgVals a = Jobs.Add(new Args("video-convert-audio", "Extract the audio track from videos into .mka")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Video/")
    .Rest("files", min: 1, help: "Files to process"))
    .Parse(args);

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin("Extracting audio form video...");

bool deleteOriginals = a.Flag("delete");

// A stream copy, so this is bound by disk rather than CPU — but several at once
// still overlaps the reads. -j 1 on a spinning disk.
int failures = 0;

Ui.Track2(allFiles, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Extracting from {allFiles.Count}:"))}[/]",
          (file, addBar) =>
{
    if (!Fs.IsVideo(file)) return;

    string filename = Fs.SplitExt(file).Name + ".mka";

    // -n so an existing extraction is never silently overwritten.
    Action<double> advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 100);

    if (Media.ConvertWithProgress(
            file, filename,
            ["-i", file, "-n", "-vn", "-hide_banner",
             "-loglevel", "error", "-acodec", "copy", filename], advance))
    {
        // Carry the date across before the original is moved away, so a
        // modified-time sort keeps the collection in its original order.
        Fs.CopyTimestamp(file, filename);
        Ui.Line($"[bold green] Extracted: {Ui.Esc(file)}[/]");
        Fs.HandleOriginal(file, deleteOriginals, "Video");
    }
    else
    {
        Ui.Line($"[bold red] Unable to extract: {Ui.Esc(file)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
