#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Shut the encrypted backup disk down safely and power it off.
//
// The order matters and each step needs the previous one to have settled, which
// is what the pauses are for: flush writes, unmount, deactivate the LVM group,
// close the LUKS container, then cut power. Skipping ahead risks the disk being
// pulled with writes still in flight.

var a = Sys.WithDryRun(new Args("laptop-backup-full-eject", "Safely unmount and power off the full-backup disk")).Parse(args);
Sys.Apply(a);

Ui.Begin("Eject Laptop Backup Full...");

var mountPoint = Path.Combine(Paths.Media, "laptop_backup_full");

Ui.Info("Syncing...");
Sys.Run("sync");
Settle();

Ui.Info("Unmounting...");
Sys.Sudo("umount", mountPoint);
Settle();

Ui.Info("Deleting Mountpoint...");
Sys.Sudo("rm", "-r", mountPoint);
Settle();

Ui.Info("Unmounting logical volumes...");
Sys.Sudo("lvchange", "-an", "vg-laptop-backup-full");
Settle();

Ui.Info("Closing encrypted LUKS container...");
Sys.Sudo("cryptsetup", "luksClose", "luks-laptop-backup-full");

Ui.Info("Waiting for 3 seconds before turning off...");
Settle();

Ui.Info("Powering off...");
Sys.Run("udisksctl", "power-off", "-b", "/dev/sda");

Sys.Run("lsblk");

Ui.Info("Empty trash...");
Sys.Run("trash-empty", "-f");

return Ui.Done();

/// Let the kernel finish the previous step before starting the next.
static void Settle()
{
    if (!Sys.DryRun) Thread.Sleep(3000);
}
