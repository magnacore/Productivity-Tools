#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Run the maintenance pass, then power the machine off — for starting at the end
// of the day and walking away.

ArgVals a = Sys.WithDryRun(new Args("update-shutdown", "Run shortcut-update, then shut down")).Parse(args);
Sys.Apply(a);

int code = Proc.Call("shortcut-update", Sys.DryRun ? ["--dry-run"] : []);

if (code != 0)
{
    // A failed update is worth waking up to, so do not hide it behind a shutdown.
    Ui.Err($"shortcut-update exited with {code}; not shutting down.");
    Snd.Error();
    return code;
}

Ui.Info("Shutting down...");
Sys.Sudo("shutdown", "-h", "now");

return 0;
