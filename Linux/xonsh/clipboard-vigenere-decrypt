#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Vigenere-decrypt the clipboard in place — the inverse of
// clipboard-vigenere-encrypt, using the same stored keyword.

ArgVals a = new Args("clipboard-vigenere-decrypt", "Vigenere-decrypt the clipboard in place")
    .Parse(args);

Ui.Begin("Decrypting clipboard using Vigenere Cipher...");

string keyFile = Path.Combine(Paths.SensitiveData, "vigenere_master_password.txt");

if (!File.Exists(keyFile))
{
    Ui.Err($"Missing keyword file: {keyFile}");
    Snd.Error();
    Ui.End();
    return 1;
}

string? keyword = File.ReadLines(keyFile).FirstOrDefault()?.Trim();

if (string.IsNullOrEmpty(keyword))
{
    Ui.Err("The keyword file is empty.");
    Snd.Error();
    Ui.End();
    return 1;
}

string clipboardContent = Clip.Paste();

if (clipboardContent.Length == 0)
{
    Ui.Err("Clipboard is empty.");
    Snd.Error();
    Ui.End();
    return 1;
}

string key = Crypto.VigenereKey(clipboardContent, keyword);
string plainText = Crypto.Decrypt(clipboardContent, key);

Clip.Copy(plainText);

Ui.Line($"Copied: Vigenere decryption of [bold cyan]{Ui.Esc(clipboardContent)}[/] " +
        $"is [bold green]{Ui.Esc(plainText)}[/]");

return Ui.Done();
