#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Split long media into session-sized parts, then tag the parts with their
// position in the set so progress is visible from the file name alone.
//
// Two ways to divide a file, and the difference is what happens to the time that
// does not divide evenly. --equal spreads it, so every part is the same length and
// nothing is left over, stretching each part up to --max-part before cutting another
// one instead. Without --equal each part is exactly the length asked for and the
// remainder becomes a final, shorter part, unless it is below --min-part, in which
// case the part before it swallows it rather than leaving a two second file nobody
// wants.
//
// Only files longer than --threshold_seconds are touched. Parts inherit their
// source's modified time, so splitting some files in a folder and leaving others
// alone keeps the whole folder in its original order.

ArgVals a = new Args("media-split-equal", "Split media files into parts")
    .Opt("-s", "--split_duration", required: true, help: "Duration in seconds to split the media")
    .Opt("-t", "--threshold_seconds", required: true,
         help: "Seconds below which a file is left alone entirely")
    // No declared default: the real one is twice --split_duration, which is not known
    // until the arguments are parsed, and declaring "0" would advertise a nonsense
    // value in --help.
    .Opt("-x", "--max-part",
         help: "Equal mode only: the longest a part may be stretched to (default: twice --split_duration)")
    .Flag("-e", "--equal", help: "Equal parts with no remainder, rather than exact parts with a short last one")
    .Opt("-m", "--min-part", @default: "30",
         help: "Fixed mode only: seconds below which a leftover part is absorbed instead of kept")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Media/")
    .Rest("files", min: 1, help: "Files to process")
    .Parse(args);

int splitDuration = a.Int("split_duration");
int thresholdSeconds = a.Int("threshold_seconds");

// Twice the part length by default, which is the ratio the five minute preset has
// always had. Only equal mode consults it, and only to decide whether to stretch the
// parts or cut another one.
int maxPart = a.Int("max-part") > 0 ? a.Int("max-part") : splitDuration * 2;
int minPart = a.Int("min-part");
bool equal = a.Flag("equal");

if (splitDuration <= 0)
{
    Console.Error.WriteLine("error: --split_duration must be positive");
    return 2;
}

if (minPart < 0)
{
    Console.Error.WriteLine("error: --min-part cannot be negative");
    return 2;
}

// Slugify first: mkvmerge's --split writes sibling files, and awkward characters
// in the stem make the generated part names hard to work with.
IReadOnlyList<string> cleanFileNames = Fs.RenameToValid(Fs.SortedFiles(a.Rest));

Ui.Begin("Splitting media...");
Ui.Info($"Splitting anything longer than {Media.Hms(thresholdSeconds)}...");

// One pass to decide whether there is anything worth splitting at all.
bool toSplit = false;
foreach (string file in cleanFileNames)
{
    if (!Fs.IsMedia(file)) continue;

    double duration = Media.Duration(file);
    if (Math.Round(duration) > thresholdSeconds)
    {
        Ui.Good($"Media of length {Media.Hms(duration)} found. Will split...");
        toSplit = true;
        break;
    }
}

if (!toSplit)
{
    Ui.Ok("Nothing to split...exiting.");
    Snd.Error();
    Ui.End();
    return 0;
}

bool deleteOriginals = a.Flag("delete");
int failures = 0;

Ui.Track(cleanFileNames, "[bold cyan]Splitting : [/]", file =>
{
    if (!Fs.IsMedia(file))
    {
        Ui.Line($"[yellow]Skipping {Ui.Esc(file)}[/]");
        return;
    }

    // Probed once and carried, rather than once here and again inside the splitter.
    double duration = Media.Duration(file);

    // A duration of zero is what Media.Duration returns when ffprobe cannot read the
    // file. Treated as a failure rather than a short file: the alternative is what
    // this used to do, which was copy it as a single part and move the original away,
    // so an unreadable file looked exactly like a successful split.
    if (duration <= 0)
    {
        Ui.Line($"[bold red]Could not read the duration of {Ui.Esc(file)}[/]");
        failures++;
        return;
    }

    // The threshold alone decides this, applied per file rather than once for the run.
    //
    // It was briefly the part length instead, on the reasoning that anything longer
    // than one part is worth cutting up. That holds for an hour-long split, where the
    // threshold was otherwise derived as two hours and a 1h24m recording went
    // untouched. It does not hold for the presets: an 8m56 file at a five minute part
    // length is longer than one part, so it started being halved, when the entire point
    // of a ten minute threshold is to leave it alone. The threshold is the caller's
    // answer to this question and should not be second-guessed; what needed fixing was
    // how the wrapper derives it for a custom length, not what the gate consults.
    //
    // Leaving a short file alone costs nothing, because parts inherit their source's
    // modified time: an untouched file still sorts exactly where it did.
    //
    // Rounded, because a measured duration is never whole: ffprobe calls a 600 second
    // file 600.008, which would otherwise squeak past a threshold of exactly 600.
    if (Math.Round(duration) <= thresholdSeconds)
    {
        Ui.Line($"[yellow]Leaving {Ui.Esc(file)} alone: {Media.Hms(duration)} is under the threshold[/]");
        return;
    }

    (string? filename, string _) = Fs.SplitExt(file);
    string newFilename = filename + "-part" + (Fs.IsVideo(file) ? ".mkv" : ".mka");

    if (!SplitFile(file, newFilename, duration, splitDuration, maxPart, minPart, equal))
    {
        failures++;
        return;   // the original stays put: nothing was produced from it
    }

    // Stamp the parts with the source's date before the source is moved away, so
    // the whole group keeps its place in a modified-time sort. Each part is offset
    // by a millisecond so they also keep their order within that group.
    // The source itself no longer matches PartsOf, but the guard costs nothing and
    // keeps this correct if that ever loosens again.
    int sequence = 0;
    foreach (string part in PartsOf(filename))
        if (part != Path.GetFileName(file)) Fs.CopyTimestamp(file, part, sequence++);

    Fs.HandleOriginal(file, deleteOriginals, "Media");
    RunPercentageTag(filename);
});

return Ui.Done(failures);

/// Split one file according to the plan, returning whether it worked.
///
/// The plan decides both how many parts there are and how mkvmerge is told to make
/// them -- a repeating interval where one will do, explicit cut points where it will
/// not. Media.PlanSplit holds that arithmetic, and is unit tested.
static bool SplitFile(string file, string newFilename, double duration,
                      int splitDuration, int maxPart, int minPart, bool equal)
{
    SplitPlan? plan = Media.PlanSplit(duration, splitDuration, maxPart, minPart, equal);

    if (plan is null)
    {
        Ui.Line($"[bold red]Could not work out how to split {Ui.Esc(file)}[/]");
        return false;
    }

    if (!Proc.Ok("mkvmerge", "-q", "-o", newFilename, file, "--split", plan.SplitArgument))
    {
        Ui.Line($"[bold red]Could not split {Ui.Esc(file)}[/]");
        return false;
    }

    return true;
}

/// The part files mkvmerge just wrote for this source, in order.
///
/// Matched on the exact shape mkvmerge produces — "<stem>-part-NNN.<ext>" — and not
/// on a bare "name starts with the stem". A bare prefix also picks up a *different*
/// source's parts whenever one stem is a prefix of another: splitting "intro.mkv"
/// and "intro-extra.mkv" in one run would hand "intro" the whole of
/// "intro-extra-part-*" as well, stamping one group with the other's date and
/// computing both groups' percentage tags over the combined count.
static List<string> PartsOf(string fileName)
    => Directory.GetFiles(".")
        .Select(Path.GetFileName)
        .OfType<string>()
        .Where(f => IsPartOf(f, fileName))
        .OrderBy(f => f, StringComparer.Ordinal)
        .ToList();

/// True when a name is one of fileName's split parts: the stem, then "-part", then
/// mkvmerge's "-NNN" counter, then nothing but the extension.
static bool IsPartOf(string candidate, string fileName)
{
    const string marker = "-part";

    ReadOnlySpan<char> rest = candidate.AsSpan();
    if (!rest.StartsWith(fileName, StringComparison.Ordinal)) return false;
    rest = rest[fileName.Length..];

    if (!rest.StartsWith(marker, StringComparison.Ordinal)) return false;
    rest = rest[marker.Length..];

    // mkvmerge numbers the parts whenever --split is given, but accept an
    // unnumbered name too rather than lean on that.
    if (rest.Length > 0 && rest[0] == '-')
    {
        rest = rest[1..];

        int digits = 0;
        while (digits < rest.Length && char.IsAsciiDigit(rest[digits])) digits++;
        if (digits == 0) return false;

        rest = rest[digits..];
    }

    // Only the extension may be left. This is also what excludes anything already
    // carrying a "-003r-033p" tag from an earlier run.
    return rest.Length > 1 && rest[0] == '.' && !rest[1..].Contains('.');
}

/// Hand the freshly written parts to file-tag-percentage.
///
/// Kept as a separate process on purpose: these scripts are meant to compose, and
/// tagging stays useful on its own.
///
/// No need to exclude the source here: PartsOf cannot match it. Before that was
/// true this only worked because HandleOriginal had already moved the source out of
/// the directory by the time we got here.
static void RunPercentageTag(string fileName)
{
    List<string> matchingFiles = PartsOf(fileName);
    if (matchingFiles.Count == 0) return;

    Proc.Call("file-tag-percentage", matchingFiles, quiet: true);
}
