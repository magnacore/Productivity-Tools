#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Picker front end for otp-copy.
//
// A filtering picker rather than a Terminal.Gui dialog, deliberately: a password
// store has far too many entries to arrow through. Dlg.Choose has no search at all,
// and Spectre's SearchEnabled does not narrow the list, so this goes through fzf.
// The separation that matters is CLI versus wrapper, not which widget is used.

ArgVals a = new Args("otp-copy-tui", "Pick an OTP entry from a searchable list, then run otp-copy")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

IReadOnlyList<string> entries = PassStore.Entries("otp");

if (entries.Count == 0)
{
    Ui.Err($"No entries found in {PassStore.Root}/otp");
    Snd.Error();
    return 1;
}

// Type to narrow the list down. Escape backs out, which ends the command.
string? selection = Ui.Pick(entries, "Which TOTP to copy?");

if (selection is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]otp-copy {selection}[/]");
    return 0;
}

return Proc.Call("otp-copy", selection);
