#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package VersOne.Epub@3.3.6
#:property Configuration=Release
#:include utilities.cs

// Split EPUBs into byte-bounded parts, each one a complete, valid EPUB.
//
// The hard requirement is fidelity: a part must render exactly as the source did.
// Two rules deliver that, and everything else follows from them.
//
// The chapter markup is never re-serialised. Chunks are cut out of the original
// text and pasted back between the original prelude and postlude, so what is
// written is the source's own bytes. The xonsh predecessor went through ebooklib,
// which rebuilds the document with an HTML parser and lowercases attribute names --
// turning SVG's case-sensitive viewBox into viewbox and preserveAspectRatio into
// preserveaspectratio, which breaks cover scaling. epubcheck caught it; readers do
// not.
//
// Resources keep their original paths and their original bytes. Stylesheets, fonts
// and scripts are copied byte-for-byte to the same location inside the container, so
// every relative reference in the markup -- href="../styles/main.css", url(fonts/x.otf)
// inside that CSS -- still resolves. Rewriting paths would mean rewriting every
// reference to them, including ones inside stylesheets.
//
// Reading is VersOne.Epub's job: it knows EPUB 2 and 3, spine order, and where the
// package document lives. Writing is done here, because the OCF container has rules
// a general library need not respect -- mimetype first and stored uncompressed -- and
// because a part needs a freshly built manifest listing only what it actually
// contains.

using System.IO.Compression;
using System.Text;
using System.Text.RegularExpressions;
using System.Xml.Linq;
using VersOne.Epub;
using VersOne.Epub.Schema;
using static Vocabulary;

ArgVals a = Jobs.Add(new Args("epub-split", "Split EPUBs into parts of N kilobytes")
    .Opt("-s", "--sizekb", @default: "10", help: "Split size in KB")
    .Rest("files", min: 1, help: "Epubs to split"))
    .Parse(args);

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);
double sizeKb = Math.Max(a.Dbl("sizekb"), 0.5);

Ui.Begin("Splitting epubs...");

List<string> epubs = allFiles.Where(Fs.IsEpub).ToList();
foreach (string skipped in allFiles.Where(f => !Fs.IsEpub(f)))
    Ui.Warn($"Skipping {skipped}");

if (epubs.Count == 0) return Ui.NoFiles("No EPUBs selected!");

int failures = 0;

// A bar per book counting its chapters, with the overall bar pinned underneath.
// Each worker touches only its own book and its own output folder, so nothing here
// is shared between them.
Ui.Track2(epubs, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Split {epubs.Count} epub(s):"))}[/]",
          (file, addBar) =>
{
    try
    {
        if (!SplitOne(file, sizeKb, addBar)) Interlocked.Increment(ref failures);
    }
    catch (Exception ex)
    {
        Ui.Line($"[bold red]Could not split {Ui.Esc(file)}: {ex.Message}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);

/// Split one book. Returns false if anything went wrong with it.
static bool SplitOne(string file, double sizeKb, Func<string, int, Action<double>> addBar)
{
    string stem = Fs.SplitExt(file).Name;
    Directory.CreateDirectory(stem);

    EpubBook book = EpubReader.ReadBook(file);
    using ZipArchive source = ZipFile.OpenRead(file);

    SourceInfo info = SourceInfo.From(book, source);

    Action<double> advance = addBar(
        $"[bold cyan]{Ui.Esc(Ui.FitDescription(Path.GetFileName(file) + ":"))}[/]",
        Math.Max(book.ReadingOrder.Count, 1));

    int partNumber = 0;

    foreach (EpubLocalTextContentFile chapter in book.ReadingOrder)
    {
        // Raw bytes from the container, not VersOne's decoded string: a chapter that
        // needs no splitting is then written back byte-identical.
        ZipArchiveEntry? entry = source.GetEntry(chapter.FilePath);
        if (entry is null) { advance(1); continue; }

        byte[] original = ReadEntry(entry);
        IReadOnlyList<string> chunks = SplitHtmlBySize(original, sizeKb);

        for (int i = 0; i < chunks.Count; i++)
        {
            // One chunk means the chapter was under the limit, so hand back exactly
            // what was read rather than a re-encoding of it.
            byte[] chunkBytes = chunks.Count == 1
                ? original
                : new UTF8Encoding(false).GetBytes(chunks[i]);

            partNumber++;
            string output = Path.Combine(stem, $"{stem}-{partNumber:D3}.epub");

            WritePart(output, source, info, chapter.FilePath, chunkBytes, chunks[i]);
        }

        advance(1);
    }

    if (partNumber == 0)
    {
        Ui.Line($"[bold red]No chapters found in {Ui.Esc(file)}[/]");
        return false;
    }

    StampParts(file, stem);
    return TagParts(stem);
}

/// Copy the book's date onto each part, a millisecond apart.
///
/// Two reasons. The parts are written now, so without this they cluster at "now"
/// instead of sitting where the book did in a date-sorted listing. And several are
/// written inside the same millisecond, so they would otherwise share a timestamp
/// exactly -- nothing for a sort to order them by, and a file manager's tie-break can
/// then show part 003 before part 001.
static void StampParts(string source, string folder)
{
    string[] parts = Directory.GetFiles(folder);
    Array.Sort(parts, StringComparer.Ordinal);

    for (int i = 0; i < parts.Length; i++) Fs.CopyTimestamp(source, parts[i], i);
}

/// Hand this book's parts to file-tag-percentage.
///
/// Kept as a separate process on purpose -- these programs are meant to compose --
/// and quiet, because it draws its own progress bar which would fight the live
/// display here. The exit code is checked rather than discarded: swallowing it is how
/// the predecessor's tagging bug stayed hidden for so long.
static bool TagParts(string folder)
{
    List<string> parts = Directory.GetFiles(folder)
        .Where(f => IsPartOf(Path.GetFileName(f), Path.GetFileName(folder)))
        .OrderBy(f => f, StringComparer.Ordinal)
        .ToList();

    if (parts.Count == 0)
    {
        Ui.Line($"[bold red]No parts found to tag in {Ui.Esc(folder)}[/]");
        return false;
    }

    if (Proc.Call("file-tag-percentage", parts, quiet: true) != 0)
    {
        Ui.Line($"[bold red]Could not tag the parts of {Ui.Esc(folder)}[/]");
        return false;
    }

    return true;
}

/// True when a name is one of this book's parts: the stem, then "-NNN.epub".
///
/// Anchored rather than a bare prefix test, which would also accept a different book
/// whose title merely starts with this one's.
static bool IsPartOf(string candidate, string stem)
    => candidate.StartsWith(stem, StringComparison.Ordinal)
       && Regex.IsMatch(candidate[stem.Length..], @"^-\d{3,}\.epub$", RegexOptions.IgnoreCase);

/// Split one XHTML chapter into byte-bounded, well-formed chunks.
///
/// Every chunk is a complete document reusing the original's prelude (XML
/// declaration, DOCTYPE, html, head, body open) and postlude (body and html close).
/// That is what keeps each chunk styled by the same CSS and font links as the
/// original, rather than only the first one.
///
/// Balance is kept by flushing only at element boundaries -- immediately after a
/// closing tag -- and by closing any still-open ancestors at the end of a chunk and
/// reopening them at the start of the next.
///
/// Splitting the text and rejoining it reproduces the input exactly, so a chapter
/// that fits in one chunk comes back unchanged.
static IReadOnlyList<string> SplitHtmlBySize(byte[] html, double splitAfterKb)
{
    int chunkLimit = (int)(splitAfterKb * 1024);
    string text = new UTF8Encoding(false).GetString(html);

    Match bodyOpen = Regex.Match(text, @"<body\b[^>]*>", RegexOptions.IgnoreCase);
    int bodyClose = text.LastIndexOf("</body>", StringComparison.OrdinalIgnoreCase);

    // No usable body markers: nothing safe to split, so leave it alone.
    if (!bodyOpen.Success || bodyClose < 0 || bodyClose < bodyOpen.Index + bodyOpen.Length)
        return [text];

    int bodyStart = bodyOpen.Index + bodyOpen.Length;
    string prelude = text[..bodyStart];
    string postlude = text[bodyClose..];
    string bodyInner = text[bodyStart..bodyClose];

    int overhead = Encoding.UTF8.GetByteCount(prelude) + Encoding.UTF8.GetByteCount(postlude);
    int available = Math.Max(chunkLimit - overhead, 1);

    List<string> chunks = [];
    StringBuilder current = new();
    int currentSize = 0;
    List<string> openStack = [];   // raw opening tags, so they can be reopened verbatim

    foreach (Match token in Regex.Matches(bodyInner, @"<[^>]+>|[^<]+"))
    {
        string tok = token.Value;
        current.Append(tok);
        currentSize += Encoding.UTF8.GetByteCount(tok);

        if (tok.StartsWith("</", StringComparison.Ordinal))
        {
            // An element just ended: the one safe place to flush.
            if (openStack.Count > 0) openStack.RemoveAt(openStack.Count - 1);

            if (currentSize >= available)
            {
                StringBuilder closing = new();
                for (int i = openStack.Count - 1; i >= 0; i--)
                {
                    string? name = TagName(openStack[i]);
                    if (name is not null) closing.Append($"</{name}>");
                }

                string reopening = string.Concat(openStack);
                chunks.Add(current.ToString() + closing);

                current.Clear().Append(reopening);
                currentSize = Encoding.UTF8.GetByteCount(reopening);
            }
        }
        else if (tok.StartsWith("<!", StringComparison.Ordinal)
                 || tok.StartsWith("<?", StringComparison.Ordinal))
        {
            // Comment, DOCTYPE or processing instruction: no effect on the stack.
        }
        else if (tok.StartsWith('<'))
        {
            bool selfClosing = tok.TrimEnd('>').TrimEnd().EndsWith('/');
            string? name = TagName(tok);

            if (name is not null && !selfClosing && !VoidElements.Contains(name))
                openStack.Add(tok);
        }
    }

    if (current.Length > 0) chunks.Add(current.ToString());

    // A flush that lands on the last element leaves the trailing whitespace behind as
    // a chunk of its own: a part whose body holds nothing but a newline. epubcheck
    // rejects it ("element body incomplete"), and there would be nothing to read in
    // it anyway.
    chunks.RemoveAll(inner => !HasContent(inner));

    return chunks.Count == 0
        ? [text]
        : chunks.Select(inner => prelude + inner + postlude).ToList();
}

/// Whether a chunk body would render anything at all.
///
/// Text counts, and so does any element that is itself the content -- an image, a
/// figure, a rule. Markup alone does not: a lone reopened wrapper is an empty part.
static bool HasContent(string inner)
{
    if (Regex.IsMatch(inner, @"<(img|svg|video|audio|object|iframe|hr|table|canvas)\b",
                      RegexOptions.IgnoreCase)) return true;

    return Regex.Replace(inner, @"<[^>]+>", string.Empty).Trim().Length > 0;
}

/// The element name out of a raw tag, or null if it does not look like one.
static string? TagName(string tag)
{
    Match m = Regex.Match(tag, @"<\s*([A-Za-z_][A-Za-z0-9_:.\-]*)");
    return m.Success ? m.Groups[1].Value : null;
}

/// The manifest resources a chunk actually points at, by full path and by bare name.
static HashSet<string> ReferencedResources(string chunk)
{
    HashSet<string> refs = new(StringComparer.OrdinalIgnoreCase);

    foreach (Match m in Regex.Matches(chunk,
        @"(?:src|href|xlink:href|poster|data)\s*=\s*(""|')([^""']+)\1",
        RegexOptions.IgnoreCase))
    {
        string value = m.Groups[2].Value;
        refs.Add(value);
        refs.Add(Path.GetFileName(value));
    }

    return refs;
}

// ── Writing ──────────────────────────────────────────────────────────────────

/// An href relative to the package document, which is what the manifest wants.
static string HrefFor(string zipPath, string opfDir)
    => opfDir.Length > 0 && zipPath.StartsWith(opfDir + "/", StringComparison.Ordinal)
        ? zipPath[(opfDir.Length + 1)..]
        : zipPath;

/// A container path from one relative reference, resolving "." and ".." the way a
/// reading system does when it follows a link out of a stylesheet.
static string ResolveRelative(string baseDir, string href)
{
    string cleaned = Uri.UnescapeDataString(href.Split('#')[0].Split('?')[0]);
    List<string> segments = [];

    foreach (string segment in $"{baseDir}/{cleaned}".Split('/', StringSplitOptions.RemoveEmptyEntries))
    {
        if (segment == ".") continue;
        if (segment == "..") { if (segments.Count > 0) segments.RemoveAt(segments.Count - 1); continue; }
        segments.Add(segment);
    }

    return string.Join('/', segments);
}

static byte[] ReadEntry(ZipArchiveEntry entry)
{
    using Stream stream = entry.Open();
    using MemoryStream buffer = new();
    stream.CopyTo(buffer);
    return buffer.ToArray();
}

/// Write one part: a complete EPUB holding a single chunk and what it needs to render.
static void WritePart(string output, ZipArchive source, SourceInfo info,
                      string chapterZipPath, byte[] chunkBytes, string chunkText)
{
    if (File.Exists(output)) File.Delete(output);

    using FileStream file = File.Create(output);
    using ZipArchive part = new(file, ZipArchiveMode.Create);

    // The OCF container requires "mimetype" to be the first entry and stored
    // uncompressed. Readers are lenient about it; epubcheck is not, and neither are
    // some retail validators.
    WriteEntry(part, "mimetype", "application/epub+zip"u8.ToArray(), CompressionLevel.NoCompression);

    WriteXml(part, "META-INF/container.xml", new XDocument(
        new XDeclaration("1.0", "utf-8", null),
        new XElement(Ocf + "container", new XAttribute("version", "1.0"),
            new XElement(Ocf + "rootfiles",
                new XElement(Ocf + "rootfile",
                    new XAttribute("full-path", info.OpfPath),
                    new XAttribute("media-type", "application/oebps-package+xml"))))));

    // Obfuscated fonts are decoded with a key derived from the identifier, which is
    // carried over unchanged, so the declaration has to come along too.
    if (info.HasEncryption)
    {
        ZipArchiveEntry? encryption = source.GetEntry("META-INF/encryption.xml");
        if (encryption is not null)
            WriteEntry(part, "META-INF/encryption.xml", ReadEntry(encryption));
    }

    WriteEntry(part, chapterZipPath, chunkBytes);

    HashSet<string> referenced = ReferencedResources(chunkText);

    // Everything that is not a chapter, a table of contents, or optional media comes
    // along: stylesheets, fonts and scripts, whether or not the markup names them.
    List<ResourceItem> carried = info.Items
        .Where(i => !i.IsDocument && !i.IsToc && i.ZipPath != chapterZipPath
                    && !i.IsOptionalMedia)
        .ToList();

    // Stylesheets reference images of their own -- background: url(../Images/rule.png)
    // -- and those references are invisible to a scan of the markup. Missing them
    // leaves the part valid-looking but visibly wrong, and epubcheck reports the
    // image as unresolvable. Read each carried stylesheet and fold its references in
    // before deciding which media to copy.
    foreach (ResourceItem sheet in carried.Where(i => i.MediaType == "text/css"))
    {
        ZipArchiveEntry? entry = source.GetEntry(sheet.ZipPath);
        if (entry is null) continue;

        string css = new UTF8Encoding(false).GetString(ReadEntry(entry));
        string sheetDir = Path.GetDirectoryName(sheet.ZipPath)?.Replace('\\', '/') ?? string.Empty;

        foreach (Match m in Regex.Matches(css, @"url\(\s*['""]?([^)'""]+)['""]?\s*\)",
                                          RegexOptions.IgnoreCase))
        {
            string target = m.Groups[1].Value.Trim();
            if (target.StartsWith("data:", StringComparison.OrdinalIgnoreCase)) continue;

            referenced.Add(target);
            referenced.Add(Path.GetFileName(target));
            referenced.Add(ResolveRelative(sheetDir, target));
        }
    }

    List<ResourceItem> copied = [];

    foreach (ResourceItem item in info.Items)
    {
        // Other chapters, and the source's own table of contents, are not part of
        // this part. A fresh one is generated below.
        if (item.IsDocument || item.IsToc) continue;
        if (item.ZipPath == chapterZipPath) continue;

        if (item.IsOptionalMedia
            && !referenced.Contains(item.Href)
            && !referenced.Contains(item.ZipPath)
            && !referenced.Contains(Path.GetFileName(item.ZipPath))) continue;

        ZipArchiveEntry? entry = source.GetEntry(item.ZipPath);
        if (entry is null) continue;

        // Byte-for-byte. Re-encoding a stylesheet or a font is how subtle rendering
        // differences creep in.
        WriteEntry(part, item.ZipPath, ReadEntry(entry));
        copied.Add(item);
    }

    // The chapter keeps whatever id the source gave it, so any manifest-relative
    // reference still lines up.
    ResourceItem? original = info.Items.FirstOrDefault(i => i.ZipPath == chapterZipPath);
    string chunkId = original?.Id ?? "chunk";
    string chunkHref = HrefFor(chapterZipPath, info.OpfDir);

    string tocPath = info.OpfDir.Length > 0
        ? $"{info.OpfDir}/{(info.IsEpub3 ? "nav.xhtml" : "toc.ncx")}"
        : info.IsEpub3 ? "nav.xhtml" : "toc.ncx";

    if (info.IsEpub3) WriteNav(part, tocPath, info.Title, chunkHref);
    else WriteNcx(part, tocPath, info, chunkHref);

    WriteOpf(part, info, chunkId, chunkHref, chunkText, copied,
             HrefFor(tocPath, info.OpfDir));
}

/// The package document: metadata, a manifest of exactly what this part contains,
/// and a spine of the one chunk.
static void WriteOpf(ZipArchive part, SourceInfo info, string chunkId, string chunkHref,
                     string chunkText, IReadOnlyList<ResourceItem> copied, string tocHref)
{
    XElement metadata = new(Opf + "metadata",
        new XAttribute(XNamespace.Xmlns + "dc", Dc.NamespaceName),
        new XElement(Dc + "identifier",
            new XAttribute("id", info.IdentifierId),
            info.Scheme is not null && !info.IsEpub3
                ? new XAttribute(Opf + "scheme", info.Scheme) : null,
            info.Identifier),
        // dc:title and dc:language are required. The predecessor omitted both, which
        // is two of the five errors epubcheck reported against its output.
        new XElement(Dc + "title", info.Title),
        new XElement(Dc + "language", info.Language));

    if (info.IsEpub3)
        metadata.Add(new XElement(Opf + "meta",
            new XAttribute("property", "dcterms:modified"),
            DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")));

    XElement manifest = new(Opf + "manifest");

    // EPUB 3 wants the features a document uses declared here. Missing "svg" was
    // another of the predecessor's errors.
    List<string> properties = [];
    if (info.IsEpub3)
    {
        if (Regex.IsMatch(chunkText, @"<svg\b", RegexOptions.IgnoreCase)) properties.Add("svg");
        if (Regex.IsMatch(chunkText, @"<script\b", RegexOptions.IgnoreCase)) properties.Add("scripted");
        if (Regex.IsMatch(chunkText, @"<math\b", RegexOptions.IgnoreCase)) properties.Add("mathml");
    }

    manifest.Add(new XElement(Opf + "item",
        new XAttribute("id", chunkId),
        new XAttribute("href", chunkHref),
        new XAttribute("media-type", "application/xhtml+xml"),
        properties.Count > 0 ? new XAttribute("properties", string.Join(' ', properties)) : null));

    manifest.Add(info.IsEpub3
        ? new XElement(Opf + "item",
            new XAttribute("id", "nav"), new XAttribute("href", tocHref),
            new XAttribute("media-type", "application/xhtml+xml"),
            new XAttribute("properties", "nav"))
        : new XElement(Opf + "item",
            new XAttribute("id", "ncx"), new XAttribute("href", tocHref),
            new XAttribute("media-type", "application/x-dtbncx+xml")));

    foreach (ResourceItem item in copied)
        manifest.Add(new XElement(Opf + "item",
            new XAttribute("id", item.Id),
            new XAttribute("href", HrefFor(item.ZipPath, info.OpfDir)),
            new XAttribute("media-type", item.MediaType),
            item.Properties is not null && info.IsEpub3
                ? new XAttribute("properties", item.Properties) : null));

    XElement spine = new(Opf + "spine",
        info.IsEpub3 ? null : new XAttribute("toc", "ncx"),
        new XElement(Opf + "itemref", new XAttribute("idref", chunkId)));

    WriteXml(part, info.OpfPath, new XDocument(
        new XDeclaration("1.0", "utf-8", null),
        new XElement(Opf + "package",
            new XAttribute("version", info.IsEpub3 ? "3.0" : "2.0"),
            new XAttribute("unique-identifier", info.IdentifierId),
            metadata, manifest, spine)));
}

/// EPUB 2's navigation document.
static void WriteNcx(ZipArchive part, string path, SourceInfo info, string chunkHref)
    => WriteXml(part, path, new XDocument(
        new XDeclaration("1.0", "utf-8", null),
        new XElement(Ncx + "ncx",
            new XAttribute("version", "2005-1"),
            new XElement(Ncx + "head",
                Meta("dtb:uid", info.Identifier), Meta("dtb:depth", "1"),
                Meta("dtb:totalPageCount", "0"), Meta("dtb:maxPageNumber", "0")),
            new XElement(Ncx + "docTitle", new XElement(Ncx + "text", info.Title)),
            new XElement(Ncx + "navMap",
                new XElement(Ncx + "navPoint",
                    new XAttribute("id", "navPoint-1"), new XAttribute("playOrder", "1"),
                    new XElement(Ncx + "navLabel", new XElement(Ncx + "text", info.Title)),
                    new XElement(Ncx + "content", new XAttribute("src", chunkHref)))))));

static XElement Meta(string name, string content)
    => new(Ncx + "meta", new XAttribute("name", name), new XAttribute("content", content));

/// EPUB 3's navigation document. Exactly one manifest item must carry the "nav"
/// property; the predecessor shipped none, which epubcheck rejects outright.
static void WriteNav(ZipArchive part, string path, string title, string chunkHref)
    => WriteXml(part, path, new XDocument(
        new XDeclaration("1.0", "utf-8", null),
        new XElement(Xhtml + "html",
            new XAttribute(XNamespace.Xmlns + "epub", Ops.NamespaceName),
            new XElement(Xhtml + "head", new XElement(Xhtml + "title", title)),
            new XElement(Xhtml + "body",
                new XElement(Xhtml + "nav",
                    new XAttribute(Ops + "type", "toc"),
                    new XElement(Xhtml + "h1", title),
                    new XElement(Xhtml + "ol",
                        new XElement(Xhtml + "li",
                            new XElement(Xhtml + "a",
                                new XAttribute("href", chunkHref), title)))))))); 

static void WriteXml(ZipArchive part, string path, XDocument doc)
{
    using MemoryStream buffer = new();
    doc.Save(buffer, SaveOptions.None);
    WriteEntry(part, path, buffer.ToArray());
}

static void WriteEntry(ZipArchive part, string path, byte[] content,
                       CompressionLevel level = CompressionLevel.Optimal)
{
    ZipArchiveEntry entry = part.CreateEntry(Normalise(path), level);
    using Stream stream = entry.Open();
    stream.Write(content);
}

/// One manifest entry of the source book, with where it actually lives in the zip.
internal sealed record ResourceItem(
    string ZipPath, string Href, string Id, string MediaType, string? Properties)
{
    public bool IsDocument => MediaType == "application/xhtml+xml";

    /// The table of contents, in either of its forms. Never copied: it points at
    /// chapters that are not in this part, which would leave dangling links.
    public bool IsToc => MediaType == "application/x-dtbncx+xml"
                         || (Properties?.Contains("nav", StringComparison.Ordinal) ?? false);

    /// Copied only when the chunk actually references it. Stylesheets, fonts and
    /// scripts come along unconditionally, because the markup's styling depends on
    /// them whether or not it names them directly.
    public bool IsOptionalMedia => MediaType.StartsWith("image/", StringComparison.Ordinal)
                                   || MediaType.StartsWith("audio/", StringComparison.Ordinal)
                                   || MediaType.StartsWith("video/", StringComparison.Ordinal);
}

/// Everything about the source needed to build a part from it.
internal sealed record SourceInfo(
    string OpfPath, string OpfDir, bool IsEpub3,
    string Title, string Language, string Identifier, string IdentifierId, string? Scheme,
    IReadOnlyList<ResourceItem> Items, bool HasEncryption)
{
    public static SourceInfo From(EpubBook book, ZipArchive source)
    {
        EpubPackage package = book.Schema.Package;
        EpubMetadata meta = package.Metadata;

        string contentDir = book.Schema.ContentDirectoryPath ?? string.Empty;

        List<ResourceItem> items = [];
        foreach (EpubManifestItem item in package.Manifest.Items)
        {
            string href = Uri.UnescapeDataString(item.Href);
            string zipPath = contentDir.Length > 0 ? $"{contentDir}/{href}" : href;

            items.Add(new ResourceItem(
                Normalise(zipPath), item.Href, item.Id, item.MediaType,
                item.Properties is { Count: > 0 }
                    ? string.Join(' ', item.Properties.Select(p => p.ToString().ToLowerInvariant()))
                    : null));
        }

        EpubMetadataIdentifier? id = meta.Identifiers.FirstOrDefault();

        return new SourceInfo(
            OpfPath: FindOpfPath(source),
            OpfDir: contentDir,
            IsEpub3: package.EpubVersion >= EpubVersion.EPUB_3,
            Title: meta.Titles.FirstOrDefault()?.Title ?? book.Title ?? "Untitled",
            Language: meta.Languages.FirstOrDefault()?.Language ?? "en",
            // The identifier is carried over rather than regenerated. EPUB font
            // obfuscation derives its key from it, so a new one would silently break
            // every embedded font in the part.
            Identifier: id?.Identifier ?? $"urn:uuid:{Guid.NewGuid()}",
            IdentifierId: string.IsNullOrEmpty(id?.Id) ? "bookid" : id.Id,
            Scheme: id?.Scheme,
            Items: items,
            HasEncryption: source.GetEntry("META-INF/encryption.xml") is not null);
    }

    /// Where the package document lives, read from the container rather than guessed.
    private static string FindOpfPath(ZipArchive source)
    {
        ZipArchiveEntry? container = source.GetEntry("META-INF/container.xml");
        if (container is null) return "content.opf";

        using Stream stream = container.Open();
        XDocument doc = XDocument.Load(stream);

        string? path = doc.Descendants(Ocf + "rootfile")
            .Select(r => (string?)r.Attribute("full-path")).FirstOrDefault(p => p is not null);

        return path is null ? "content.opf" : Normalise(Uri.UnescapeDataString(path));
    }
}

/// The XML vocabularies an EPUB is built from, and the one HTML fact the splitter
/// needs. Gathered into a type because a file of top-level statements cannot declare
/// fields, and the static local functions above cannot capture locals.
internal static class Vocabulary
{
    /// A zip path in the one form everything here compares against.
    internal static string Normalise(string path) => path.Replace('\\', '/').TrimStart('/');

    internal static readonly XNamespace Opf = "http://www.idpf.org/2007/opf";
    internal static readonly XNamespace Dc = "http://purl.org/dc/elements/1.1/";
    internal static readonly XNamespace Ocf = "urn:oasis:names:tc:opendocument:xmlns:container";
    internal static readonly XNamespace Ncx = "http://www.daisy.org/z3986/2005/ncx/";
    internal static readonly XNamespace Xhtml = "http://www.w3.org/1999/xhtml";
    internal static readonly XNamespace Ops = "http://www.idpf.org/2007/ops";

    /// Tags with no closing form, so they must never be pushed onto the open-tag stack.
    internal static readonly HashSet<string> VoidElements = new(StringComparer.OrdinalIgnoreCase)
    {
        "area", "base", "br", "col", "embed", "hr", "img", "input",
        "link", "meta", "source", "track", "wbr",
    };
}
