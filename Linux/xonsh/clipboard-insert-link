#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Scrape URLs off the clipboard and append them to the download queue that
// video-download reads. Bound to a hotkey, this turns "copy link" into "queued".

var a = new Args("clipboard-insert-link", "Append clipboard URLs to the video download list")
    .Parse(args);

var urlFileName = Path.Combine(Paths.Backups, "youtube.txt");

var urls = Fs.FindUrls(Clip.Paste());

if (urls.Count == 0)
{
    Snd.Error();
    Snd.Notify("No URL on the clipboard");
    return 1;
}

foreach (var url in urls)
{
    try
    {
        File.AppendAllText(urlFileName, url + Environment.NewLine);
        Snd.Success();
        // A toast, because this normally runs from a hotkey with no terminal.
        Snd.Notify(urlFileName, url);
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Could not append to {urlFileName}: {ex.Message}");
        Snd.Error();
        return 1;
    }
}

return 0;
