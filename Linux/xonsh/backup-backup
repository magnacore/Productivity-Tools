#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror the primary backup drive onto the secondary, keeping one generation of
// history on the far side. Snapshot first, then sync — so if the sync goes wrong
// (a source drive half-mounted, say), @previous still holds a good copy.

ArgVals a = Sys.WithDryRun(new Args("backup-backup", "Mirror BACKUP_01_A onto BACKUP_01_B")).Parse(args);
Sys.Apply(a);

Ui.Begin("Backing up backup drive....");

string backupRoot = Path.Combine(Paths.Media, "BACKUP_01_B", "BACKUP");
string current = Path.Combine(backupRoot, "@current");
string previous = Path.Combine(backupRoot, "@previous");
string source = Path.Combine(Paths.Media, "BACKUP_01_A");

Sys.RotatePreviousSnapshot(current + "/", previous);

Ui.Info("Synchronizing...");
Sys.Rsync("-vahiP", "--delete", source + "/", current + "/");

Sys.Stamp("backup-backup");
Sys.StampFile(Path.Combine(current, "backup_date.txt"));

return Ui.Done();
