#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Prefix files with an incrementing, zero-padded number so they sort in the
// order you chose rather than alphabetically.
//
//     file-number 1 3 intro.mkv setup.mkv   ->   "001 intro.mkv", "002 setup.mkv"

ArgVals a = new Args("file-number", "Prefix files with an incrementing number")
    .Pos("start_number", "Number to start from")
    .Pos("padding", "How many digits to pad the number to")
    .Rest("files", min: 1, help: "Files to number")
    .Parse(args);

IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);
int startNumber = a.Int("start_number");
int padding = a.Int("padding");

Ui.Begin($"Start numbering from {startNumber} with a padding of {padding}...");

Ui.Track(files, "[bold cyan]Numbering : [/]", file =>
{
    string newFilename = $"{startNumber.ToString().PadLeft(padding, '0')} {file}";

    try { Fs.Move(file, newFilename); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not number {Ui.Esc(file)}: {ex.Message}[/]"); }

    startNumber++;
});

return Ui.Done();
