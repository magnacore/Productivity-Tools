#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Generate a random password or a diceware seed phrase, copy it, and say how
// strong it actually is.
//
// Both paths refuse to run when the kernel's entropy pool is low: a generator
// starved of randomness produces predictable output, which is worse than useless
// because it still looks random.

using System.Numerics;

var a = new Args("password-generate", "Generate a password or seed phrase and report its strength")
    .Opt("-t", "--type", @default: "password", choices: ["password", "seed"],
         help: "What to generate")
    .Opt("-l", "--length", @default: "20", help: "Characters in the password")
    .Opt("-w", "--words", @default: "12", help: "Words in the seed phrase")
    .Parse(args);

var choice = a.Str("type") == "seed" ? "seed phrase" : "password";

if (!HasEnoughEntropy())
{
    Ui.Err("System low on entropy...");
    Snd.Error();
    Ui.End();
    return 1;
}

if (choice == "password")
{
    Ui.Begin("Generate password...");

    int passwordChars = Math.Max(a.Int("length", 20), 1);

    // -c capitals, -n numerals, -s fully random, -y symbols.
    var password = Proc.Capture("pwgen", "-cnsy", passwordChars.ToString(), "1");

    if (string.IsNullOrWhiteSpace(password))
    {
        Ui.Err("pwgen produced nothing.");
        Snd.Error();
        Ui.End();
        return 1;
    }

    Clip.Copy(password);

    // 26 uppercase + 26 lowercase + 10 digits + the symbols pwgen draws from.
    int poolSize = 26 + 26 + 10 + "~`!@#$%^&*()-_=+]}[{;:,<.>/?'|".Length;

    var (entropy, attempts) = Crypto.PasswordEntropy(passwordChars, poolSize);

    // 128 bits is the usual line between "strong" and "merely long".
    if (entropy < 128) Ui.Err($"Password entropy: {(int)entropy}");
    else Ui.Good($"Password entropy: {(int)entropy}");

    Ui.Info($"Statistically an attacker needs to try {Num.ToWords(attempts)} " +
            "combinations to deterministically brute force the password.");

    return Ui.Done();
}

Ui.Begin("Generate seed phrase...");

int words = Math.Max(a.Int("words", 12), 1);

Ui.Info("Passphrase strength details...");

var seedPhrase = Proc.Capture("/opt/anaconda3/envs/util/bin/python",
                              "/opt/anaconda3/envs/util/bin/passphraseme", "-l", words.ToString());

if (string.IsNullOrWhiteSpace(seedPhrase))
{
    Ui.Err("passphraseme produced nothing.");
    Snd.Error();
    Ui.End();
    return 1;
}

Clip.Copy(seedPhrase);

// 7776 is the EFF diceware wordlist size (6^5).
Proc.Call("get-passphrase-strength", "7776", words.ToString());

return Ui.Done();

/// The kernel reports how many bits of estimated entropy are available. Below
/// roughly 200 the pool is depleted and generators should wait.
static bool HasEnoughEntropy()
{
    const string EntropyFile = "/proc/sys/kernel/random/entropy_avail";

    // Not Linux, or the file is unreadable: do not block on a check we cannot make.
    if (!File.Exists(EntropyFile)) return true;

    return int.TryParse(File.ReadAllText(EntropyFile).Trim(), out var available)
        ? available >= 200
        : true;
}
