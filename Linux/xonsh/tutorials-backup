#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror the tutorials drive onto its backup.

ArgVals a = Sys.WithDryRun(new Args("tutorials-backup", "Mirror the LEARNING drive onto TutsBackup")).Parse(args);
Sys.Apply(a);

Ui.Begin("Backup Tutorials...");

Sys.Rsync("-vahiP", "--delete",
          Path.Combine(Paths.Media, "LEARNING") + "/",
          Path.Combine(Paths.Media, "TutsBackup", "BACKUP") + "/");

Sys.Stamp("tutorials-backup");

return Ui.Done();
