#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Split text files into size-bounded parts, cutting only at sentence ends so no
// part begins mid-thought. Sized for the Google TTS request limit by default,
// which is why text-to-speech wants its input through here first.

using System.Text.RegularExpressions;

ArgVals a = new Args("text-split", "Split text files into parts of N kilobytes")
    .Pos("split_after_kb", "Kilobytes per part (4 for Google TTS, which caps a request at 5000 bytes)")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Texts/")
    .Rest("files", min: 1, help: "Text files to split")
    .Parse(args);

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);
// The Google TTS API caps a single request at 5000 bytes, so 4 is the size to pass
// when the parts are headed for text-to-speech; 4 KB leaves headroom.
double splitAfterKb = Math.Max(a.Dbl("split_after_kb", 10), 1);

bool deleteOriginals = a.Flag("delete");

Ui.Begin($"Splitting Text to {splitAfterKb} kbs each...");

Ui.Track(allFiles, "[bold cyan]Splitting : [/]", fname =>
{
    if (Fs.IsText(fname)) SplitTextFile(fname, splitAfterKb);
    Fs.HandleOriginal(fname, deleteOriginals, "Texts");
});

return Ui.Done();

static void SplitTextFile(string fname, double splitAfterKb)
{
    string contents;
    try { contents = File.ReadAllText(fname); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not read {Ui.Esc(fname)}: {ex.Message}[/]"); return; }

    // Flatten to ASCII: smart quotes, em dashes and accents all read badly
    // through a speech synthesiser.
    contents = ToAscii(contents);

    (string? fileName, string? extension) = Fs.SplitExt(fname);
    string[] sentences = Pattern.SentenceBoundary().Split(contents);

    int part = 1;
    StringBuilder buffer = new();

    for (int i = 0; i < sentences.Length; i++)
    {
        buffer.Append(sentences[i]).Append(' ');

        bool full = Encoding.UTF8.GetByteCount(buffer.ToString()) / 1024.0 > splitAfterKb;
        bool last = i == sentences.Length - 1;

        if (!full && !last) continue;

        string newFilename = $"{fileName}-{part:D4}{extension}";
        try
        {
            File.WriteAllText(newFilename, buffer.ToString());

            // Every part inherits the source's date, offset by a millisecond
            // each, so the group stays where the original was in a modified-time
            // sort and the parts keep their order inside it.
            Fs.CopyTimestamp(fname, newFilename, part - 1);
        }
        catch (Exception ex) { Ui.Line($"[bold red]Could not write {Ui.Esc(newFilename)}: {ex.Message}[/]"); }

        buffer.Clear();
        part++;
    }
}

/// Transliterate to plain ASCII, the way Python's unidecode does: decompose
/// accented letters and keep the base, then drop anything still non-ASCII.
static string ToAscii(string text)
{
    string decomposed = text.Normalize(NormalizationForm.FormKD);
    StringBuilder sb = new(decomposed.Length);

    foreach (char ch in decomposed)
    {
        if (ch < 128) { sb.Append(ch); continue; }

        // Punctuation that has an obvious ASCII stand-in is worth keeping.
        sb.Append(ch switch
        {
            '‘' or '’' or '‛' => "'",
            '“' or '”' or '‟' => "\"",
            '–' or '—' or '−' => "-",
            '…' => "...",
            ' ' => " ",
            '•' => "*",
            _ => string.Empty,
        });
    }

    return sb.ToString();
}

/// Source-generated matchers. Emitted at build time, so nothing parses a pattern
/// at startup — which matters for a program that runs for well under a second.
internal static partial class Pattern
{
    /// A sentence end: . ! or ? followed by whitespace.
    [GeneratedRegex(@"(?<=[.!?])\s+")]
    internal static partial Regex SentenceBoundary();
}
