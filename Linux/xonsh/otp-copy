#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Pick a TOTP entry from the password store, copy the current code, and print it
// large enough to read off the screen while typing it somewhere else.

ArgVals a = new Args("otp-copy", "Copy a TOTP code from the password store")
    .Pos("entry", "Name of the otp store entry (see otp-copy-tui to pick from a list)")
    .Parse(args);

IReadOnlyList<string> entries = PassStore.Entries("otp");

if (entries.Count == 0)
{
    Ui.Err($"No OTP entries found in {PassStore.Root}/otp");
    Snd.Error();
    return 1;
}

string selection = a.Str("entry");

if (!entries.Contains(selection, StringComparer.Ordinal))
{
    Ui.Err($"No entry named '{selection}' under {PassStore.Root}/otp");
    Snd.Error();
    return 1;
}

string totp = Proc.Capture("pass", "otp", $"otp/{selection}");

if (string.IsNullOrWhiteSpace(totp))
{
    Ui.Err($"Could not read a code for {selection}");
    Snd.Error();
    return 1;
}

Clip.Copy(totp);

// Split into two groups, which is how these codes are read aloud and typed.
string grouped = totp.Length > 3 ? $"{totp[..3]} {totp[3..]}" : totp;
Proc.Run("figlet", "-c", "-f", "big", grouped);

return Ui.Done();
