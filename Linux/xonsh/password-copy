#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Copy a username, then a second later the matching password, so you can paste
// one into each field of a login form without going back to the store.
//
// `pass -c` clears the clipboard automatically after 45 seconds.

var a = new Args("password-copy", "Copy the username then password for a store entry")
    .Pos("entry", "Name of the password store entry (see password-copy-tui to pick from a list)")
    .Parse(args);

var entries = PassStore.Entries("password");

if (entries.Count == 0)
{
    Ui.Err($"No entries found in {PassStore.Root}/password");
    Snd.Error();
    return 1;
}

var selection = a.Str("entry");

if (!entries.Contains(selection, StringComparer.Ordinal))
{
    Ui.Err($"No entry named '{selection}' under {PassStore.Root}/password");
    Snd.Error();
    return 1;
}

// -c3 takes line 3 of the entry, which is where the username lives.
Ui.Info("Copying username...");
Proc.Run("pass", "-c3", $"password/{selection}");

// A beat, so the paste of the username lands before the clipboard changes again.
Thread.Sleep(1000);

Ui.Info("Copying password...");
Proc.Run("pass", "-c", $"password/{selection}");

return Ui.Done();
