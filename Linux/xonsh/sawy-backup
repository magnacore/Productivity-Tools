#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror the Sawy drive onto its backup partner, keeping one generation.

ArgVals a = Sys.WithDryRun(new Args("sawy-backup", "Mirror SAWY_01_A onto SAWY_01_B")).Parse(args);
Sys.Apply(a);

Ui.Begin("Backup Sawy Drive...");

string backupRoot = Path.Combine(Paths.Media, "SAWY_01_B", "SAWY_BACKUP");
string current = Path.Combine(backupRoot, "@current");

Sys.RotatePreviousSnapshot(current + "/", Path.Combine(backupRoot, "@previous"));

Ui.Info("Synchronizing...");
Sys.Rsync("-vahiP", "--delete", Path.Combine(Paths.Media, "SAWY_01_A", "SAWY") + "/", current + "/");

Sys.Stamp("sawy-backup");

return Ui.Done();
