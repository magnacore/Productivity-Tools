#!/opt/anaconda3/envs/xonsh/bin/xonsh

import subprocess

# Define the ripgrep options
rg_opts = "--column --line-number --no-heading --color=always --smart-case --hidden --glob '!.git/*'"

# Construct the fzf command as a list to avoid shell parsing headaches
cmd = [
    "fzf", "--ansi", "--disabled",
    "--delimiter", ":",
    "--bind", f"start:reload(rg {rg_opts} '')",
    "--bind", f"change:reload(rg {rg_opts} {{q}} || true)",
    "--preview", "batcat --theme=ansi --color=always --style=numbers --highlight-line {2} {1} 2>/dev/null || head -n 100 {1}",
    "--preview-window", "right:60%:+{2}-5"
]


# Run fzf and capture the selection
result = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)

# If a file was selected (exit code 0)
if result.returncode == 0 and result.stdout.strip():
    # Split the ripgrep output by colons
    parts = result.stdout.strip().split(':')

    if len(parts) >= 2:
        file_name = parts[0]
        line_num = parts[1]

        # Launch Neovim using Xonsh's native @() syntax to inject the variables
        nvim @(f"+{line_num}") @(file_name)
