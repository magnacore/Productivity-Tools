#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Run a text file through one of Fabric's prompt patterns and save the result
// next to it as <name>_output.md.
//
// The pattern is picked with fzf, and which model answers is Fabric's business,
// configured once in ~/.config/fabric rather than here.

var a = new Args("generative-ai", "Run a text file through a Fabric prompt pattern")
    .Opt("-p", "--pattern", help: "Pattern name, skipping the fzf picker")
    .Rest("files", min: 1, help: "Text file to process")
    .Parse(args);

var selection = a.Rest[0];

Ui.Begin("Generative AI...");

if (!Fs.IsText(selection))
{
    Ui.Err($"{selection} is not a text file.");
    Snd.Error();
    Ui.End();
    return 1;
}

var patternsDir = Path.Combine(Paths.Home, ".config", "fabric", "patterns");
if (!Directory.Exists(patternsDir))
{
    Ui.Err($"No Fabric patterns found at {patternsDir}");
    Snd.Error();
    Ui.End();
    return 1;
}

// fzf owns the terminal while it runs, so this is a shell pipeline, not a capture.
var pattern = a.StrOrNull("pattern")
    ?? Proc.ShellCapture($"ls {ShellQuote(patternsDir)} | fzf").Trim();

if (string.IsNullOrWhiteSpace(pattern))
{
    Ui.Warn("No pattern chosen.");
    Ui.End();
    return 0;
}

var outputFilename = $"{Fs.SplitExt(selection).Name}_output.md";

Ui.Info($"Running pattern '{pattern}'...");

// Fabric reads the source text from stdin.
int code = Proc.Pipe(File.ReadAllText(selection), "fabric", "-sp", pattern, "-o", outputFilename);

if (code != 0)
{
    Ui.Err("Fabric failed.");
    Snd.Error();
    Ui.End();
    return code;
}

Ui.Ok($"Wrote {outputFilename}");

return Ui.Done();

static string ShellQuote(string value) => "'" + value.Replace("'", @"'\''") + "'";
