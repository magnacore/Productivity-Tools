#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for image-convert.
//
// The resize height comes from the caller (the ranger bindings pass 1080 or 0), so
// the only thing asked here is what should happen to the originals.

ArgVals a = new Args("image-convert-tui", "Ask about the originals, then run image-convert")
    .Pos("resize_dimension", "Height in pixels to resize to, or 0 for no resize")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "Images to convert")
    .Parse(args);

bool? deleteChoice = Dlg.DeleteOriginals("Images");
if (deleteChoice is null) { Ui.Warn("Operation cancelled by user."); return 0; }

List<string> callArgs = new() { a.Str("resize_dimension") };
if (deleteChoice.Value) callArgs.Add("-d");
callArgs.AddRange(a.Rest);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]image-convert {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("image-convert", callArgs);
