#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Tidy up freshly downloaded videos and file them in the capture inbox.
//
// yt-dlp writes uploader-less videos into a "NA" folder and prefixes each name
// with "NA - "; both are noise, so the prefix goes and the files move on.

var a = new Args("video-process", "Rename downloaded videos and move them to the capture inbox")
    .Flag("-n", "--dry-run", help: "Show what would be renamed and moved, without doing it")
    .Flag("-f", "--force", help: "Overwrite files already in the destination")
    .Parse(args);

bool dryRun = a.Flag("dry-run");

Ui.Begin("Moving videos...");

var moveFromPath = Path.Combine(Paths.Downloads, "NA");

if (!Directory.Exists(moveFromPath))
{
    Ui.Warn($"Nothing to do: {moveFromPath} does not exist.");
    Ui.End();
    return 0;
}

var allFiles = Directory.GetFiles(moveFromPath).OrderBy(f => f, StringComparer.Ordinal).ToList();

if (allFiles.Count == 0)
{
    Ui.Warn("Nothing to do: no files waiting.");
    Ui.End();
    return 0;
}

Ui.Info("Renaming Files...");
Ui.Track(allFiles, "[bold cyan]Renaming : [/]", file =>
{
    var newFilename = file.Replace("NA - ", string.Empty);
    if (newFilename == file) return;

    if (dryRun) { Ui.Line($"[dim]{Ui.Esc(file)} -> {Ui.Esc(newFilename)}[/]"); return; }

    try { Fs.Move(file, newFilename); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not rename {Ui.Esc(file)}: {ex.Message}[/]"); }
});

Ui.Info("Moving Files...");

if (dryRun)
{
    Ui.Line($"[dim]would move {moveFromPath}/* -> {Paths.TaskCaptureBin}/[/]");
    Ui.End();
    return 0;
}

// Downloads and the capture inbox are normally the same filesystem, so this is a
// rename per file rather than a byte copy. Fs.MoveInto falls back to rsync when they
// are not.
var waiting = Directory.GetFiles(moveFromPath).OrderBy(f => f, StringComparer.Ordinal).ToList();
int failures = waiting.Count == 0 ? 0 : Fs.MoveInto(waiting, Paths.TaskCaptureBin, a.Flag("force"));

return Ui.Done(failures);
