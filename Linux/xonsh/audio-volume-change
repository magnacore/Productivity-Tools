#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Change the volume of audio files with ffmpeg's volume filter.

ArgVals a = Jobs.Add(new Args("audio-volume-change", "Change audio volume")
    .Opt("-v", "--volume", required: true, help: "Volume value")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Audio/")
    .Rest("files", min: 1, help: "Files to process"))
    .Parse(args);

IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);

// Keep the gain inside a range that cannot destroy the signal.
double volume = Math.Clamp(a.Dbl("volume"), 0.1, 5.0);

Ui.Begin("Volume change...");

// Independent per file, and the encoder is single-core, so run several at once.
// -j 1 for a spinning disk, where concurrent streams cost more than they gain.
int failures = 0;

Ui.Track2(files, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Changing volume of {files.Count}:"))}[/]",
          (file, addBar) =>
{
    if (!Fs.IsAudio(file)) return;

    (string? name, string? ext) = Fs.SplitExt(file);
    string newFilename = $"{name}-{volume}v{ext}";

    Action<double> advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 100);

    if (Media.ConvertWithProgress(
            file, newFilename,
            ["-i", file, "-af", $"volume={volume}", newFilename], advance))
    {
        // Carry the date across before the original is moved away, so a
        // modified-time sort keeps the collection in its original order.
        Fs.CopyTimestamp(file, newFilename);
        Ui.Line($"[green]Changed volume of {Ui.Esc(newFilename)}[/]");
        Fs.HandleOriginal(file, a.Flag("delete"), "Audio");
    }
    else
    {
        Ui.Line($"[bold red]Could not change volume of {Ui.Esc(newFilename)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
