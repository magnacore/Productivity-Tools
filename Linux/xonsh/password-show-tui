#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Picker front end for password-show.
//
// A searchable list rather than a Terminal.Gui dialog, deliberately: a password
// store has too many entries to arrow through, and Dlg.Choose has no search.
// The separation that matters is CLI versus wrapper, not which widget is used.

var a = new Args("password-show-tui", "Pick a store entry from a searchable list, then run password-show")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

var entries = PassStore.Entries("password");

if (entries.Count == 0)
{
    Ui.Err($"No entries found in {PassStore.Root}/password");
    Snd.Error();
    return 1;
}

// Escape backs out of the menu, which ends the command.
var selection = Ui.Select(entries, "Which password to show...");

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]password-show {selection}[/]");
    return 0;
}

return Proc.Call("password-show", selection);
