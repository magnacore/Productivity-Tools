#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Convert images to WebP, optionally resizing on the way.
//
// Photographs go through lossy cwebp, because they were already lossy; anything
// else is encoded losslessly so screenshots and line art stay crisp. Animated
// GIFs need gif2webp, which preserves the frames.
//
//     image-convert 1080 *      resize to 1080px tall and convert
//     image-convert 0 *         convert only

ArgVals a = Jobs.Add(new Args("image-convert", "Convert images to WebP, optionally resizing")
    .Pos("resize_dimension", "Height in pixels to resize to, or 0 for no resize")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Images/")
    .Rest("files", min: 1, help: "Images to convert"))
    .Parse(args);

int resizeDimension = a.Int("resize_dimension");
IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin(resizeDimension > 0
    ? $"Changing images dimension to {resizeDimension}p and converting to webp format..."
    : "Converting images to webp format....");

IReadOnlyList<string> cleanFileNames = Fs.RenameToValid(allFiles);

bool deleteOriginals = a.Flag("delete");

// cwebp is a fork per image and they are wholly independent, so run them together.
int failures = 0;

Ui.Track2(cleanFileNames,
          $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Converting {cleanFileNames.Count}:"))}[/]",
          (image, addBar) =>
{
    if (!Fs.IsImage(image)) return;

    // No progress to read out of this tool, so the bar is one step: the spinner
    // shows the file is in flight, and a failure leaves the bar visibly unfilled.
    Action<double> advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{image}:"))}[/]", 1);

    (string? fileName, string? extension) = Fs.SplitExt(image);
    extension = extension.ToLowerInvariant().Trim();

    string newFilename = fileName;
    // A resized GIF would lose its animation timing, so it is never tagged.
    if (resizeDimension > 0 && extension != ".gif") newFilename += $"_{resizeDimension}p";
    // WebP to WebP would otherwise collide with its own source name.
    if (extension == ".webp") newFilename += "_converted";
    newFilename += ".webp";

    bool ok;
    if (extension is ".jpg" or ".jpeg")
    {
        // Already lossy, so lossless encoding would only waste space.
        ok = Proc.Ok("cwebp", "-metadata", "all", "-quiet",
                     "-resize", "0", resizeDimension.ToString(), image, "-o", newFilename);
    }
    else if (extension == ".gif")
    {
        ok = Proc.Ok("gif2webp", "-metadata", "all", "-quiet", image, "-o", newFilename);
    }
    else if (extension == ".webp" && resizeDimension == 0)
    {
        Ui.Line("[bold red]Skipping converting webp to webp with no change in dimension.[/]");
        return;
    }
    else
    {
        ok = Proc.Ok("cwebp", "-metadata", "all", "-quiet", "-lossless", "-exact",
                     "-resize", "0", resizeDimension.ToString(), image, "-o", newFilename);
    }

    if (ok)
    {
        // Before the original is moved away: these convert concurrently, so
        // without carrying the date across, a modified-time sort scrambles them.
        advance(1);
        Fs.CopyTimestamp(image, newFilename);
        Ui.Line($"[green]{Ui.Esc(image)} -> {Ui.Esc(newFilename)}[/]");
        Fs.HandleOriginal(image, deleteOriginals, "Images");
    }
    else
    {
        Ui.Line($"[bold red]Unable to convert {Ui.Esc(image)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
