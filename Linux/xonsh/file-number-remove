#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Strip a leading number from file names — the inverse of file-number and
// file-number-deep.

using System.Text.RegularExpressions;

var a = new Args("file-number-remove", "Remove leading digits from file names")
    .Rest("files", min: 1, help: "Files to process")
    .Parse(args);

var files = Fs.SortedFiles(a.Rest);

// Three or more digits followed by a separator, so "2001 A Space Odyssey.mkv"
// keeps its title but "001 intro.mkv" loses its prefix.

Ui.Begin("Removing leading numbers...");

Ui.Track(files, "[bold cyan]Renumbering : [/]", file =>
{
    var directory = Path.GetDirectoryName(file) ?? string.Empty;
    var oldName = Path.GetFileName(file);
    var newName = Pattern.LeadingNumber().Replace(oldName, string.Empty, 1);

    if (oldName == newName) return;

    try { Fs.Move(file, Path.Combine(directory, newName)); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not rename {Ui.Esc(file)}: {ex.Message}[/]"); }
});

return Ui.Done();

/// Source-generated matchers. Emitted at build time, so nothing parses a pattern
/// at startup — which matters for a program that runs for well under a second.
internal static partial class Pattern
{
    /// Three or more digits and a separator, so "2001 A Space Odyssey.mkv" keeps
/// its title while "001 intro.mkv" loses its prefix.
    [GeneratedRegex(@"^\d{3,}[-\s_]")]
    internal static partial Regex LeadingNumber();
}
