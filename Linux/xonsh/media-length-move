#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Take media off the top of the current directory until it adds up to roughly a
// target duration, then move that batch into a folder named for it ("3H", "90M").
// Turns a large backlog into a session-sized bundle.

ArgVals a = new Args("media-length-move", "Bundle media files into a folder based on a duration threshold")
    .Opt("-d", "--duration", @default: "180", help: "Target duration in minutes")
    .Opt("-s", "--sort", @default: "true", valueOptional: true, constValue: "true",
         help: "Sort by modified time (on by default). Use '-s false' to sort by name.")
    .Flag("-n", "--dry-run", help: "Show the selection without moving anything")
    .Parse(args);

int durationMinutes = a.Int("duration", 180);
bool sortByTime = a.Bool("sort", true);
bool dryRun = a.Flag("dry-run");

double targetDurationSeconds = durationMinutes * 60.0;

// Whole hours read better as "3H"; anything else stays in minutes.
string folderName = durationMinutes % 60 == 0
    ? $"{durationMinutes / 60}H"
    : $"{durationMinutes}M";

Ui.Begin($"Selecting ~{durationMinutes} minutes of media");

IReadOnlyList<string> allFiles = Fs.CurrentDirFiles();

if (sortByTime) allFiles = [.. allFiles.OrderBy(File.GetLastWriteTime)];
else allFiles = [.. allFiles.OrderBy(f => f.ToLowerInvariant(), StringComparer.Ordinal)];

Table table = Ui.NewTable($"Media Selected for '{folderName}' Directory", "Duration", "File name");
table.Columns[0].RightAligned();
table.Columns[1].LeftAligned();

List<string> filesToMove = new();
double totalDuration = 0.0;

// The bar fills with seconds of media rather than with files, so it shows how
// close the selection is to the target.
Ui.Meter("[bold cyan]Scanning media: [/]", targetDurationSeconds, advance =>
{
    foreach (string file in allFiles)
    {
        // Non-media is skipped silently, to keep the table readable.
        if (!Fs.IsMedia(file)) continue;

        double duration = Media.Duration(file);

        filesToMove.Add(file);
        totalDuration += duration;

        table.AddRow(
            Ui.Dim(filesToMove.Count - 1, $"[green]{Media.Hms(duration)}[/]"),
            Ui.Dim(filesToMove.Count - 1, Ui.Esc(file)));

        advance(Math.Min(duration, targetDurationSeconds));

        // Stop at the first file that carries the total past the target.
        if (totalDuration >= targetDurationSeconds) break;
    }
});

Ui.AddSeparator(table);
table.AddRow($"[bold green]{Media.Hms(totalDuration)}[/]", "[bold green]Total selected media duration[/]");
Ui.Show(table);

if (filesToMove.Count == 0)
{
    Ui.Warn("\nNo media files found to move.");
    Ui.End();
    return 0;
}

if (dryRun)
{
    Ui.Line($"\n[bold yellow]Dry run:[/] would move {filesToMove.Count} files into [cyan]{folderName}[/].");
    Ui.End();
    return 0;
}

Directory.CreateDirectory(folderName);

Ui.Track(filesToMove, $"[bold green]Moving to {folderName}/: [/]", file =>
{
    try { Fs.Move(file, Path.Combine(folderName, file)); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not move {Ui.Esc(file)}: {ex.Message}[/]"); }
});

Ui.Line($"\n[bold green]Success![/] Moved {filesToMove.Count} files to the [cyan]{folderName}[/] directory.");

return Ui.Done();
