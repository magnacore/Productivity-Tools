#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for mkv-extract-track.
//
// Reads each file's track layout with `mkvmerge -J` and offers it as a marked list —
// Space marks a track, Enter accepts — so video, audio and subtitle tracks can be
// picked out by what they are rather than by remembering a number from mkvinfo.
//
// Asked per file, because two files rarely have the same track layout.

using System.Text.Json;

ArgVals a = new Args("mkv-extract-track-tui", "Pick tracks from a list, then run mkv-extract-track")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Media/")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "Files to extract from")
    .Parse(args);

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);

// Asked once for the whole run rather than per file, since it is a policy rather
// than a per-file decision.
bool? deleteChoice = a.Flag("delete") ? true : Dlg.DeleteOriginals("Media");
if (deleteChoice is null) { Ui.Warn("Operation cancelled by user."); return 0; }

int failures = 0;

foreach (string file in allFiles)
{
    if (!Fs.IsMedia(file)) continue;

    List<TrackInfo> tracks = ReadTracks(file);

    if (tracks.Count == 0)
    {
        Ui.Warn($"No tracks found in {file}; skipping.");
        continue;
    }

    string[] labels = tracks.Select(Describe).ToArray();

    int[]? picked = Dlg.ChooseMany(
        "Extract Tracks",
        $"{Path.GetFileName(file)}\n\nSpace marks a track, Enter extracts the marked ones.",
        labels);

    if (picked is null)
    {
        Ui.Warn($"Skipped {file}.");
        continue;
    }

    if (picked.Length == 0)
    {
        Ui.Warn($"No track marked for {file}; skipping.");
        continue;
    }

    string ids = string.Join(',', picked.Select(i => tracks[i].Id));

    List<string> callArgs = new() { "-t", ids };
    if (deleteChoice.Value) callArgs.Add("-d");
    callArgs.Add(file);

    if (a.Flag("dry-run"))
    {
        Ui.Line($"[dim]mkv-extract-track {string.Join(' ', callArgs)}[/]");
        continue;
    }

    if (Proc.Call("mkv-extract-track", callArgs) != 0) failures++;
}

return failures == 0 ? 0 : 1;

/// One row of the list: what the track is, in the terms someone choosing would use.
static string Describe(TrackInfo track)
{
    List<string> detail = new() { track.Codec };

    if (!string.IsNullOrWhiteSpace(track.Language) && track.Language != "und")
        detail.Add(track.Language);

    if (!string.IsNullOrWhiteSpace(track.Name)) detail.Add(track.Name);

    return $"{track.Id}  {track.Kind,-9}  {string.Join("  ", detail)}";
}

/// The tracks in a Matroska file, from `mkvmerge -J`.
///
/// The same source mkv-extract-track itself reads, so the IDs listed here are exactly
/// the IDs it will accept.
static List<TrackInfo> ReadTracks(string file)
{
    List<TrackInfo> tracks = new();
    string json = Proc.Capture("mkvmerge", "-J", file);

    if (string.IsNullOrWhiteSpace(json)) return tracks;

    try
    {
        using JsonDocument document = JsonDocument.Parse(json);

        if (!document.RootElement.TryGetProperty("tracks", out JsonElement array)) return tracks;

        foreach (JsonElement element in array.EnumerateArray())
        {
            if (!element.TryGetProperty("id", out JsonElement idValue) || !idValue.TryGetInt32(out int id))
                continue;

            string kind = element.TryGetProperty("type", out JsonElement t) ? t.GetString() ?? "track" : "track";
            string codec = element.TryGetProperty("codec", out JsonElement c) ? c.GetString() ?? "" : "";

            string language = "", name = "";

            if (element.TryGetProperty("properties", out JsonElement properties))
            {
                if (properties.TryGetProperty("language", out JsonElement l)) language = l.GetString() ?? "";
                if (properties.TryGetProperty("track_name", out JsonElement n)) name = n.GetString() ?? "";
            }

            tracks.Add(new TrackInfo(id, kind, codec, language, name));
        }
    }
    catch (JsonException ex)
    {
        Ui.Warn($"Could not read the track list of {file}: {ex.Message}");
    }

    return tracks;
}

internal sealed record TrackInfo(int Id, string Kind, string Codec, string Language, string Name);
