#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// ROT13 the clipboard in place, rotating digits by 5 so the transform is its own
// inverse — running it twice gives back the original.
//
// This is casual obfuscation for shoulder-surfing, not encryption.

ArgVals a = new Args("clipboard-rot13-rotate", "ROT13/5 the clipboard in place")
    .Parse(args);

Ui.Begin("Encrypting clipboard using Rot13/5 Cipher...");

string clipboardContent = Clip.Paste();

if (clipboardContent.Length == 0)
{
    Ui.Err("Clipboard is empty.");
    Snd.Error();
    Ui.End();
    return 1;
}

string cipherText = Crypto.Rot13And5(clipboardContent);
Clip.Copy(cipherText);

// Read the clipboard back and undo the rotation: this proves the text really
// made it onto the clipboard intact, not just that the maths was right.
string plainText = Crypto.Rot13And5(Clip.Paste());

if (plainText != clipboardContent)
{
    Ui.Err("ERROR!");
    Snd.Error();
    Ui.End();
    return 1;
}

Ui.Line($"Copied: Rot13 encryption of [bold cyan]{Ui.Esc(clipboardContent)}[/] " +
        $"is [bold green]{Ui.Esc(cipherText)}[/]");

WarnAboutEdgeSpaces(cipherText);

return Ui.Done();

/// A leading or trailing space is invisible when pasted and silently breaks the
/// round trip, so make it visible.
static void WarnAboutEdgeSpaces(string cipherText)
{
    if (cipherText.Length == 0) return;

    string visible = cipherText.Replace(" ", "<SPACE>");

    if (cipherText[0] == ' ')
        Ui.Err($"Warning: Ciphertext contains a leading space! {visible}");
    else if (cipherText[^1] == ' ')
        Ui.Err($"Warning: Ciphertext contains a trailing space! {visible}");
}
