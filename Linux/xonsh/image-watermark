#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Tile rotated, semi-transparent text across an image.
//
//     image-watermark in.jpg out.png "DRAFT" 72 50 150
//
// The positional order is kept from the original so image-watermark-tui, and any
// existing shell aliases, keep working unchanged.

ArgVals a = new Args("image-watermark", "Tile a rotated text watermark across an image")
    .Opt("-r", "--rotation", @default: "45", help: "Rotation angle of the watermark text")
    .Opt("-c", "--colour", @default: "255,0,0", help: "Watermark colour as R,G,B")
    .Rest("arguments", min: 3,
          help: "input_image output_image watermark_text [font_size] [spacing] [opacity]")
    .Parse(args);

IReadOnlyList<string> rest = a.Rest;
string inputImage = rest[0];
string outputImage = rest[1];
string watermarkText = rest[2];
int fontSize = rest.Count > 3 && int.TryParse(rest[3], out int fs) ? fs : 72;
int spacing = rest.Count > 4 && int.TryParse(rest[4], out int sp) ? sp : 50;
int opacity = rest.Count > 5 && int.TryParse(rest[5], out int op) ? op : 128;

if (!File.Exists(inputImage))
{
    Console.Error.WriteLine($"error: no such image: {inputImage}");
    Snd.Error();
    return 1;
}

// Prefer the font the original hardcoded, but fall back to whatever fontconfig
// offers rather than failing outright.
string font = ResolveFont("Cantarell");

// ImageMagick wants the alpha channel as a fraction; the CLI takes 0-255.
string alpha = (Math.Clamp(opacity, 0, 255) / 255.0).ToString("0.###", CultureInfo.InvariantCulture);
string fill = $"rgba({a.Str("colour")},{alpha})";

// Render the text once into a named memory register (mpr:wm), rotate it, pad it
// with the requested spacing, then tile that single stamp across a transparent
// layer the size of the image and composite the layer on top. Tiling one cached
// stamp is why this is a single command rather than a loop over positions.
int code = Proc.Run("magick",
[
    inputImage, "-alpha", "set",
        "(",
            "-background", "none",
            "-fill", fill,
            "-font", font,
            "-pointsize", fontSize.ToString(),
            $"label:{watermarkText}",
            "-bordercolor", "none", "-border", (spacing / 2).ToString(),
            "-rotate", a.Str("rotation"),
            "-write", "mpr:wm", "+delete",
        ")",
        "(",
            "+clone", "-alpha", "transparent",
            "-background", "none",
            "-tile", "mpr:wm",
            "-draw", "color 0,0 reset",
        ")",
    "-composite",
    // Always PNG: the watermark needs an alpha channel to composite cleanly.
    $"PNG:{outputImage}",
]);

if (code != 0)
{
    Snd.Error();
    return 1;
}

// Keep the source image's date so a modified-time sort stays in the same order.
Fs.CopyTimestamp(inputImage, outputImage);

return 0;

/// Find a usable font file, preferring `preferred`.
static string ResolveFont(string preferred)
{
    string matched = Proc.Capture("fc-match", "-f", "%{file}", preferred);
    return File.Exists(matched) ? matched : preferred;
}
