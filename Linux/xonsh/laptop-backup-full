#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Unlock the encrypted backup disk, mount it, rotate its snapshot, and mirror the
// whole of $HOME onto it.
//
// This is the unfiltered backup: no exclude list, so caches and build output come
// along too. Pair with laptop-backup-full-eject to close it down safely.

ArgVals a = Sys.WithDryRun(new Args("laptop-backup-full", "Mirror $HOME onto the encrypted full-backup disk")).Parse(args);
Sys.Apply(a);

Ui.Begin("Laptop Backup Full...");

string mountPoint = Path.Combine(Paths.Media, "laptop_backup_full");
string current = Path.Combine(mountPoint, "@current");
string previous = Path.Combine(mountPoint, "@previous");

Sys.Remove(Sys.CopyLog);

Ui.Info("Open the container...");
Sys.Sudo("cryptsetup", "luksOpen", "/dev/sda", "luks-laptop-backup-full");

Ui.Info("Mount the container...");
Sys.Sudo("mkdir", "-p", mountPoint);
Sys.Sudo("chown", $"{Paths.User}:{Paths.User}", mountPoint);

// The LVM volume is assembled asynchronously after the LUKS container opens,
// so give the device node time to appear before mounting it.
Ui.Info("Waiting for 5 seconds before mounting...");
if (!Sys.DryRun) Thread.Sleep(5000);

if (Sys.Run("sudo", "mount", "/dev/vg-laptop-backup-full/raid1-1", mountPoint) != 0)
{
    Ui.Err("Something went wrong. Could not mount.");
    Snd.Error();
    Ui.End();
    return 1;
}

Sys.RotatePreviousSnapshot(current, previous);

Ui.Info("Synchronizing...");
Sys.SudoRsync("-vahiP", "--delete", $"--log-file={Sys.CopyLog}", Paths.Home + "/", current);

Sys.Stamp("laptop-backup-full");
Sys.StampFile(Path.Combine(current, "backup_date.txt"));

return Ui.Done();
