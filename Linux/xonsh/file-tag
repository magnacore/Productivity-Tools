#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Append a "#tag" to file names, so a plain filesystem search doubles as a
// tagging system:  lecture.mkv  ->  "lecture #physics.mkv"

ArgVals a = new Args("file-tag", "Add a #tag to file names")
    .Pos("tag", "The tag to add, without the '#'")
    .Rest("files", min: 1, help: "Files to tag")
    .Parse(args);

string tag = a.Str("tag");
IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);

Ui.Begin($"Adding tag #{tag}...");

Ui.Track(files, "[bold cyan]Tagging : [/]", file =>
{
    (string? name, string? ext) = Fs.SplitExt(file);
    string newFilename = $"{name} #{tag}{ext}";

    try { Fs.Move(file, newFilename); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not tag {Ui.Esc(file)}: {ex.Message}[/]"); }
});

Ui.End();
return 0;
