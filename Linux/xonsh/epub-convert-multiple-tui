#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for epub-convert-multiple and epub-split.
//
// Picks the output shape, then delegates. Nothing is converted here.
//
ArgVals a = new Args("epub-convert-multiple-tui", "Choose an EPUB conversion in a dialog, then run it")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "Epubs to process")
    .Parse(args);

IReadOnlyList<string> files = a.Rest;

int? format = Dlg.Choose(
    "Convert epub", "What is the output file format?",
    "PDF : Portable Document Format",
    "Plain text file",
    "Split Epub");

if (format is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

List<string> callArgs;
string program;

switch (format.Value)
{
    case 0:
        int? size = Dlg.Choose(
            "Choose page size", "What is the output file dimensions?",
            "Canger preview",
            "A4 page @300 DPI");

        if (size is null)
        {
            Ui.Warn("Operation cancelled by user.");
            return 0;
        }

        program = "epub-convert-multiple";
        callArgs = size.Value == 0
            // Small e-reader page: readable in a file manager's preview pane.
            ? ["-o", "pdf"]
            // A4 at 300 DPI, for printing: 2480x3508 points with proportionate type.
            : ["-o", "pdf", "-w", "2480", "-l", "3508", "-f", "80", "-m", "100"];
        break;

    case 1:
        program = "epub-convert-multiple";
        callArgs = ["-o", "txt"];
        break;

    default:
        program = "epub-split";
        callArgs = ["-s", "10"];
        break;
}

callArgs.AddRange(files);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]{program} {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call(program, callArgs);
