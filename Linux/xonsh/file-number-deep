#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Number every video under one or more directory trees with a single running
// counter, so a course split across chapter folders plays in the right order.
//
//     Usage from ranger:  :shell -w file-number-deep Folder_1 Folder_2
//     Select the root folder and run. Do not descend into it first.

ArgVals a = new Args("file-number-deep", "Number all videos under a directory tree")
    .Rest("directories", min: 1, help: "Directories to process")
    .Parse(args);

Ui.Begin("Numbering media in directory");

foreach (string directory in a.Rest)
{
    if (!Directory.Exists(directory))
    {
        Ui.Warn($"Skipping {directory} (not a directory)");
        continue;
    }

    Ui.Begin($"Numbering media in {directory}");

    // Walk once and keep only videos. The xonsh original called listdir() inside
    // the walk, so every file was visited once per directory level; enumerating
    // the tree directly gives each file exactly one number.
    List<string> fileList = new();
    foreach (string path in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
    {
        if (Fs.IsVideo(path)) fileList.Add(path);
        else Ui.Line($"[yellow]Skipping {Ui.Esc(Path.GetFileName(path))}[/]");
    }

    // One counter across the whole tree, so ordering is global, not per-folder.
    fileList.Sort(StringComparer.Ordinal);

    int i = 1;
    Ui.Track(fileList, "[bold cyan]Numbering : [/]", filePath =>
    {
        string dirName = Path.GetDirectoryName(filePath) ?? string.Empty;
        string baseName = Path.GetFileName(filePath);
        string newPath = Path.Combine(dirName, $"{i:D4}-{baseName}");

        try { Fs.Move(filePath, newPath); }
        catch (Exception ex) { Ui.Line($"[bold red]Could not number {Ui.Esc(baseName)}: {ex.Message}[/]"); }

        i++;
    });
}

return Ui.Done();
