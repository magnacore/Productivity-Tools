#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Tag each file with how many are left and how far through the set it is:
//     lecture-03.mkv  ->  lecture-03-007r-030p.mkv
// so a file manager sorted by name also tells you your progress.
//
// Deliberately prints no rule: this command is invoked by other commands
// (epub-split, media-split-equal) and the extra output would break their display.

var a = new Args("file-tag-percentage", "Tag files with remaining count and percent complete")
    .Rest("files", min: 1, help: "Files to tag")
    .Parse(args);

var files = Fs.SortedFiles(a.Rest);

int failures = 0;
int total = files.Count;
int position = 1;
int countdown = total;

Ui.Track(files, "[bold cyan]Tagging : [/]", file =>
{
    var (name, ext) = Fs.SplitExt(file);
    var newFilename = $"{name}-{countdown:D3}r-{position * 100 / total:D3}p{ext}";

    try { Fs.Move(file, newFilename); }
    catch (Exception ex)
    {
        Ui.Line($"[bold red]Could not tag {Ui.Esc(file)}: {ex.Message}[/]");
        failures++;
    }

    position++;
    countdown--;
});

// A caller that shells out to this — epub-split and media-split-equal both do —
// has no other way to tell that some of the renames did not happen.
return failures == 0 ? 0 : 1;
