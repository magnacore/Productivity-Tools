#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// For each YouTube URL on the clipboard, look up the video's real title and drop
// a stub file named after it into the capture inbox — so the backlog reads as
// titles rather than as opaque video IDs.

ArgVals a = new Args("clipboard-youtube-save", "Save clipboard YouTube links as titled stub files")
    .Parse(args);

IReadOnlyList<string> urls = Fs.FindUrls(Clip.Paste());
List<string> youtubeUrls = urls.Where(u => u.Contains("youtu", StringComparison.OrdinalIgnoreCase)).ToList();

if (youtubeUrls.Count == 0)
{
    Snd.Error();
    Snd.Notify("No YouTube URL on the clipboard");
    return 1;
}

int saved = 0;

foreach (string url in youtubeUrls)
{
    string videoName = Proc.Capture("/opt/anaconda3/envs/util/bin/yt-dlp", "--print", "%(title)s", url);

    if (string.IsNullOrWhiteSpace(videoName))
    {
        Console.Error.WriteLine($"Could not read the title of {url}");
        Snd.Error();
        Snd.Notify("Could not read video title", url);
        continue;
    }

    // The title becomes a file name, so strip anything a path cannot hold.
    string safeName = string.Concat(videoName.Split(Path.GetInvalidFileNameChars())).Trim();
    if (safeName.Length == 0) safeName = Fs.Uuid();

    string fileName = Path.Combine(Paths.TaskCaptureBin, $"{safeName}.youtube");

    try
    {
        Directory.CreateDirectory(Paths.TaskCaptureBin);
        File.AppendAllText(fileName, url + Environment.NewLine);
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Could not write {fileName}: {ex.Message}");
        Snd.Error();
        continue;
    }

    Snd.Success();
    Snd.Notify(videoName, url);
    saved++;
}

return saved > 0 ? 0 : 1;
