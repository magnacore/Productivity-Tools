#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Change the playback speed of audio files with ffmpeg's atempo filter.
//
// For Neospeech Julie at 0, a setting of 0.8 makes the audio play well at 1.5x.

var a = Jobs.Add(new Args("audio-speed-change", "Change audio speed")
    .Opt("-s", "--speed", required: true, help: "Speed value")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Audio/")
    .Rest("files", min: 1, help: "Files to process"))
    .Parse(args);

var files = Fs.SortedFiles(a.Rest);

// ffmpeg's atempo filter is only defined over [0.5, 2.0].
var speed = Math.Clamp(a.Dbl("speed"), 0.5, 2.0);

Ui.Begin("Speed change...");

// Each file is independent, and the Opus encoder runs on one core, so several at
// once is close to a linear speedup. Use -j 1 on a spinning disk, where the extra
// concurrent streams cost more in seeks than they gain.
int failures = 0;

Ui.Track2(files, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Changing speed of {files.Count}:"))}[/]",
          (file, addBar) =>
{
    if (!Fs.IsAudio(file)) return;

    var (name, ext) = Fs.SplitExt(file);
    var newFilename = $"{name}-{speed}x{ext}";

    var advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 100);

    if (Media.ConvertWithProgress(
            file, newFilename,
            ["-i", file, "-filter:a", $"atempo={speed}", "-vn", newFilename], advance))
    {
        // Carry the date across before the original is moved away, so a
        // modified-time sort keeps the collection in its original order.
        Fs.CopyTimestamp(file, newFilename);
        Ui.Line($"[green]Changed speed of {Ui.Esc(newFilename)}[/]");
        Fs.HandleOriginal(file, a.Flag("delete"), "Audio");
    }
    else
    {
        Ui.Line($"[bold red]Could not change speed of {Ui.Esc(newFilename)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
