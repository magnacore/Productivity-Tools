#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Move staged tutorials from the laptop onto the learning drive, keeping the
// already-converted ones apart from those still waiting, and preserving the
// urgency split within the latter.

ArgVals a = Sys.WithDryRun(new Args("tutorials-move", "Move staged tutorials onto the learning drive")).Parse(args);
Sys.Apply(a);

Ui.Begin("Moving tutorials...");

string staging = Path.Combine(Paths.Home, "Copy_To_HDD");
string tutorials = Path.Combine(Paths.Media, "LEARNING", "VIDEO TUTORIALS");

(string From, string To)[] moves =
[
    ("01 CONVERTED",   "CONVERTED/0 TO SORT"),
    ("02 TO CONVERT/01", "NOT CONVERTED/01 IMP UR"),
    ("02 TO CONVERT/02", "NOT CONVERTED/02 IMP NOT URGENT"),
];

foreach ((string? from, string? to) in moves)
    Sys.MoveContents(Path.Combine(staging, from), Path.Combine(tutorials, to) + "/");

return Ui.Done();
