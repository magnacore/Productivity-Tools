#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for pdf-split.
//
// Asks how many pages each part should hold, the choice the xonsh original offered.
// All the splitting lives in pdf-split.

var a = new Args("pdf-split-tui", "Choose a part size in a dialog, then run pdf-split")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "PDFs to split")
    .Parse(args);

// The presets the original menu carried, plus a free-text option.
(string Label, string Pages)[] sizes =
[
    ("1 page per part",  "1"),
    ("10 pages",         "10"),
    ("80 pages",         "80"),
    ("Custom...",        ""),
];

var chosen = Dlg.Choose("Split PDFs", "How many pages should each part hold?",
                        [.. sizes.Select(s => s.Label)]);
if (chosen is null) { Ui.Warn("Operation cancelled by user."); return 0; }

var pages = sizes[chosen.Value].Pages;

if (pages.Length == 0)
{
    var typed = Dlg.Input("Pages per part", "How many pages should each part hold?", "10");
    if (typed is null) { Ui.Warn("Operation cancelled by user."); return 0; }

    if (!int.TryParse(typed.Trim(), out var n) || n < 1)
    {
        Ui.Err($"'{typed}' is not a page count.");
        Snd.Error();
        return 2;
    }
    pages = n.ToString(CultureInfo.InvariantCulture);
}

var callArgs = new List<string> { pages };
callArgs.AddRange(a.Rest);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]pdf-split {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("pdf-split", callArgs);
