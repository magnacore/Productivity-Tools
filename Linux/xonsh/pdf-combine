#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package PdfPig@0.1.15
#:property Configuration=Release
#:include utilities.cs

// Merge PDFs into one, in name order.

using UglyToad.PdfPig.Writer;

var a = new Args("pdf-combine", "Merge PDFs into a single file")
    .Rest("files", min: 1, help: "PDFs to merge, in page order")
    .Parse(args);

Ui.Begin("Combining pdf....");

// Sorted, because the file order decides the page order.
var pdfs = Fs.SortedFiles(a.Rest).Where(Fs.IsPdf).ToList();

if (pdfs.Count == 0) return Ui.NoFiles("No PDFs selected!");

foreach (var pdf in pdfs) Ui.Line($"[green]Merging {Ui.Esc(pdf)}[/]");

var outputFilename = $"combined_{Fs.Timestamp()}.pdf";

try
{
    using var output = File.Create(outputFilename);
    PdfMerger.Merge(output, [.. pdfs]);
}
catch (Exception ex)
{
    Ui.Err($"Could not merge: {ex.Message}");
    Snd.Error();
    Ui.End();
    return 1;
}

Ui.Ok($"Merged {pdfs.Count} PDFs into {outputFilename}");

return Ui.Done();
