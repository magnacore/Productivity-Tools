#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Change the extension of the selected files — for the common case where a file
// is already in the right container but carries the wrong suffix.

ArgVals a = new Args("file-rename-extension", "Change the extension of the selected files")
    .Opt("-e", "--extension", required: true,
         help: "New extension, without the dot (e.g. mkv, opus, mka, txt, md)")
    .Rest("files", min: 1, help: "Files to rename")
    .Parse(args);

IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);

// Accept "mkv" and ".mkv" alike; the dot is added when the name is rebuilt.
string extensionChoice = a.Str("extension").TrimStart('.');

if (extensionChoice.Length == 0)
{
    Ui.Err("--extension cannot be empty.");
    return 2;
}

foreach (string file in files)
{
    (string? name, string? ext) = Fs.SplitExt(file);

    // An empty extension means a directory, which has nothing to rename.
    if (ext.Length == 0) continue;

    try { Fs.Move(file, $"{name}.{extensionChoice}"); }
    catch (Exception ex) { Ui.Err($"Could not rename {file}: {ex.Message}"); }
}

return 0;
