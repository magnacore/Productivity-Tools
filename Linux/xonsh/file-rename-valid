#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Rename files to safe, lowercase, ASCII-only names.
//
// This script must print NOTHING except the resulting list of names: its stdout
// is the input of other scripts. (Inside the C# suite nothing needs to shell out
// here any more — callers use Fs.RenameToValid() directly — but the contract is
// kept so the xonsh scripts and anything else parsing it still work.)

ArgVals a = new Args("file-rename-valid", "Rename files to valid, slugified names")
    .Rest("files", min: 1, help: "Files to rename")
    .Parse(args);

IReadOnlyList<string> renamed = Fs.RenameToValid(Fs.SortedFiles(a.Rest));

// A Python list repr, which is what the existing consumers ast.literal_eval.
Console.WriteLine("[" + string.Join(", ", renamed.Select(n => $"'{n.Replace("'", @"\'")}'")) + "]");
return 0;
