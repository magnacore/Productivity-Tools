#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for directory-file-permission-set.
//
// Two presets, because these are the only two that ever get used: shareable
// (others may read) and private (nobody but you).

ArgVals a = new Args("directory-file-permission-set-tui", "Choose a permission preset in a dialog, then apply it")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("folder", min: 1, help: "Input directory to process")
    .Parse(args);

int? choice = Dlg.Choose(
    "Set Directories and Files Permission Recursively",
    "What should be the octal permission of directories and files?",
    "744 644",   // readable by others
    "700 600");  // private

if (choice is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

(string? dirPermission, string? filePermission) = choice.Value == 0 ? ("744", "644") : ("700", "600");

List<string> callArgs = new() { "-d", dirPermission, "-f", filePermission };
if (a.Flag("dry-run")) callArgs.Add("--dry-run");
callArgs.AddRange(a.Rest);

return Proc.Call("directory-file-permission-set", callArgs);
