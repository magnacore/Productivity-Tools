#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Prepare a folder of single-page PDFs for manual duplex printing: deal the pages
// alternately into odd and even piles, then bind each pile into one file.
// Print Odd.pdf, flip the stack, print Even.pdf.

ArgVals a = new Args("pdf-seperate", "Split PDFs into odd/even sets for duplex printing")
    .Flag("-n", "--dry-run", help: "Show the split without moving anything")
    .Parse(args);

Ui.Begin("Seperating even and odd PDF files for duplex printing...");

// Operates on the current directory: the input is "the stack of pages here".
List<string> pdfFiles = Directory.GetFiles(Directory.GetCurrentDirectory(), "*.pdf")
    .Select(Path.GetFileName)
    .Where(f => f is not null)
    .Select(f => f!)
    .OrderBy(f => f, StringComparer.Ordinal)
    .ToList();

if (pdfFiles.Count == 0)
{
    Ui.Err("No PDFs found...");
    Snd.Error();
    Ui.End();
    return 1;
}

if (a.Flag("dry-run"))
{
    for (int i = 0; i < pdfFiles.Count; i++)
        Ui.Line($"[dim]{(i % 2 == 0 ? "odd " : "even")} <- {Ui.Esc(pdfFiles[i])}[/]");
    Ui.End();
    return 0;
}

Directory.CreateDirectory("even");
Directory.CreateDirectory("odd");

// The first page is page 1, which is odd.
for (int i = 0; i < pdfFiles.Count; i++)
{
    string destination = i % 2 == 0 ? "odd" : "even";
    try { Fs.Move(pdfFiles[i], Path.Combine(destination, pdfFiles[i])); }
    catch (Exception ex) { Ui.Err($"Could not move {pdfFiles[i]}: {ex.Message}"); }
}

// Ghostscript concatenates; -dAutoRotatePages=/None stops it from "helpfully"
// turning pages, which would break the duplex alignment.
foreach ((string? pile, string? output) in new[] { ("even", "Even.pdf"), ("odd", "Odd.pdf") })
{
    Ui.Info($"Combining {pile} PDFs...");
    // A glob is the point here, so this genuinely needs a shell.
    Proc.Shell($"gs -dBATCH -dNOPAUSE -q -sDEVICE=pdfwrite -dAutoRotatePages=/None " +
               $"-sOutputFile={output} {pile}/*.pdf");
}

return Ui.Done();
