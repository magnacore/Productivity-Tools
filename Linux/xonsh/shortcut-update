#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// The periodic maintenance routine: sweep the inbox, update the system, and — on
// a fortnightly schedule — do the deep clean.
//
// The cleanup only runs on Saturdays in even months. It is slow and aggressive
// (it deletes caches, logs and container images system-wide), so it is kept off
// the daily path and lands roughly once a fortnight, on a day when a long run
// does not get in the way.

ArgVals a = Sys.WithDryRun(new Args("shortcut-update", "Periodic system maintenance"))
    .Flag("-c", "--clean", help: "Force the deep clean, whatever day it is")
    .Flag("-s", "--skip-clean", help: "Skip the deep clean, whatever day it is")
    .Parse(args);
Sys.Apply(a);

Ui.Begin("Updating [Shortcut]...");

Ui.Info("Delete old files in trash...");
Sys.Run("trash-empty", "-f", "3");

// --- Sweep everything that accumulates into the capture inbox ---------------
Ui.Info("Moving Files...");

string inbox = Paths.TaskCaptureBin;

MoveWithBackup(Path.Combine(Paths.ProductivitySystem,
    "02 POOL", "01 CREATION ACTIVE", "02 RELAX ACTIVE MATERIAL", "ANDROID CAMERA", "Camera"), "*");
MoveWithBackup(Path.Combine(Paths.Home, "Pictures"), "*.png");
MoveWithBackup(Path.Combine(Paths.ProductivitySystem, "04 BIN", "04 RA RP SP", "TRAVEL", "DUMP"), "*");

// --- Routine updates --------------------------------------------------------
Ui.Info("Update locate database...");
Sys.Sudo("updatedb");

Ui.Info("Update repositories...");
Sys.Sudo("apt", "update", "-y");

Ui.Info("Upgrade software...");
Sys.Sudo("apt", "upgrade", "-y");
Sys.Run("flatpak", "update", "-y");

// --- Deep clean, on a fortnightly rhythm ------------------------------------
// Saturday, in an even month.
DateTime today = DateTime.Today;
bool scheduled = today.DayOfWeek == DayOfWeek.Saturday && today.Month % 2 == 0;
bool deepClean = a.Flag("clean") || (scheduled && !a.Flag("skip-clean"));

if (!deepClean)
{
    Ui.Good("Skipping cleanup.");
}
else
{
    Ui.Info("Clean software cache...");
    Sys.Sudo("apt", "autoremove", "-y");
    Sys.Sudo("apt", "clean", "-y");

    Ui.Info("Clean flatpaks...");
    Sys.Run("flatpak", "update", "--appstream");
    Sys.Run("flatpak", "uninstall", "--unused", "-y");

    Ui.Info("Update prompts...");
    Sys.Run("fabric", "-U");

    Ui.Info("Deleting unused conda packages...");
    Sys.Run("conda", "clean", "--all", "-y");

    Ui.Info("Deleting journalctl history...");
    Sys.Sudo("journalctl", "--vacuum-time=4weeks");

    Ui.Info("Clean cache...");
    EmptyDirectory(Path.Combine(Paths.Home, ".cache"));
    EmptyDirectory(Path.Combine(Paths.Home, ".var", "app", "net.sourceforge.liferea", "cache"));

    // The C# suite's compiled output. Cleared rather than pruned: the directory is
    // keyed by program path and rebuilds itself on demand, so the only cost is that
    // the next run of each program pays its build once.
    Ui.Info("Clear .NET build cache (it rebuilds on demand)...");
    ClearBuildCache();

    // The downloaded packages themselves — a bigger reclaim than the build cache
    // above, around half a gigabyte across the package store and the http cache.
    //
    // Unlike the build cache this one cannot be rebuilt offline: the next build of
    // anything has to fetch Spectre.Console, Terminal.Gui, PdfPig, ScottPlot and the
    // Google SDKs from nuget.org again. Run the deep clean before going offline for a
    // while and the first program you reach for will fail to build.
    Ui.Info("Clear NuGet package caches...");
    Sys.Run("/opt/anaconda3/envs/dotnet/lib/dotnet/dotnet", "nuget", "locals", "all", "--clear");

    Ui.Info("Clean Xonsh history...");
    EmptyDirectory(Path.Combine(Paths.Home, ".local", "share", "xonsh"));

    Ui.Info("Deleting logs from home folder...");
    Sys.Sudo("find", Paths.Home + "/", "-type", "f", "-iname", "*.log", "-delete");
    EmptyDirectory(Path.Combine(Paths.Home, ".var", "app", "com.obsproject.Studio", "config", "obs-studio", "logs"));

    Ui.Info("Deleting .DS_Store files...");
    DeleteFilesNamed(".DS_Store");

    Ui.Info("Deleting .bak files...");
    DeleteFilesNamed("*.bak");
    DeleteFilesNamed("*.bkp");

    Ui.Info("Deleting desktop.ini files...");
    DeleteFilesNamed("desktop.ini");

    Ui.Info("Deleting .ipynb_checkpoints directories...");
    DeleteDirectoriesNamed(Paths.Home, ".ipynb_checkpoints");

    Ui.Info("Deleting __pycache__ directories...");
    DeleteDirectoriesNamed("/opt", "__pycache__");
    DeleteDirectoriesNamed(Paths.Home, "__pycache__");

    Ui.Info("Deleting __MACOSX directories...");
    DeleteDirectoriesNamed(Paths.Home, "__MACOSX");

    Ui.Info("Deleting .thumbnails directories...");
    DeleteDirectoriesNamed(Paths.Home, ".thumbnails");

    Ui.Info("Deleting snapper snapshots...");
    Proc.Call("snapper-rollback-snapshot-delete", Sys.DryRun ? ["--dry-run"] : []);

    Ui.Info("Free container space...");
    Sys.Run("podman", "system", "prune");
    Sys.Run("podman", "system", "reset");
}

Proc.Call("hdd-size");

Sys.Stamp("system-update");

Ui.End();
return 0;

/// Empty the .NET build cache, skipping whatever a running process still needs.
///
/// A plain "rm -rf ~/.local/share/dotnet/*" cannot be used here, and the reason is
/// worth spelling out. update-shutdown calls this program, so when this program wiped
/// the cache it also deleted update-shutdown's own Spectre.Console.dll. Assemblies
/// load lazily, so the parent did not fall over at once — it carried on until it
/// reached Ui.Info("Shutting down...") after this returned, and only then died with
///
///     FileNotFoundException: Could not load file or assembly 'Spectre.Console'
///
/// which meant the machine never shut down. Anything else that calls this program is
/// exposed the same way.
///
/// /proc/&lt;pid&gt;/maps lists the files each process has mapped, and that is exactly the
/// set that has to survive. Those directories are left alone and cleared by the next
/// run, once nothing is using them.
static void ClearBuildCache()
{
    string root = Path.Combine(Paths.Home, ".local", "share", "dotnet", "runfile");

    if (!Directory.Exists(root))
    {
        Ui.Line("[dim]No build cache to clear.[/]");
        return;
    }

    HashSet<string> inUse = DirectoriesInUse(root);
    int cleared = 0, kept = 0;

    foreach (string directory in Directory.GetDirectories(root))
    {
        if (inUse.Contains(Path.GetFileName(directory))) { kept++; continue; }

        if (Sys.DryRun)
        {
            Ui.Line($"[dim]rm -rf {Ui.Esc(directory)}[/]");
            cleared++;
            continue;
        }

        try
        {
            Directory.Delete(directory, recursive: true);
            cleared++;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Ui.Warn($"Could not remove {directory}: {ex.Message}");
        }
    }

    Ui.Good($"Cleared {cleared} build cache(s)" +
            (kept == 0 ? "." : $", kept {kept} still in use."));
}

/// The names of the cache directories some live process has a file mapped from.
static HashSet<string> DirectoriesInUse(string root)
{
    HashSet<string> names = new(StringComparer.Ordinal);
    string prefix = root + Path.DirectorySeparatorChar;

    foreach (string process in Directory.GetDirectories("/proc"))
    {
        if (!int.TryParse(Path.GetFileName(process), out _)) continue;

        try
        {
            foreach (string line in File.ReadLines(Path.Combine(process, "maps")))
            {
                int at = line.IndexOf(prefix, StringComparison.Ordinal);
                if (at < 0) continue;

                string rest = line[(at + prefix.Length)..];
                int slash = rest.IndexOf(Path.DirectorySeparatorChar);
                if (slash > 0) names.Add(rest[..slash]);
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // Processes come and go, and other users' are not ours to read.
        }
    }

    return names;
}

/// Move matching entries into the capture inbox, numbering rather than
/// overwriting anything already there with the same name.
static void MoveWithBackup(string sourceDir, string pattern)
{
    if (!Directory.Exists(sourceDir))
    {
        Ui.Warn($"Skipping {sourceDir} (not present)");
        return;
    }

    string[] entries = pattern == "*"
        ? Directory.GetFileSystemEntries(sourceDir)
        : Directory.GetFiles(sourceDir, pattern);

    if (entries.Length == 0) return;

    List<string> mvArgs = new() { "--backup=numbered" };
    mvArgs.AddRange(entries.OrderBy(e => e, StringComparer.Ordinal));
    mvArgs.Add(Paths.TaskCaptureBin + "/");

    Sys.Run("mv", [.. mvArgs]);
}

/// Empty a directory without removing the directory itself.
static void EmptyDirectory(string directory)
{
    if (!Directory.Exists(directory)) return;

    // A shell glob, because `rm -rf dir/*` is exactly the semantics wanted:
    // clear the contents, leave the directory in place.
    Sys.Run("/bin/sh", "-c", $"rm -rf -- '{directory.Replace("'", @"'\''")}'/*");
}

static void DeleteFilesNamed(string pattern)
    => Sys.Sudo("find", Paths.Home + "/", "-type", "f", "-iname", pattern, "-delete");

static void DeleteDirectoriesNamed(string root, string name)
    => Sys.Sudo("find", root + "/", "-type", "d", "-iname", name, "-prune", "-exec", "rm", "-rf", "{}", ";");
