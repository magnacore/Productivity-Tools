#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Play the video whose URL sits on the first line of a text file, streaming it
// straight into mpv without ever writing it to disk.

ArgVals a = new Args("video-stream", "Stream the video URL on the first line of a text file")
    .Pos("file", "The text file to process")
    .Parse(args);

string inputFile = a.Str("file");

if (!File.Exists(inputFile))
{
    Console.Error.WriteLine($"Error: The file at '{inputFile}' was not found.");
    Snd.Error();
    return 1;
}

string? firstLine;
try
{
    firstLine = File.ReadLines(inputFile).FirstOrDefault()?.Trim();
}
catch (Exception ex)
{
    Console.Error.WriteLine($"An unexpected error occurred: {ex.Message}");
    Snd.Error();
    return 1;
}

if (string.IsNullOrWhiteSpace(firstLine))
{
    Console.Error.WriteLine($"Error: '{inputFile}' has no URL on its first line.");
    Snd.Error();
    return 1;
}

Ui.Begin("Streaming video...");

// yt-dlp muxes to stdout and mpv reads from stdin, so nothing is stored. The
// format cap keeps the stream at a bitrate that plays smoothly while downloading.
// A pipe is the mechanism here, so this genuinely needs a shell.
string quoted = firstLine.Replace("'", @"'\''");
int code = Proc.Shell(
    "/opt/anaconda3/envs/util/bin/yt-dlp " +
    "-f \"bestvideo[height<=?1080]+bestaudio[abr<=130]/best[height<=?1080]\" " +
    $"--merge-output-format mkv -o - '{quoted}' 2>/dev/null | mpv -");

Ui.End();
return code;
