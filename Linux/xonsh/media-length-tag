#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Sum the duration of every video whose name contains a tag, across one or more
// directory trees — "how much Linux material is left in here?"
//
//     Usage from ranger:  :shell -w media-length-tag -t linux Folder_1 Folder_2
//     Select the root folder and run. Do not descend into it first.
//
// Takes the tag as an argument and never prompts. media-length-tag-tui asks for it
// in a dialog and calls this.

ArgVals a = new Args("media-length-tag", "Sum the duration of tagged videos in directory trees")
    .Opt("-t", "--tag", required: true, help: "The tag to look for")
    .Rest("directories", min: 1, help: "Directories to search")
    .Parse(args);

Ui.Begin("Summing media duration in directory");

string tagText = a.Str("tag");

foreach (string directory in a.Rest)
{
    if (!Directory.Exists(directory))
    {
        Ui.Warn($"Skipping {directory} (not a directory)");
        continue;
    }

    Ui.Begin($"Summing media duration in {directory}");

    // Match on the file name only, so a tag in a parent folder does not sweep in
    // everything beneath it.
    List<string> matches = new();
    foreach (string path in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
    {
        string name = Fs.SplitExt(Path.GetFileName(path)).Name;

        if (Fs.IsVideo(path) && name.Contains(tagText, StringComparison.OrdinalIgnoreCase))
            matches.Add(path);
        else
            Ui.Line($"[yellow]Skipping {Ui.Esc(Path.GetFileName(path))}[/]");
    }

    matches.Sort(StringComparer.Ordinal);

    IReadOnlyList<double> durations = Ui.TrackParallel(matches, "[bold cyan]Adding : [/]", Media.Duration);

    Table table = Ui.NewTable("Media Duration", "Duration", "File name");
    table.Columns[0].RightAligned();
    table.Columns[1].LeftAligned();

    double totalDuration = 0.0;
    for (int i = 0; i < matches.Count; i++)
    {
        totalDuration += durations[i];
        table.AddRow(
            Ui.Dim(i, $"[green]{Media.Hms(durations[i])}[/]"),
            Ui.Dim(i, Ui.Esc(Path.GetFileName(matches[i]))));
    }

    Ui.AddSeparator(table);

    (double Divisor, string Label)[] speeds =
    [
        (1.0,  "Total media duration"),
        (1.5,  "Total media duration @1.5x"),
        (1.65, "Total media duration @1.65x"),
        (1.82, "Total media duration @1.82x"),
        (2.0,  "Total media duration @2x"),
    ];

    for (int i = 0; i < speeds.Length; i++)
    {
        // Alternate the summary rows too, so the block reads with the same banding
        // as the file list above it.
        table.AddRow(
            Ui.Dim(i, $"[bold green]{Media.Hms(totalDuration / speeds[i].Divisor)}[/]"),
            Ui.Dim(i, $"[bold green]{speeds[i].Label}[/]"));
    }

    Ui.Show(table);
}

return Ui.Done();
