#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Empty the capture inbox onto the queue drive.
//
// Each lettered folder in the inbox is a category you sort into by hand; this
// moves each one to its matching folder on the drive. The letters exist so the
// inbox sorts into a fixed, familiar order.

var a = Sys.WithDryRun(new Args("queue-move", "Move categorised inbox folders onto the queue drive")).Parse(args);
Sys.Apply(a);

Ui.Begin("Moving queue...");

var inbox = Paths.TaskCaptureBin;
var queue = Path.Combine(Paths.Media, "QUEUE_01_A", "QUEUE");

// (inbox folder, destination under QUEUE/)
(string From, string To)[] moves =
[
    ("A-RELAX PASSIVE ASSORTED",                  "RELAX PASSIVE ASSORTED"),
    ("B-RELAX PASSIVE MAGIC",                     "RELAX PASSIVE MAGIC"),
    ("C-STUDY PASSIVE TRADING",                   "STUDY PASSIVE TRADING"),
    ("D-STUDY PASSIVE DATA SCIENCE",              "STUDY PASSIVE DATA SCIENCE"),
    ("E-RELAX PASSIVE MOVIES",                    "RELAX PASSIVE MOVIES"),
    ("G-RELAX PASSIVE GAMES",                     "RELAX PASSIVE GAMES"),
    ("K-STUDY PASSIVE CRYPTO",                    "STUDY PASSIVE CRYPTO"),
    ("L-STUDY ACTIVE LINUX",                      "STUDY ACTIVE LINUX"),
    ("M-RELAX PASSIVE LEARNING 01 MONEY FI",      "RELAX PASSIVE LEARNING/01 MONEY"),
    ("O-RELAX PASSIVE LEARNING 04 OTHERS",        "RELAX PASSIVE LEARNING/04 OTHERS"),
    ("P-STUDY PASSIVE ASSORTED",                  "STUDY PASSIVE ASSORTED"),
    ("R-RELAX PASSIVE LEARNING 03 AR",            "RELAX PASSIVE LEARNING/03 AR"),
    ("U-RELAX PASSIVE SPORTS",                    "RELAX PASSIVE SPORTS"),
    ("V-RELAX PASSIVE LEARNING 02 HEALTH VEGAN LE", "RELAX PASSIVE LEARNING/02 HEALTH VEGAN LE"),
];

foreach (var (from, to) in moves)
{
    // Every destination is built from Paths.Media. The xonsh original hardcoded
    // /media/manuj/ on the STUDY ACTIVE LINUX line, which would have broken for
    // any other user.
    Sys.MoveContents(Path.Combine(inbox, from), Path.Combine(queue, to) + "/");
}

return Ui.Done();
