#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package PdfPig@0.1.15
#:property Configuration=Release
#:include utilities.cs

// Split PDFs into fixed-size parts, naming each with its part number, how many
// pages remain, and how far through the document it is:
//
//     book-0003-0120r-045p.pdf

using UglyToad.PdfPig;
using UglyToad.PdfPig.Writer;

var a = Jobs.Add(new Args("pdf-split", "Split PDFs into parts of N pages")
    .Pos("split_page", "Pages per part")
    .Rest("files", min: 1, help: "PDFs to split"))
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);
int splitPage = Math.Max(a.Int("split_page", 10), 1);

Ui.Begin($"Splitting PDFs to {splitPage} pages each...");

var pdfs = allFiles.Where(Fs.IsPdf).ToList();
if (pdfs.Count == 0) return Ui.NoFiles("No PDFs selected!");

int failures = 0;

// Documents are split concurrently — each opens its own PdfDocument, writes its own
// parts, and shares nothing with the others. The overall bar counts documents and
// stays pinned below the per-document bars; each per-document bar counts its pages.
Ui.Track2(pdfs, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Splitting {pdfs.Count} PDF(s)..."))}[/]",
          (fname, addBar) =>
{
    try
    {
        var (fileName, _) = Fs.SplitExt(fname);

        using var pdf = PdfDocument.Open(fname);
        int totalPages = pdf.NumberOfPages;

        // Every description is padded to one width by FitDescription, so the bar
        // starts in the same column for every document however long its title.
        var advance = addBar(
            $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Splitting {fname}:"))}[/]", totalPages);

        int part = 1;
        int countdown = totalPages;
        var builder = new PdfDocumentBuilder();

        for (int page = 1; page <= totalPages; page++)
        {
            builder.AddPage(pdf, page);
            advance(1);

            // Flush when the part is full, or when the document runs out.
            if (builder.Pages.Count == splitPage || page == totalPages)
            {
                int pagePercent = page * 100 / totalPages;
                var outputFilename =
                    $"{fileName}-{part:D4}-{countdown:D4}r-{pagePercent:D3}p.pdf";

                File.WriteAllBytes(outputFilename, builder.Build());

                // Every part inherits the book's date, offset by a millisecond
                // each, so the group sits where the book did in a modified-time
                // sort and the parts keep their order inside it.
                Fs.CopyTimestamp(fname, outputFilename, part - 1);

                part++;
                countdown -= splitPage;
                builder = new PdfDocumentBuilder();
            }
        }
    }
    catch (Exception ex)
    {
        Ui.Line($"[bold red]Could not split {Ui.Esc(fname)}: {ex.Message}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
