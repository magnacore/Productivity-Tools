#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Copy the live dotfiles and configs into the Productivity-Tools repository, so
// they can be committed from there.
//
// Despite the name this runs no git commands — it only stages the files. Commit
// and push yourself, after reading the diff.

var a = Sys.WithDryRun(new Args("dotfiles-git", "Copy live dotfiles and configs into the tools repository")).Parse(args);
Sys.Apply(a);

Ui.Begin("Copying dotfiles...");

var repo = Path.Combine(Paths.Home, "Projects", "Productivity-Tools", "Linux");
var dotfilesPath = Path.Combine(repo, "dotFiles") + "/";
var configPath = Path.Combine(repo, "config") + "/";

// Single files, copied to whichever of the two collection directories they belong in.
(string Source, string Destination)[] files =
[
    (".bashrc",                      dotfilesPath),
    (".bash_aliases",                dotfilesPath),
    (".xonshrc",                     dotfilesPath),
    (".alacritty.yml",               dotfilesPath),
    (".config/nvim/init.lua",        dotfilesPath),
    (".Xresources",                  dotfilesPath),
    (".config/picom/picom.conf",     dotfilesPath),
    (".config/mpv/mpv.conf",         configPath),
    (".config/zathura/zathurarc",    configPath),
    (".config/greenclip.toml",       configPath),
    (".var/app/net.christianbeier.Gromit-MPX/config/gromit-mpx.cfg", configPath),
    (".config/sxiv/exec/image-info", configPath),
    (".config/cmus/autosave",        configPath),
];

foreach (var (source, destination) in files)
    Sys.Rsync("--delete", "--progress", "-vahi", Path.Combine(Paths.Home, source), destination);

// Whole directories. The trailing slashes matter to rsync: they mean "the
// contents of", so the tree is mirrored rather than nested one level deeper.
(string Source, string Destination)[] directories =
[
    (".local/bin",     Path.Combine(repo, "xonsh")),
    (".config/ranger", Path.Combine(repo, "config", "ranger")),
    (".config/rofi",   Path.Combine(repo, "config", "rofi")),
    (".config/qtile",  Path.Combine(repo, "config", "qtile")),
];

foreach (var (source, destination) in directories)
    Sys.Rsync("--delete", "--progress", "-vahi",
              Path.Combine(Paths.Home, source) + "/", destination + "/");

return Ui.Done();
