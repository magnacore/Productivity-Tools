#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Bind a set of images into a single multi-page PDF, one image per page —
// for turning a folder of scans back into a document.

ArgVals a = new Args("image-combine-pdf", "Combine images into a single multi-page PDF")
    .Rest("files", min: 1, help: "Images to combine, in page order")
    .Parse(args);

Ui.Begin("Combining images to pdf....");

// Sorted, because the file order is the page order.
List<string> images = Fs.SortedFiles(a.Rest).Where(Fs.IsImage).ToList();

if (images.Count == 0) return Ui.NoFiles("No images selected!");

foreach (string image in images) Ui.Line($"[green]Adding {Ui.Esc(image)}[/]");

string outputFilename = $"combined_{Fs.Timestamp()}.pdf";

List<string> magickArgs = new();
magickArgs.AddRange(images);
magickArgs.Add(outputFilename);

if (!Proc.Ok("magick", magickArgs))
{
    Ui.Err("Could not build the PDF.");
    Snd.Error();
    Ui.End();
    return 1;
}

Ui.Ok($"Combined {images.Count} images into {outputFilename}");

return Ui.Done();
