#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Turn a file name into a note. For each selected file, write a timestamped
// Markdown file whose contents are that file's name — a way to capture "deal
// with this later" without moving the file itself.

ArgVals a = new Args("file-convert-text", "Write each file's name into a timestamped .md note")
    .Rest("files", min: 1, help: "Files to convert")
    .Parse(args);

IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);

Ui.Begin("Converting filenames to text...");

Ui.Track(files, "[bold cyan]Converting : [/]", file =>
{
    (string? name, string _) = Fs.SplitExt(file);
    string newFilename = $"{name}_{Fs.Timestamp()}.md";

    try
    {
        File.WriteAllText(newFilename, file + Environment.NewLine);

        // Give the note the date of the file it is about, so it sorts beside it.
        // The name and the date deliberately disagree after this: the name records
        // when the note was captured, the date records what it is about. The xonsh
        // original did neither — it touched the file and let the write overwrite it —
        // but every other text producer here (image-convert-text, pdf-convert-text,
        // ocr-genai) carries the source's date across, and these folders are read in
        // modified-time order.
        Fs.CopyTimestamp(file, newFilename);
    }
    catch (Exception ex) { Ui.Line($"[bold red]Could not write {Ui.Esc(newFilename)}: {ex.Message}[/]"); }
});

return Ui.Done();
