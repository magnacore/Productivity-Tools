#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Strip the "-007r-030p" progress markers that file-tag-percentage adds.

using System.Text.RegularExpressions;

var a = new Args("file-tag-remove-percentage", "Remove the remaining/percent tag from file names")
    .Rest("files", min: 1, help: "Files to untag")
    .Parse(args);

var files = Fs.SortedFiles(a.Rest);

Ui.Begin("Removing percentage tag ...");

Ui.Track(files, "[bold cyan]Untagging : [/]", file =>
{
    var (name, ext) = Fs.SplitExt(file);
    var newFilename = (Pattern.PercentageTag().Replace(name, string.Empty) + ext).Trim();

    if (newFilename == file || newFilename.Length == 0) return;

    try { Fs.Move(file, newFilename); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not untag {Ui.Esc(file)}: {ex.Message}[/]"); }
});

Ui.End();
return 0;

/// Source-generated matchers. Emitted at build time, so nothing parses a pattern
/// at startup — which matters for a program that runs for well under a second.
internal static partial class Pattern
{
    /// The "-007r-030p" progress marker that file-tag-percentage adds.
    [GeneratedRegex(@"-\d{1,4}r-\d{1,4}p")]
    internal static partial Regex PercentageTag();
}
