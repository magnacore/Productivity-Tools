#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror the queue drive. No snapshots here: the queue is a staging area whose
// contents are meant to be consumed and moved on, not preserved.

var a = Sys.WithDryRun(new Args("queue-backup", "Mirror QUEUE_01_A onto QUEUE_01_B")).Parse(args);
Sys.Apply(a);

Ui.Begin("Backing up queue...");

Sys.Rsync("-vahiP", "--delete",
          Path.Combine(Paths.Media, "QUEUE_01_A", "QUEUE") + "/",
          Path.Combine(Paths.Media, "QUEUE_01_B", "QUEUE_BACKUP") + "/");

Sys.Stamp("queue-backup");

return Ui.Done();
