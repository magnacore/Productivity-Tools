#!/bin/sh
//bin/true; /usr/bin/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for media-length-move.
//
// You choose how many hours you want to listen for; this converts that into the
// media duration that fills it, and hands the number to media-length-move. All
// the actual work lives there.

ArgVals a = new Args("media-length-move-tui", "Choose a media bundle size in a dialog, then run media-length-move")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

// (listening hours, label)
(int Minutes, string Label)[] durations =
[
    (60,  "1 hour"),
    (120, "2 hours"),
    (180, "3 hours"),
    (240, "4 hours"),
];

int? chosen = Dlg.Choose(
    "Media Length Move",
    "Select the target duration for the media bundle @1.5x:",
    [.. durations.Select(d => d.Label), "Custom..."]);

if (chosen is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

// Custom sits past the end of the preset list.
int? listeningMinutes = chosen.Value < durations.Length
    ? durations[chosen.Value].Minutes
    : AskListeningTime();

if (listeningMinutes is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

bool? sortByTime = Dlg.YesNo(
    "Sorting Preference",
    "Sort files by modified time?\n(Selecting 'No' will sort alphabetically by name)");

if (sortByTime is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

// The choice is how long you want to listen; at 1.5x that consumes 1.5x as much
// media, so the bundle has to be that much longer. A custom answer means the same
// thing as a preset one -- listening time, not media length -- so it is multiplied
// the same way.
int durationMinutes = (int)(listeningMinutes.Value * 1.5);
string sortArg = sortByTime.Value ? "true" : "false";

Ui.Info($"\nRunning media-length-move (Duration: {durationMinutes}m, " +
        $"Sort by modified time: {sortByTime.Value})...\n");

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]media-length-move -d {durationMinutes} -s {sortArg}[/]");
    return 0;
}

return Proc.Call("media-length-move", "-d", durationMinutes.ToString(), "-s", sortArg);

/// Ask how long you want to listen for, until an answer parses or the dialog is
/// cancelled. Returns whole minutes, which is what media-length-move takes.
///
/// Re-asking with the reason beats abandoning the run over a typo.
static int? AskListeningTime()
{
    string message = "How long do you want to listen for?\n\nGive a unit: 1h, 39m, 90m.";

    while (true)
    {
        string? typed = Dlg.Input("Custom listening time", message);
        if (typed is null) return null;

        int? seconds = Media.ParseDuration(typed);

        // Whole minutes, because that is the unit the program downstream takes. Anything
        // under half a minute would round to nothing, so it is refused rather than
        // quietly becoming a zero-length bundle.
        if (seconds is not null)
        {
            int minutes = (int)Math.Round(seconds.Value / 60.0);
            if (minutes >= 1) return minutes;

            message = $"\"{typed}\" is under a minute.\n\nGive a unit: 1h, 39m, 90m.";
            continue;
        }

        message = $"\"{typed}\" is not a duration.\n\nGive a number and a unit: 1h, 39m, 90m.";
    }
}
