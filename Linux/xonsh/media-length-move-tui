#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for media-length-move.
//
// You choose how many hours you want to listen for; this converts that into the
// media duration that fills it, and hands the number to media-length-move. All
// the actual work lives there.

var a = new Args("media-length-move-tui", "Choose a media bundle size in a dialog, then run media-length-move")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

// (listening hours, label)
(int Minutes, string Label)[] durations =
[
    (60,  "1 hour"),
    (120, "2 hours"),
    (180, "3 hours"),
    (240, "4 hours"),
];

var chosen = Dlg.Choose(
    "Media Length Move",
    "Select the target duration for the media bundle @1.5x:",
    [.. durations.Select(d => d.Label)]);

if (chosen is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

var sortByTime = Dlg.YesNo(
    "Sorting Preference",
    "Sort files by modified time?\n(Selecting 'No' will sort alphabetically by name)");

if (sortByTime is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

// The choice is how long you want to listen; at 1.5x that consumes 1.5x as much
// media, so the bundle has to be that much longer.
int durationMinutes = (int)(durations[chosen.Value].Minutes * 1.5);
var sortArg = sortByTime.Value ? "true" : "false";

Ui.Info($"\nRunning media-length-move (Duration: {durationMinutes}m, " +
        $"Sort by modified time: {sortByTime.Value})...\n");

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]media-length-move -d {durationMinutes} -s {sortArg}[/]");
    return 0;
}

return Proc.Call("media-length-move", "-d", durationMinutes.ToString(), "-s", sortArg);
