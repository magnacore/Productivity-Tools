#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mux a subtitle file into a video as a single .mkv.
//
// Select the video and the subtitle in either order — whichever one looks like a
// video names the output.

var a = new Args("embed-subtitle", "Embed a subtitle file into a video as .mkv")
    .Rest("files", min: 2, help: "The video file and the subtitle file, in either order")
    .Parse(args);

if (a.Rest.Count != 2)
{
    Ui.Err("Select the video and the subtitle file.");
    Snd.Error();
    return 1;
}

var input1 = a.Rest[0];
var input2 = a.Rest[1];

Ui.Begin("Embedding subtitle in video...");

// Name the output after the video. Subtitle formats are unreliable to detect by
// mime type, so identify the video instead and treat the other file as the sub.
var videoInput = Fs.IsVideo(input1) ? input1 : input2;
var newFilename = $"{Fs.SplitExt(videoInput).Name}_{Fs.Timestamp()}.mkv";

// The order of the video and subtitle arguments does not matter to mkvmerge.
if (Proc.Ok("mkvmerge", "-o", newFilename, input1, input2, "--chapter-language", "en"))
{
    // Named after the video, so it inherits the video's date, not the subtitle's.
    Fs.CopyTimestamp(videoInput, newFilename);

    Ui.Ok($"Embedded in {newFilename}");
    return Ui.Done();
}

Ui.Err($"Could not embed in {newFilename}");
Snd.Error();
Ui.End();
return 1;
