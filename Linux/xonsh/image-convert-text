#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Read the text out of images with tesseract. For handwriting, layout-heavy
// scans or anything tesseract struggles with, use ocr-genai instead.

var a = Jobs.Add(new Args("image-convert-text", "OCR images into .txt files")
    .Rest("files", min: 1, help: "Images to read"))
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin("Optical Character Recognition...");

int failures = 0;

Ui.Track2(allFiles, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"OCR {allFiles.Count}:"))}[/]",
          (file, addBar) =>
{
    if (!Fs.IsImage(file)) return;

    // No progress to read out of this tool, so the bar is one step: the spinner
    // shows the file is in flight, and a failure leaves the bar visibly unfilled.
    var advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 1);

    // tesseract appends ".txt" to the output name itself.
    var outputFilename = Fs.SplitExt(file).Name;

    if (Proc.Ok("tesseract", file, outputFilename))
    {
        // These run concurrently, so give the text the image's date and keep a
        // modified-time sort in the same order as the images.
        advance(1);
        Fs.CopyTimestamp(file, outputFilename + ".txt");
        Ui.Line($"[green]Converted {Ui.Esc(file)}[/]");
    }
    else
    {
        Ui.Line($"[bold red]Could not convert {Ui.Esc(file)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
