#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Convert EPUBs to PDF or plain text with Calibre.
//
// The PDF defaults are a small, e-reader-shaped page with large type, which is
// what makes the output readable in a file manager's preview pane rather than
// being a print-shaped document nobody reads on screen.
//
// https://manual.calibre-ebook.com/generated/en/ebook-convert.html#pdf-output-options

var a = Jobs.Add(new Args("epub-convert-multiple", "Convert EPUBs to PDF or text")
    .Opt("-w", "--width", @default: "946", help: "Width of the PDF, in points")
    .Opt("-l", "--length", @default: "968", help: "Height of the PDF, in points")
    .Opt("-f", "--font_size", @default: "32", help: "Font size of the PDF")
    .Opt("-m", "--margin", @default: "10", help: "Margin of the PDF")
    .Opt("-o", "--output_format", @default: "pdf", choices: ["pdf", "txt"],
         help: "Output format")
    .Rest("files", min: 1, help: "Epubs to process"))
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);

var outputFormat = a.Str("output_format");
var dimension = $"{a.Int("width", 946)}x{a.Int("length", 968)}";
var fontSize = a.Str("font_size");
var margin = a.Str("margin");

Ui.Begin($"Converting epub to {outputFormat}...");

int failures = 0;

var epubs = allFiles.Where(Fs.IsEpub).ToList();
foreach (var skipped in allFiles.Where(f => !Fs.IsEpub(f)))
    Ui.Line($"[yellow]Skipping {Ui.Esc(skipped)}[/]");

if (epubs.Count == 0) return Ui.NoFiles("No EPUBs selected!");

// Each book is a separate ebook-convert run and they never touch each other's
// files, so convert several at once. Memory is the limit rather than cores here:
// PDF output drives a headless browser engine per book, which is far heavier than
// an ffmpeg fork — hence -j defaulting to what the free memory allows.
//
// A bar per book with the overall bar pinned underneath, so which books are in
// flight is visible rather than just how many are done.
Ui.Track2(epubs, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Convert {epubs.Count} epub(s):"))}[/]",
          (file, addBar) =>
{
    var outputFilename = $"{Fs.SplitExt(file).Name}.{outputFormat}";

    var convertArgs = new List<string> { file, outputFilename };

    if (outputFormat == "pdf")
    {
        // --custom-size overrides --paper-size; both are passed because Calibre
        // falls back to the paper size for anything the custom size leaves open.
        convertArgs.AddRange([
            "--custom-size", dimension,
            "--unit", "point",
            "--pdf-default-font-size", fontSize,
            "--paper-size", "a4",
            "--preserve-cover-aspect-ratio",
            "--pretty-print",
            "--pdf-page-margin-bottom", margin,
            "--pdf-page-margin-top", margin,
            "--pdf-page-margin-left", margin,
            "--pdf-page-margin-right", margin,
        ]);
    }

    // ebook-convert reports its own progress on stdout — "34% Running transforms
    // on e-book..." — so the bar tracks the real conversion rather than guessing.
    // The scale is a percentage; advance by the difference since the last report.
    var advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{file}:"))}[/]", 100);
    int reported = 0;

    bool ok = Proc.OkStreaming("ebook-convert", convertArgs, line =>
    {
        var percent = ProgressPercent(line);
        if (percent > reported)
        {
            advance(percent - reported);
            reported = percent;
        }
    });

    if (ok)
    {
        // A txt conversion reports far fewer stages than a PDF one, so top the bar
        // up rather than leaving it short of the end.
        if (reported < 100) advance(100 - reported);

        // Keep the book's own date so a modified-time sort of the library still
        // matches the order the epubs were in. These finish in arbitrary order, so
        // without this the output is a jumble under that sort.
        Fs.CopyTimestamp(file, outputFilename);
    }
    else
    {
        Ui.Line($"[bold red]Could not convert {Ui.Esc(file)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);

/// The leading percentage of an ebook-convert progress line, or 0 for anything else.
static int ProgressPercent(string line)
{
    int end = 0;
    while (end < line.Length && char.IsAsciiDigit(line[end])) end++;

    return end > 0 && end < line.Length && line[end] == '%'
           && int.TryParse(line.AsSpan(0, end), out var percent)
        ? Math.Clamp(percent, 0, 100)
        : 0;
}
