#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// A menu in front of audio-speed-change and audio-volume-change, for when you
// would rather pick from a list than remember the flags.
//
// All the work happens in those two programs; this only decides what to call.

ArgVals a = new Args("audio-process-tui", "Change audio speed or volume, interactively")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Audio/")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "Files to process")
    .Parse(args);

IReadOnlyList<string> allFiles = a.Rest;

Ui.Begin("Audio change...");

int? what = Dlg.Choose("Audio Process", "What do you want to change?", "Speed", "Volume");
if (what is null) { Ui.Warn("Operation cancelled by user."); return 0; }

string[] speeds  = ["0.5", "0.667", "0.7", "0.8", "0.9", "1.5", "1.65", "1.82", "2.0"];
string[] volumes = ["0.5", "2", "3", "4", "5"];

string program, flag, value;

if (what.Value == 0)
{
    int? pick = Dlg.Choose("Speed", "Select the playback speed:", speeds);
    if (pick is null) { Ui.Warn("Operation cancelled by user."); return 0; }
    (program, flag, value) = ("audio-speed-change", "-s", speeds[pick.Value]);
}
else
{
    int? pick = Dlg.Choose("Volume", "Select the volume multiplier:", volumes);
    if (pick is null) { Ui.Warn("Operation cancelled by user."); return 0; }
    (program, flag, value) = ("audio-volume-change", "-v", volumes[pick.Value]);
}

// Asked here rather than in the base programs, which take -d and never prompt.
bool? deleteChoice = a.Flag("delete") ? true : Dlg.DeleteOriginals("Audio");
if (deleteChoice is null) { Ui.Warn("Operation cancelled by user."); return 0; }
bool deleteOriginals = deleteChoice.Value;

List<string> callArgs = new() { flag, value };
if (deleteOriginals) callArgs.Add("-d");
callArgs.AddRange(allFiles);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]{program} {string.Join(' ', callArgs)}[/]");
    return 0;
}

int code = Proc.Call(program, callArgs);

if (code != 0)
{
    Snd.Error();
    Ui.End();
    return code;
}

Ui.End();
return 0;
