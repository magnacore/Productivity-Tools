#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Extract the text of PDFs into sibling .txt files.
//
// This uses poppler's pdftotext rather than a PDF library: on real typeset books
// it gets column order, ligatures and hyphenation right, which is what makes the
// output worth feeding to text-to-speech.

ArgVals a = Jobs.Add(new Args("pdf-convert-text", "Extract text from PDFs into .txt files")
    .Flag("-l", "--layout", help: "Preserve the original physical layout")
    .Rest("files", min: 1, help: "PDFs to convert"))
    .Parse(args);

IReadOnlyList<string> allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin("Converting PDFs to text...");

List<string> pdfs = allFiles.Where(Fs.IsPdf).ToList();
if (pdfs.Count == 0) return Ui.NoFiles("No PDFs selected!");

if (!Proc.Exists("pdftotext"))
{
    Ui.Err("pdftotext is not installed (it ships with poppler-utils).");
    Snd.Error();
    Ui.End();
    return 1;
}

int failures = 0;

Ui.Track2(pdfs, $"[bold cyan]{Ui.Esc(Ui.FitDescription($"Converting {pdfs.Count} PDF(s):"))}[/]",
          (fname, addBar) =>
{
    // No progress to read out of this tool, so the bar is one step: the spinner
    // shows the file is in flight, and a failure leaves the bar visibly unfilled.
    Action<double> advance = addBar($"[bold cyan]{Ui.Esc(Ui.FitDescription($"{fname}:"))}[/]", 1);

    string outputFilename = Fs.SplitExt(fname).Name + ".txt";

    List<string> pdftotextArgs = new();
    if (a.Flag("layout")) pdftotextArgs.Add("-layout");
    pdftotextArgs.Add(fname);
    pdftotextArgs.Add(outputFilename);

    if (Proc.Ok("pdftotext", pdftotextArgs))
    {
        // Give the text the PDF's own date. These run concurrently, so creation
        // order is arbitrary — without this, a folder sorted by modified time
        // shows the extracted text in a jumble instead of following the PDFs.
        advance(1);
        Fs.CopyTimestamp(fname, outputFilename);
        Ui.Line($"[green]Converted {Ui.Esc(fname)}[/]");
    }
    else
    {
        Ui.Line($"[bold red]Could not convert {Ui.Esc(fname)}[/]");
        Interlocked.Increment(ref failures);
    }
}, Jobs.From(a));

return Ui.Done(failures);
