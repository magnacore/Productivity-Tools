#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Zero-pad numeric directory names one level down ("1 Intro" -> "001 Intro"), then
// prefix the files in each with that directory's index, so a course numbers itself.

var a = new Args("directory-number", "Zero-pad numbered directories and number their files")
    .Pos("directory", "The directory to process")
    .Parse(args);

var walkDir = a.Str("directory").TrimEnd('/');

if (!Directory.Exists(walkDir))
{
    Console.Error.WriteLine($"error: not a directory: {walkDir}");
    return 1;
}

Ui.Begin($"Numbering directories and files in {walkDir}");

// --- Pad numeric prefixes to three digits -----------------------------------
foreach (var subdir in Directory.GetDirectories(walkDir).OrderBy(d => d, StringComparer.Ordinal))
{
    var name = Path.GetFileName(subdir);
    if (name.Length < 2 || !char.IsDigit(name[0])) continue;

    // One leading digit needs two zeros, two need one, three or more are done.
    var padded = char.IsDigit(name[1]) ? (name.Length > 2 && char.IsDigit(name[2]) ? null : "0" + name)
                                       : "00" + name;
    if (padded is null) continue;

    try { Fs.Move(subdir, Path.Combine(walkDir, padded)); }
    catch (Exception ex) { Ui.Warn($"Could not rename {name}: {ex.Message}"); }
}

// --- Prefix files with the index of the directory holding them ---------------
// The top directory is index 0, then each immediate subdirectory in name order.
var roots = new List<string> { walkDir };
roots.AddRange(Directory.GetDirectories(walkDir).OrderBy(d => d, StringComparer.Ordinal));

int i = 0;
foreach (var root in roots)
{
    foreach (var file in Directory.GetFiles(root).OrderBy(f => f, StringComparer.Ordinal))
    {
        var newName = $"{i:D3}_{Path.GetFileName(file)}";
        try { Fs.Move(file, Path.Combine(root, newName)); }
        catch (Exception ex) { Ui.Warn($"Could not rename {Path.GetFileName(file)}: {ex.Message}"); }
    }
    i++;
}

return Ui.Done();
