#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Report disk, RAM and trash usage. Run on its own, and by shortcut-update at
// the end of every maintenance pass.

Ui.Begin("Space used: ");

// `df -h /home | grep /dev` — a pipe is the point here, so use a real shell.
string dfLine = Proc.ShellCapture("df -h /home | grep /dev").Trim();
string[] fields = dfLine.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);

if (fields.Length >= 5)
{
    string total = fields[1];
    string used = fields[2];
    string free = fields[3];

    // The capacity column looks like "83%"; drop the sign to do arithmetic on it.
    int.TryParse(fields[4].TrimEnd('%'), out int usedPercentage);

    Ui.Info("Used Disk Space: ");
    Ui.Line($"{Ui.Esc(used)} of {Ui.Esc(total)} or {usedPercentage}% of disk is used.\n");

    Ui.Info("Free Disk Space: ");
    Ui.Line($"{Ui.Esc(free)} of {Ui.Esc(total)} or {100 - usedPercentage}% of disk is free.\n");
}
else
{
    Ui.Warn("Could not read disk usage for /home.");
}

Proc.Run("df", "-h");
Console.WriteLine();

Ui.Info("Used RAM Space: ");
Proc.Run("free", "-h");

Ui.Info("\nUsed Trash Space: ");
Proc.Run("du", "-hs", Path.Combine(Paths.Home, ".local", "share", "Trash"));

Ui.End();
return 0;
