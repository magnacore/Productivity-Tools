#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Restore $HOME from the full-backup disk, one directory at a time.
//
// Deliberately a list rather than a single rsync of $HOME: restoring is when you
// are least able to afford a surprise, and an explicit list means nothing outside
// it can be touched. Every entry uses --delete, so each restored directory ends
// up matching the backup exactly.
//
// Mount the disk first with laptop-backup-full-mount.

var a = Sys.WithDryRun(new Args("laptop-restore", "Restore $HOME directories from the full-backup disk"))
    .Opt("-s", "--source", help: "Backup root to restore from")
    .Rest("directories", min: 0, help: "Only restore these directories (default: all)")
    .Parse(args);
Sys.Apply(a);

var fromPath = a.StrOrNull("source")
    ?? Path.Combine(Paths.Media, "laptop_backup_full", "@current");

if (!Sys.DryRun && !Directory.Exists(fromPath))
{
    Ui.Err($"Backup not found at {fromPath}");
    Ui.Line("[dim]Run laptop-backup-full-mount first.[/]");
    Snd.Error();
    return 1;
}

Ui.Begin($"Restoring from {fromPath}");

// Everything this system keeps in $HOME that is worth restoring.
string[] allDirectories =
[
    ".fonts", ".gnupg", ".icons", ".password-store", ".local/bin",
    "Backups", "Books", "Copy_To_HDD", "Desktop", "Documents", "Downloads",
    "Installers", "Music", "My_Cmaps", "Pictures", "Productivity_System",
    "Projects", "Public", "Software", "Templates", "To_Convert", "Videos",
    "VirtualBox VMs", "Wiki",
];

// Restoring one directory is the common case after losing just one thing.
var directories = a.Rest.Count > 0 ? [.. a.Rest] : allDirectories;

foreach (var directory in directories)
{
    var source = Path.Combine(fromPath, directory) + "/";
    var destination = Path.Combine(Paths.Home, directory) + "/";

    Ui.Info($"Restoring {directory}...");
    Sys.Rsync("--delete", "--progress", "-vahi", source, destination);
}

return Ui.Done();
