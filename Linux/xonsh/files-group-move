#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Group files that share a name stem and move each group into a folder named
// after it. Select everything and run — files with no siblings are left alone.
//
//     lecture-part-01.mkv, lecture-part-02.mkv  ->  lecture/lecture-part-0*.mkv
//     stray.mkv                                 ->  untouched

using System.Text.RegularExpressions;

ArgVals a = new Args("files-group-move", "Move files into folders named after their common prefix")
    .Rest("files", min: 1, help: "Files to group")
    .Parse(args);

// Candidate groups: files in the same directory whose names match once digits
// and dots are removed, so "ep01.mkv" and "ep02.mkv" land together.
Dictionary<(string Key, string Dir), List<string>> groups = new();

foreach (string filePath in a.Rest)
{
    string directory = Path.GetDirectoryName(filePath) ?? string.Empty;
    string file = Path.GetFileName(filePath);
    string key = new(file.Where(ch => !char.IsDigit(ch) && ch != '.').ToArray());

    if (!groups.TryGetValue((key, directory), out List<string>? list))
        groups[(key, directory)] = list = [];
    list.Add(file);
}

Ui.Begin("Grouping files...");

foreach (((string Key, string Dir) key, List<string>? group) in groups)
{
    // A group of one is just a file; there is nothing to gather.
    if (group.Count <= 1) continue;

    string folderName = CleanPrefix(LongestCommonPrefix(group));
    if (folderName.Length == 0)
    {
        Ui.Warn($"Skipping {group.Count} files with no usable common prefix.");
        continue;
    }

    string folderPath = Path.Combine(key.Dir, folderName);
    Directory.CreateDirectory(folderPath);

    foreach (string file in group)
    {
        try { Fs.Move(Path.Combine(key.Dir, file), Path.Combine(folderPath, file)); }
        catch (Exception ex) { Ui.Err($"Could not move {file}: {ex.Message}"); }
    }

    Ui.Ok($"Moved {group.Count} files into {folderName}/");
}

return Ui.Done();

static string LongestCommonPrefix(List<string> strings)
{
    if (strings.Count == 0) return string.Empty;

    string shortest = strings.MinBy(s => s.Length)!;
    for (int i = 0; i < shortest.Length; i++)
        foreach (string other in strings)
            if (other[i] != shortest[i]) return shortest[..i];

    return shortest;
}

/// Drop the part-numbering tail the common prefix inevitably ends with, so
/// "lecture-part-0" becomes "lecture".
static string CleanPrefix(string prefix)
{
    prefix = Regex.Replace(prefix, @"[-_]*(part)?[-_]*\d*$", string.Empty, RegexOptions.IgnoreCase);
    return prefix.TrimEnd('-', '_');
}
