#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Pull a single track out of a Matroska file. mkvinfo is printed first so you can
// read off the track IDs, then you pick one per file.

var a = new Args("mkv-extract-track", "Extract a chosen track from Matroska files")
    .Opt("-t", "--track", required: true,
         help: "Track ID to extract, applied to every file (mkvinfo lists them)")
    .Flag("-d", "--delete", help: "Trash the originals instead of filing them under Original_Media/")
    .Rest("files", min: 1, help: "Files to extract from")
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin("Extracting track form .mkv...");

bool deleteOriginals = a.Flag("delete");

foreach (var file in allFiles)
{
    if (!Fs.IsMedia(file)) continue;

    Ui.Begin($"Extracting track form {file}");

    var trackId = a.Int("track");
    var (filename, _) = Fs.SplitExt(file);

    // The output keeps a ".rename" suffix on purpose: only you know what
    // container the extracted track actually belongs in.
    if (Proc.Ok("mkvextract", file, "tracks", $"{trackId}:{filename}.rename"))
    {
        // Before the original is moved away.
        Fs.CopyTimestamp(file, $"{filename}.rename");
        Ui.Good($" Extracted: {file}");
        Fs.HandleOriginal(file, deleteOriginals, "Media");
    }
    else
    {
        Ui.Err($" Unable to extract: {file}");
    }
}

return Ui.Done();
