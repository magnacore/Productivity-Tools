#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Lay a looped background track under a spoken recording.
//
// The music is slowed by the factor you intend to listen at, so that when the
// result is played back at that speed the music comes out at its natural tempo.

using System.Text.Json;

var a = new Args("audio-add-music", "Mix looped background music under a spoken audio file")
    .Opt("-v", "--volume", @default: "0.4",
         help: "Background music level, 0.1 to 1.0")
    .Opt("-s", "--speed", @default: "1.5",
         help: "Playback speed you will listen at, so the music comes out at natural tempo")
    .Opt("-m", "--music", required: true,
         help: "Which of the two files is the background music")
    .Rest("files", min: 2, help: "The spoken audio file and the background music, in either order")
    .Parse(args);

if (a.Rest.Count != 2)
{
    Ui.Err("Select two files: the audio and the background music.");
    Snd.Error();
    return 1;
}

var input1 = a.Rest[0];
var input2 = a.Rest[1];

Ui.Begin("Adding background music to audio...");

if (!Fs.IsAudio(input1) && !Fs.IsAudio(input2))
{
    Ui.Err("Select the audio and the background music.");
    Snd.Error();
    Ui.End();
    return 1;
}

double volume = Math.Clamp(a.Dbl("volume", 0.4), 0.01, 1.0);

// The mpv playback speeds this collection is listened at.
double playbackSpeed = Math.Clamp(a.Dbl("speed", 1.5), 0.5, 4.0);

// --music names one of the two inputs; whichever it is, the other is the speech.
var backgroundMusic = a.Str("music");

if (backgroundMusic != input1 && backgroundMusic != input2)
{
    Ui.Err($"--music must be one of the two files given: {input1} or {input2}");
    Snd.Error();
    Ui.End();
    return 2;
}

// From here on input1 is the speech and input2 is the music.
if (backgroundMusic == input1) (input1, input2) = (input2, input1);

var newFilename = $"{Fs.SplitExt(input1).Name}-{Fs.Timestamp()}.opus";

// Match the music's own bitrate so the mix does not become the weakest link.
int bitrate = 0;
var bitrateJson = Proc.Capture("ffprobe", "-v", "quiet", "-print_format", "json", "-show_streams", input2);

try
{
    using var doc = JsonDocument.Parse(bitrateJson);
    foreach (var stream in doc.RootElement.GetProperty("streams").EnumerateArray())
    {
        if (stream.TryGetProperty("codec_type", out var type) && type.GetString() == "audio")
        {
            if (stream.TryGetProperty("bit_rate", out var br) &&
                int.TryParse(br.GetString(), out var bps))
                bitrate = bps / 1000;
            break;
        }
    }
}
catch (Exception ex)
{
    Ui.Warn($"Could not read the music's bitrate ({ex.Message}); falling back to 128k.");
}

if (bitrate == 0) bitrate = 128;

Ui.Ok($"Target Bitrate {bitrate}kbps");

// [0:a] speech at full volume; [1:a] music looped, slowed to 1/playback speed and
// attenuated; amix ends with the speech (duration=first), and the pan folds the
// mix back down to plain stereo.
var filter =
    "[0:a]aformat=sample_fmts=fltp:sample_rates=44100:channel_layouts=stereo,volume=1.0[a0]; " +
    $"[1:a]atempo={(1 / playbackSpeed).ToString(CultureInfo.InvariantCulture)}," +
    "aformat=sample_fmts=fltp:sample_rates=44100:channel_layouts=stereo," +
    $"volume={volume.ToString(CultureInfo.InvariantCulture)}[a1]; " +
    "[a0][a1]amix=inputs=2:duration=first:dropout_transition=2," +
    "pan=stereo|c0<c0+c2|c1<c1+c3[aout]";

if (Proc.Ok("ffmpeg", "-i", input1, "-stream_loop", "-1", "-i", input2,
            "-filter_complex", filter, "-map", "[aout]",
            "-c:a", "libopus", "-b:a", $"{bitrate}k", newFilename))
{
    // Named after the speech track, so it inherits that file's date rather than
    // the music's.
    Fs.CopyTimestamp(input1, newFilename);

    Ui.Ok($"Added background music to {newFilename}");
    return Ui.Done();
}

Ui.Err($"Could not add background music to {newFilename}");
Snd.Error();
Ui.End();
return 1;
