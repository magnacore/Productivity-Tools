#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for audio-add-music.
//
// Asks which of the two files is the music, how loud it should sit, and the speed
// you will listen at. The mixing lives in audio-add-music.

ArgVals a = new Args("audio-add-music-tui", "Choose mix settings in a dialog, then run audio-add-music")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 2, help: "The spoken audio file and the background music, in either order")
    .Parse(args);

if (a.Rest.Count != 2)
{
    Ui.Err("Select two files: the audio and the background music.");
    Snd.Error();
    return 1;
}

int? which = Dlg.Choose("Background Music", "Which file is the background music?",
                       [Path.GetFileName(a.Rest[0]), Path.GetFileName(a.Rest[1])]);
if (which is null) { Ui.Warn("Operation cancelled by user."); return 0; }

// Most-used first, so the resting selection is usually the right one.
string[] volumes = ["0.4", "0.3", "0.2", "0.1", "0.5", "0.6", "0.7", "0.8", "0.9", "1.0"];
int? volume = Dlg.Choose("Music Level", "Choose the background music level:", volumes);
if (volume is null) { Ui.Warn("Operation cancelled by user."); return 0; }

// The mpv playback speeds this collection is listened at.
string[] speeds = ["1.5", "1.65", "1.82", "2.0", "1.0"];
int? speed = Dlg.Choose("Playback Speed", "Choose the speed you will listen at:", speeds);
if (speed is null) { Ui.Warn("Operation cancelled by user."); return 0; }

List<string> callArgs = new()
{
    "-m", a.Rest[which.Value],
    "-v", volumes[volume.Value],
    "-s", speeds[speed.Value],
};
callArgs.AddRange(a.Rest);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]audio-add-music {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("audio-add-music", callArgs);
