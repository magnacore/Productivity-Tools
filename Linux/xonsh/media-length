#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Sum the duration of every media file in the current directory, and show what
// that total costs at the playback speeds actually used for listening.

Ui.Begin("Summing media duration");

var allFiles = Fs.CurrentDirFiles();

// Split first so the "Skipping" notices are not interleaved with the progress bar.
var mediaFiles = new List<string>();
foreach (var file in allFiles)
{
    if (Fs.IsMedia(file)) mediaFiles.Add(file);
    else Ui.Line($"[yellow]Skipping {Ui.Esc(file)}[/]");
}

// ffprobe is a fork per file, so ask for them all at once.
var durations = Ui.TrackParallel(mediaFiles, "[bold cyan]Adding : [/]", Media.Duration);

var table = Ui.NewTable("Media Duration", "Duration", "File name");
table.Columns[0].RightAligned();
table.Columns[1].LeftAligned();

double totalDuration = 0.0;
for (int i = 0; i < mediaFiles.Count; i++)
{
    totalDuration += durations[i];
    table.AddRow(
        Ui.Dim(i, $"[green]{Media.Hms(durations[i])}[/]"),
        Ui.Dim(i, Ui.Esc(mediaFiles[i])));
}

Ui.AddSeparator(table);

// The speeds are the ones this collection is habitually listened at.
var speeds = new (double Divisor, string Label)[]
{
    (1.0,  "Total media duration"),
    (1.5,  "Total media duration @1.5x"),
    (1.65, "Total media duration @1.65x"),
    (1.82, "Total media duration @1.82x"),
    (2.0,  "Total media duration @2x"),
};

for (int i = 0; i < speeds.Length; i++)
{
    // Alternate the summary rows too, so the block reads with the same banding as
    // the file list above it.
    table.AddRow(
        Ui.Dim(i, $"[bold green]{Media.Hms(totalDuration / speeds[i].Divisor)}[/]"),
        Ui.Dim(i, $"[bold green]{speeds[i].Label}[/]"));
}

Ui.Show(table);

return Ui.Done();
