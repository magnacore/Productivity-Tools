#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Download every video listed in ~/Backups/youtube.txt.
//
// The list can hold plain video URLs, a full channel name
// (https://www.youtube.com/@thedocandchef), or a playlist URL.

ArgVals a = new Args("video-download", "Download the videos listed in ~/Backups/youtube.txt")
    .Flag("-u", "--no-update", help: "Skip the yt-dlp self-update")
    .Opt("-s", "--source", @default: "youtube", choices: ["youtube", "other"],
         help: "Which download profile to use")
    .Parse(args);

string source = Path.Combine(Paths.Backups, "youtube.txt");
string destination = Paths.Downloads;

if (!File.Exists(source))
{
    Ui.Err($"No URL list at {source}");
    Snd.Error();
    return 1;
}

Ui.Begin($"Downloading Online Videos from {source}");

// YouTube changes its player often enough that a stale yt-dlp is the usual
// cause of a failed run.
if (!a.Flag("no-update"))
{
    Ui.Info("Updating yt-dlp...");
    Proc.Run("/opt/anaconda3/envs/util/bin/pip", "install", "-U", "yt-dlp[default,curl-cffi]");
}

const string YtDlp = "/opt/anaconda3/envs/util/bin/yt-dlp";
const string Python = "/opt/anaconda3/envs/util/bin/python";
const string OutputTemplate = "%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s";

List<string> ytArgs = new() { YtDlp };

if (a.Str("source") == "youtube")
{
    // -ci: continue partial downloads, and keep going past a video that fails.
    // The sleep intervals keep the request rate low enough not to be throttled.
    // Subtitles are fetched, converted to SRT and embedded, then the loose .srt
    // files are removed before each download so they cannot accumulate.
    ytArgs.AddRange([
        "-ci", "--merge-output-format", "mkv",
        "-f", "bestvideo[height<=1080]+bestaudio",
        "-P", destination, "-o", OutputTemplate,
        "--retries", "infinite",
        "--sleep-interval", "3", "--max-sleep-interval", "5", "--sleep-subtitles", "3",
        "--write-subs", "--write-auto-sub", "--embed-subs", "--embed-metadata",
        "--sub-langs", "en", "--compat-options", "no-keep-subs",
        "--convert-subs=srt", "--use-postprocessor", "srt_fix",
        "--exec", $"before_dl:rm {Paths.Home}/Downloads/'%(playlist)q'/*.en.srt",
        "-a", source,
    ]);
}
else
{
    ytArgs.AddRange([
        "-c", "--merge-output-format", "mkv",
        "-P", destination, "-o", OutputTemplate,
        "--retries", "infinite",
        "-a", source,
    ]);
}

Proc.Run(Python, ytArgs);

// A leftover .part file means that download never finished.
string naDir = Path.Combine(destination, "NA");
if (Directory.Exists(naDir))
{
    foreach (string filename in Directory.GetFiles(naDir, "*.part"))
        Ui.Err($"{Path.GetFileName(filename)} not downloaded.");
}

return Ui.Done();
