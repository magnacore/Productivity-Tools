#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror $HOME onto LAPTOP_BACKUP_D, which lives on the Sawy drive.

var a = Sys.WithDryRun(new Args("laptop-backup-d", "Mirror $HOME onto LAPTOP_BACKUP_D")).Parse(args);
Sys.Apply(a);

Ui.Begin("Laptop Backup D...");

var root = Path.Combine(Paths.Media, "SAWY_01_B", "LAPTOP_BACKUP_D");
var current = Path.Combine(root, "@current");

Sys.Remove(Sys.CopyLog);
Sys.RotatePreviousSnapshot(current + "/", Path.Combine(root, "@previous"));

Ui.Info("Synchronizing...");
Sys.SudoRsync("-vahiP", "--delete",
              $"--log-file={Sys.CopyLog}",
              $"--exclude-from={Sys.HomeExcludes}",
              Paths.Home + "/", current + "/");

Sys.Stamp("laptop-backup-d");
Sys.StampFile(Path.Combine(current, "backup_date.txt"));

return Ui.Done();
