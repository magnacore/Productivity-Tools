#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for password-generate.
//
// Picks what to generate and how long, then hands it over. The generating and the
// strength report live in password-generate.

var a = new Args("password-generate-tui", "Choose what to generate in a dialog, then run password-generate")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

var kind = Dlg.Choose("Generate", "What do you want to generate?", ["Password", "Seed phrase"]);
if (kind is null) { Ui.Warn("Operation cancelled by user."); return 0; }

List<string> callArgs;

if (kind.Value == 0)
{
    // pwgen will produce anything, but under 8 characters is not worth generating
    // and past a few hundred it is unusable as a password.
    var length = AskCount("Password Length", "How many characters?",
                          ["20", "24", "32", "48", "64"], @default: "20",
                          minimum: 8, maximum: 256, noun: "character count");
    if (length is null) return 0;

    callArgs = ["-t", "password", "-l", length];
}
else
{
    // passphraseme draws from a 7776-word list; below 6 words the result is weak
    // enough that the strength report is the interesting part, and 48 is well past
    // anything anyone transcribes by hand.
    var count = AskCount("Seed Phrase", "How many words?",
                         ["12", "15", "18", "21", "24"], @default: "12",
                         minimum: 6, maximum: 48, noun: "word count");
    if (count is null) return 0;

    callArgs = ["-t", "seed", "-w", count];
}

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]password-generate {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("password-generate", callArgs);

/// Offer a list of preset counts plus "Custom...", and validate anything typed.
///
/// Returns null when the user cancels, or when what they typed is not a sane count —
/// in which case the reason has already been reported. Same shape as the size dialogs
/// in pdf-split-tui and text-split-tui.
static string? AskCount(string title, string question, string[] presets,
                        string @default, int minimum, int maximum, string noun)
{
    var options = new List<string>(presets) { "Custom..." };

    var chosen = Dlg.Choose(title, question, [.. options]);
    if (chosen is null)
    {
        Ui.Warn("Operation cancelled by user.");
        return null;
    }

    if (chosen.Value < presets.Length) return presets[chosen.Value];

    // Ask again rather than give up, so a typo costs a keystroke instead of the whole
    // command. Only Cancel ends it, which keeps "cancelled" the single reason this
    // returns null and leaves the exit code unambiguous.
    var prompt = $"{question}\n(a whole number from {minimum} to {maximum})";
    var seed = @default;

    while (true)
    {
        var typed = Dlg.Input(title, prompt, seed);
        if (typed is null)
        {
            Ui.Warn("Operation cancelled by user.");
            return null;
        }

        typed = typed.Trim();

        if (int.TryParse(typed, NumberStyles.Integer, CultureInfo.InvariantCulture, out var value)
            && value >= minimum && value <= maximum)
        {
            return value.ToString(CultureInfo.InvariantCulture);
        }

        prompt = typed.Length == 0
            ? $"Enter a {noun} from {minimum} to {maximum}."
            : $"'{typed}' is not a {noun} from {minimum} to {maximum}. Try again.";

        // Offer the default back, rather than re-seeding the rejected text.
        seed = @default;
    }
}
