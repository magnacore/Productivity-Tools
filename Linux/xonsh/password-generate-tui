#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for password-generate.
//
// Picks what to generate and how long, then hands it over. The generating and the
// strength report live in password-generate.

var a = new Args("password-generate-tui", "Choose what to generate in a dialog, then run password-generate")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Parse(args);

var kind = Dlg.Choose("Generate", "What do you want to generate?", ["Password", "Seed phrase"]);
if (kind is null) { Ui.Warn("Operation cancelled by user."); return 0; }

List<string> callArgs;

if (kind.Value == 0)
{
    string[] lengths = ["20", "24", "32", "48", "64"];
    var length = Dlg.Choose("Password Length", "How many characters?", lengths);
    if (length is null) { Ui.Warn("Operation cancelled by user."); return 0; }

    callArgs = ["-t", "password", "-l", lengths[length.Value]];
}
else
{
    string[] words = ["12", "15", "18", "21", "24"];
    var count = Dlg.Choose("Seed Phrase", "How many words?", words);
    if (count is null) { Ui.Warn("Operation cancelled by user."); return 0; }

    callArgs = ["-t", "seed", "-w", words[count.Value]];
}

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]password-generate {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("password-generate", callArgs);
