#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Set permissions recursively, with separate modes for directories and files —
// directories need the execute bit to be traversable, files almost never do.

var a = new Args("directory-file-permission-set", "Set directory and file permissions recursively")
    .Opt("-d", "--directory_octal_permission", @default: "700",
         help: "Octal permission of the directories (e.g., 755)")
    .Opt("-f", "--file_octal_permission", @default: "600",
         help: "Octal permission of the files (e.g., 644)")
    .Flag("-n", "--dry-run", help: "Print what would be done without changing anything")
    .Rest("folder", min: 1, help: "Input directory to process")
    .Parse(args);

var dirPermission = a.Str("directory_octal_permission");
var filePermission = a.Str("file_octal_permission");
bool dryRun = a.Flag("dry-run");

foreach (var (permission, what) in new[] { (dirPermission, "directory"), (filePermission, "file") })
{
    if (!IsValidPermission(permission))
    {
        Console.Error.WriteLine(
            $"error: {permission} is not a valid {what} permission " +
            "(exactly 3 digits, none above 7)");
        return 2;
    }
}

foreach (var folder in a.Rest)
{
    if (!Directory.Exists(folder))
    {
        Ui.Warn($"Skipping {folder} (not a directory)");
        continue;
    }

    Ui.Begin($"Setting permissions in {folder}");

    // The path is used as given. The xonsh original prefixed "./", which quietly
    // limited it to folders directly below the working directory.
    foreach (var (type, permission) in new[] { ("d", dirPermission), ("f", filePermission) })
    {
        var label = type == "d" ? "directory" : "file";
        Ui.Line($"Setting {label} permissions in {Ui.Esc(folder)}...");

        if (dryRun)
        {
            Ui.Line($"[dim]find {Ui.Esc(folder)} -type {type} -exec chmod {permission} {{}} ;[/]");
            continue;
        }

        Proc.Run("find", folder, "-type", type, "-exec", "chmod", permission, "{}", ";");
    }
}

Ui.End();
return 0;

/// A permission code is exactly three octal digits.
static bool IsValidPermission(string permission)
    => permission.Length == 3 && permission.All(c => c is >= '0' and <= '7');
