#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Remove a "#tag" from file names — the inverse of file-tag.

ArgVals a = new Args("file-tag-remove", "Remove a #tag from file names")
    .Pos("tag", "The tag to remove, without the '#'")
    .Rest("files", min: 1, help: "Files to untag")
    .Parse(args);

string tag = a.Str("tag");
IReadOnlyList<string> files = Fs.SortedFiles(a.Rest);

Ui.Begin($"Removing tag #{tag}...");

Ui.Track(files, "[bold cyan]Untagging : [/]", file =>
{
    string newFilename = file.Replace($" #{tag}", string.Empty).Trim();

    if (newFilename == file || newFilename.Length == 0) return;

    try { Fs.Move(file, newFilename); }
    catch (Exception ex) { Ui.Line($"[bold red]Could not untag {Ui.Esc(file)}: {ex.Message}[/]"); }
});

Ui.End();
return 0;
