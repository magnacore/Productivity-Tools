#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Terminal.Gui@2.4.17
#:property Configuration=Release
#:include utilities.cs
#:include tui.cs

// Dialog front end for file-rename-extension.
//
// Picks the new extension, then hands it over. All the renaming lives there.

var a = new Args("file-rename-extension-tui", "Choose a new extension in a dialog, then rename")
    .Flag("-n", "--dry-run", help: "Show the composed command without running it")
    .Rest("files", min: 1, help: "Files to rename")
    .Parse(args);

string[] extensions = ["mkv", "opus", "mka", "txt", "md"];

var chosen = Dlg.Choose("Rename Extension", "Choose the new file extension:", extensions);

if (chosen is null)
{
    Ui.Warn("Operation cancelled by user.");
    return 0;
}

var callArgs = new List<string> { "-e", extensions[chosen.Value] };
callArgs.AddRange(a.Rest);

if (a.Flag("dry-run"))
{
    Ui.Line($"[dim]file-rename-extension {string.Join(' ', callArgs)}[/]");
    return 0;
}

return Proc.Call("file-rename-extension", callArgs);
