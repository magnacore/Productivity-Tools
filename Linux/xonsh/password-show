#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Reveal a stored password on screen, then run it past cracklib.
//
// The reveal goes through nms, which shows the text as scrambled characters that
// resolve on a keypress — so nothing readable sits on screen until you are ready
// to look, and glancing at the terminal in passing shows nothing.

ArgVals a = new Args("password-show", "Show a stored password and check its strength")
    .Pos("entry", "Name of the password store entry (see password-show-tui to pick from a list)")
    .Parse(args);

IReadOnlyList<string> entries = PassStore.Entries("password");

if (entries.Count == 0)
{
    Ui.Err($"No entries found in {PassStore.Root}/password");
    Snd.Error();
    return 1;
}

string selection = a.Str("entry");

if (!entries.Contains(selection, StringComparer.Ordinal))
{
    Ui.Err($"No entry named '{selection}' under {PassStore.Root}/password");
    Snd.Error();
    return 1;
}

Ui.Begin("Show password...");

string password = Proc.Capture("pass", $"password/{selection}");

if (string.IsNullOrEmpty(password))
{
    Ui.Err($"Could not read {selection}");
    Snd.Error();
    Ui.End();
    return 1;
}

// The trailing newline matters: the xonsh original piped this through `echo`,
// which appends one. Without it nms finishes mid-line, and the rule that follows
// starts at that column and wraps into a short broken stub.
Proc.Pipe(password.TrimEnd('\n') + "\n", "nms", "-as", "-f", "green");

Ui.End();

// cracklib only wants the password itself, which is the first line.
string firstLine = password.Split('\n')[0].Trim();

if (Proc.Exists("cracklib-check")) Proc.Pipe(firstLine + "\n", "cracklib-check");
else Ui.Warn("cracklib-check is not installed; skipping the strength check.");

return Ui.Done();
