#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror $HOME onto LAPTOP_BACKUP_C, keeping three generations on a rotating
// set of slots: @s_0 is live, @s_minus_1 and @s_minus_2 are older states.
//
// Unlike backups A, B and D this one applies no exclude list — it is the
// full-fidelity copy, taken deliberately without filtering.

ArgVals a = Sys.WithDryRun(new Args("laptop-backup-c", "Mirror $HOME onto LAPTOP_BACKUP_C with 3-deep history")).Parse(args);
Sys.Apply(a);

Ui.Begin("Laptop Backup C...");

string root = Path.Combine(Paths.Media, "LAPTOP_BACKUP_C");
string s0 = Path.Combine(root, "@s_0");
string s1 = Path.Combine(root, "@s_minus_1");
string s2 = Path.Combine(root, "@s_minus_2");

Sys.Remove(Sys.CopyLog);

// Rotate oldest-first, so no slot is ever overwritten while still needed.
Ui.Info("Deleting @s_minus_2 snapshot...");
Sys.DeleteSubvolume(s2);

Ui.Info("Promoting @s_minus_1 to @s_minus_2...");
Sys.Snapshot(s1, s2);
Sys.DeleteSubvolume(s1);

Ui.Info("Promoting @s_0 to @s_minus_1...");
Sys.Snapshot(s0, s1);

Ui.Info("Synchronizing to @s_0...");
Sys.SudoRsync("-vahiP", "--delete", "--exclude=.gvfs",$"--log-file={Sys.CopyLog}", Paths.Home + "/", s0 + "/");

Sys.Stamp("laptop-backup-c");
Sys.StampFile(Path.Combine(s0, "backup_date.txt"));

return Ui.Done();
