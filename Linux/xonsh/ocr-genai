#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:package Google.Apis.Auth@1.71.0
#:property Configuration=Release
#:include utilities.cs

// Read text out of PDFs and images with Gemini on Vertex AI.
//
// Use this when tesseract struggles — handwriting, multi-column layouts, tables,
// or scans where structure matters. The model is asked for Markdown, so headings
// and tables survive; image-convert-text remains the cheap local option.
//
// This talks to the REST endpoint directly rather than pulling in the full Vertex
// SDK: it is one generateContent call, and the service account already gives us
// everything needed to sign a bearer token.

using System.Net.Http.Headers;
using System.Text.Json;
using System.Text.Json.Nodes;
using Google.Apis.Auth.OAuth2;

var a = new Args("ocr-genai", "Extract text from PDFs and images using Gemini on Vertex AI")
    .Opt("-m", "--model", @default: "gemini-2.5-flash", help: "Model to use")
    .Opt("-p", "--project", @default: "gen-lang-client-0634600367", help: "Google Cloud project id")
    .Opt("-L", "--location", @default: "us-central1", help: "Vertex AI location")
    .Rest("files", min: 1, help: "PDFs or images to read")
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);

var privateKey = Path.Combine(Paths.SensitiveData, "gemini-service-account-ocr.json");
if (!File.Exists(privateKey))
{
    Ui.Err($"Missing service account key: {privateKey}");
    Snd.Error();
    return 1;
}

Ui.Begin("Extracting text using Vertex AI OCR...");

string accessToken;
try
{
    // The service account JSON is exchanged for a short-lived bearer token.
    var credential = GoogleCredential.FromFile(privateKey)
        .CreateScoped("https://www.googleapis.com/auth/cloud-platform");
    accessToken = await credential.UnderlyingCredential.GetAccessTokenForRequestAsync();
}
catch (Exception ex)
{
    Ui.Err($"Could not authenticate: {ex.Message}");
    Snd.Error();
    Ui.End();
    return 1;
}

var model = a.Str("model");
var project = a.Str("project");
var location = a.Str("location");
var endpoint = $"https://{location}-aiplatform.googleapis.com/v1/projects/{project}" +
               $"/locations/{location}/publishers/google/models/{model}:generateContent";

const string Prompt =
    "Extract all the text from this document or image. Provide only the extracted text " +
    "with proper markdown formatting. Do not add conversational filler or explanations.";

using var http = new HttpClient { Timeout = TimeSpan.FromMinutes(10) };
http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);

foreach (var file in allFiles)
{
    var kind = Fs.Mime(file, 1);
    var isSupported = Fs.IsPdf(file) || Fs.IsImage(file);

    if (!isSupported)
    {
        Ui.Warn($"Skipping {file}: Unsupported type '{kind ?? "unknown"}'");
        continue;
    }

    var textFilename = Fs.SplitExt(file).Name + ".txt";

    try
    {
        var mimeType = Fs.Mime(file, 0) is { } top && Fs.Mime(file, 1) is { } sub
            ? $"{top}/{sub}"
            : Fs.IsPdf(file) ? "application/pdf" : "image/jpeg";

        var fileData = Convert.ToBase64String(File.ReadAllBytes(file));

        // Built as a JSON DOM rather than from anonymous types. File-based apps
        // compile with trim/AOT-friendly defaults, under which reflection-based
        // serialization is switched off — JsonSerializer.Serialize on an anonymous
        // type throws at runtime, and is the one thing the source generator cannot
        // be pointed at either. The array *constructors* matter: the collection
        // initializer form binds to the generic JsonArray.Add<T>, which carries the
        // same trimming warnings.
        var body = new JsonObject
        {
            ["contents"] = new JsonArray(
                new JsonObject
                {
                    ["role"] = "user",
                    ["parts"] = new JsonArray(
                        new JsonObject
                        {
                            ["inlineData"] = new JsonObject
                            {
                                ["mimeType"] = mimeType,
                                ["data"] = fileData,
                            },
                        },
                        new JsonObject { ["text"] = Prompt }),
                }),
        };

        Ui.Info($"Reading {file}...");

        using var content = new StringContent(
            body.ToJsonString(), Encoding.UTF8, "application/json");
        using var response = await http.PostAsync(endpoint, content);

        var responseText = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
            Ui.Err($"Failed to process {file}: {(int)response.StatusCode} {responseText}");
            continue;
        }

        var extracted = ExtractText(responseText);
        if (extracted is null)
        {
            Ui.Err($"Failed to process {file}: the model returned no text.");
            continue;
        }

        File.WriteAllText(textFilename, extracted, Encoding.UTF8);

        // Keep the source's date, so the text sorts alongside its original.
        Fs.CopyTimestamp(file, textFilename);

        Ui.Good($"{textFilename} created.");
    }
    catch (Exception ex)
    {
        Ui.Err($"Failed to process {file}: {ex.Message}");
    }
}

return Ui.Done();

/// Pull the generated text out of a generateContent response, concatenating the
/// parts the model split its answer into.
static string? ExtractText(string json)
{
    using var doc = JsonDocument.Parse(json);

    if (!doc.RootElement.TryGetProperty("candidates", out var candidates) ||
        candidates.GetArrayLength() == 0)
        return null;

    var sb = new StringBuilder();
    foreach (var candidate in candidates.EnumerateArray())
    {
        if (!candidate.TryGetProperty("content", out var content) ||
            !content.TryGetProperty("parts", out var parts))
            continue;

        foreach (var part in parts.EnumerateArray())
            if (part.TryGetProperty("text", out var text))
                sb.Append(text.GetString());
    }

    return sb.Length == 0 ? null : sb.ToString();
}
