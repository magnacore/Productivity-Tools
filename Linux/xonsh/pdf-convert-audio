#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Turn PDFs into audiobooks, by chaining two other programs in this suite:
//
//     pdf-convert-text  ->  text-to-speech
//
// The PDF's modification time is carried onto the audio, so a date-sorted
// library keeps its order.

var a = new Args("pdf-convert-audio", "Convert PDFs to audio by chaining text extraction and TTS")
    .Rest("files", min: 1, help: "PDF files to convert")
    .Parse(args);

var allFiles = Fs.SortedFiles(a.Rest);

Ui.Begin("Convert pdf to audio...");

int converted = 0;

foreach (var file in allFiles)
{
    if (!Fs.IsPdf(file))
    {
        Ui.Warn($"Skipping {file}");
        continue;
    }

    var (filename, _) = Fs.SplitExt(file);
    var textFilename = filename + ".txt";
    var outputAudioFilename = filename + ".mkv";

    Ui.Info($"Extracting text from {file}...");
    if (Proc.Call("pdf-convert-text", file) != 0 || !File.Exists(textFilename))
    {
        Ui.Err($"Could not extract text from {file}");
        Snd.Error();
        continue;
    }

    Ui.Info($"Synthesising speech for {textFilename}...");
    if (Proc.Call("text-to-speech", textFilename) != 0 || !File.Exists(outputAudioFilename))
    {
        Ui.Err($"Could not convert {textFilename} to speech");
        Snd.Error();
        continue;
    }

    // The extracted text was only an intermediate step.
    Fs.Trash(textFilename);

    Fs.CopyTimestamp(file, outputAudioFilename);

    Ui.Ok($"Converted {file} to {outputAudioFilename}");
    converted++;
}

if (converted == 0)
{
    Snd.Error();
    Ui.End();
    return 1;
}

return Ui.Done();
