#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Mirror $HOME into a mounted VeraCrypt volume.
//
// This one has no snapshot rotation: the encrypted container is the protection,
// and it is unlocked only while the backup runs.

ArgVals a = Sys.WithDryRun(new Args("laptop-backup-a", "Mirror $HOME into the VeraCrypt system backup")).Parse(args);
Sys.Apply(a);

Ui.Begin("Laptop Backup A...");

string destination = "/media/veracrypt1/SYSTEM_BACKUP";

// Start the log fresh so it describes this run and no other.
Sys.Remove(Sys.CopyLog);

Ui.Info("Synchronizing...");
Sys.SudoRsync("-vahi", "--partial", "--info=progress2", "--delete",
              $"--log-file={Sys.CopyLog}",
              $"--exclude-from={Sys.HomeExcludes}",
              Paths.Home + "/", destination + "/");

Sys.Stamp("laptop-backup-a");
Sys.StampFile(Path.Combine(destination, "backup_date.txt"));

return Ui.Done();
