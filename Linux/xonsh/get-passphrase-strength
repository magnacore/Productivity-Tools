#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// How long would a diceware passphrase survive a well-funded attacker?
//
// The threat model: someone spending $1,000,000,000 per day on AWS instances,
// each managing 193,900 guesses per second. Brute force finds the answer after
// searching half the keyspace on average, so that is what gets reported.

using System.Numerics;

var a = new Args("get-passphrase-strength", "Report passphrase entropy and time to brute force")
    .Pos("size", "Number of words in wordlist")
    .Pos("seedphrase_size", "Number of words in passphrase")
    .Parse(args);

int wordlistSize = a.Int("size");
int passphraseSize = a.Int("seedphrase_size");

if (wordlistSize < 2 || passphraseSize < 1)
{
    Console.Error.WriteLine("error: size must be >= 2 and seedphrase_size >= 1");
    return 2;
}

double entropyPerWord = Math.Log2(wordlistSize);

const long AwsGuessesPerSecondPerInstance = 193_900;
const double AwsInstanceCostPerHour = 24.48;
const double AttackerBudgetPerDay = 1_000_000_000;

double awsInstanceCostPerDay = AwsInstanceCostPerHour * 24;
long totalAwsInstances = (long)Math.Floor(AttackerBudgetPerDay / awsInstanceCostPerDay);
BigInteger totalGuessesPerSecond = new BigInteger(AwsGuessesPerSecondPerInstance) * totalAwsInstances;

Console.WriteLine($"Number of words: {wordlistSize}");
Console.WriteLine($"Entropy per word: {entropyPerWord}");
Console.WriteLine($"Each AWS instance has these many guesses per second: {Num.ToWords(AwsGuessesPerSecondPerInstance)}");
Console.WriteLine($"Attacker can afford this many AWS instances: {Num.ToWords(totalAwsInstances)}");
Console.WriteLine($"Attacker's total guesses per second: {Num.ToWords(totalGuessesPerSecond)}");
Console.WriteLine();

// The keyspace is wordlist^length, which is far past any fixed-width integer.
// Divide exactly rather than through a double: at these magnitudes a double has
// already discarded everything past the sixteenth digit, and the answer is
// reported down to the last one.
//
// Brute force finds the key after searching half the keyspace on average.
BigInteger totalKeyspace = BigInteger.Pow(wordlistSize, passphraseSize);
BigInteger avgTimeSeconds = totalKeyspace / (totalGuessesPerSecond * 2);

Console.WriteLine($"Number of words: {passphraseSize}");
Console.WriteLine($"Entropy: {Math.Round(passphraseSize * entropyPerWord, 1, MidpointRounding.ToEven)}");
Console.WriteLine($"Average time to brute force: {Num.HumanizeSeconds(avgTimeSeconds)}");

return 0;
