#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Drop the clipboard into a timestamped Markdown note in the capture inbox.
// The first few words become the file name, so the note is findable later.

var a = new Args("clipboard-convert-text", "Save the clipboard as a timestamped note")
    .Parse(args);

var clipboardContent = Clip.Paste();

// Only the opening words name the file; the whole clipboard goes inside.
var stem = Fs.Slug(clipboardContent.Length > 35 ? clipboardContent[..35] : clipboardContent);

if (string.IsNullOrEmpty(stem))
{
    Snd.Error();
    Snd.Notify("Clipboard is empty or unusable as a file name");
    return 1;
}

var fileName = Path.Combine(Paths.TaskCaptureBin, $"{stem}_{Fs.Timestamp()}.md");

try
{
    Directory.CreateDirectory(Paths.TaskCaptureBin);
    File.AppendAllText(fileName, clipboardContent + Environment.NewLine);
}
catch (Exception ex)
{
    Console.Error.WriteLine($"Could not write {fileName}: {ex.Message}");
    Snd.Error();
    return 1;
}

Snd.Success();
return 0;
