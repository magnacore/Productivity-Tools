#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Copy the files ranger has selected into its other pane, with a progress bar.
//
// Ranger's calling convention, which sets the argument layout: everything but
// the last argument is a selected file (%s / %c), and the last is the target
// directory (%d).

var a = new Args("file-copy-ranger", "Copy ranger-selected files to a target directory")
    .Rest("files_and_target", min: 2, help: "Files to copy, followed by the target directory")
    .Parse(args);

var allFiles = a.Rest.Take(a.Rest.Count - 1).ToList();
var targetDir = a.Rest[^1];

Ui.Begin("Copying files...");

// pycp gives a real progress bar and interactive overwrite prompts, which is
// the whole reason this is not a plain cp.
var pycpArgs = new List<string> { "/opt/anaconda3/envs/util/bin/pycp", "-gip" };
pycpArgs.AddRange(allFiles);
pycpArgs.Add(targetDir);

int code = Proc.Run("/opt/anaconda3/envs/util/bin/python", pycpArgs);

if (code != 0)
{
    Ui.Err("Copy failed.");
    return Ui.NoFiles("Copy failed.");
}

return Ui.Done();
