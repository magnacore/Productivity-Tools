#!/bin/sh
//bin/true; /opt/anaconda3/envs/dotnet/lib/dotnet/dotnet "$0" -- "$@"; __rc=$?; [ -t 1 ] && printf '\033[?1l\033>'; exit $__rc
#:package Spectre.Console@0.57.2
#:property Configuration=Release
#:include utilities.cs

// Slugify file names, then put them back into Title Case — turning
// "pocket_some ARTICLE.html" into "Some Article.html".

var a = new Args("file-rename-title", "Rename files to Title Case")
    .Rest("files", min: 1, help: "Files to rename")
    .Parse(args);

// Slugify first so accents, punctuation and odd spacing are gone, then title-case
// the clean result.
var files = Fs.RenameToValid(Fs.SortedFiles(a.Rest));

foreach (var file in files)
{
    var (name, ext) = Fs.SplitExt(file);
    var titled = Fs.TitleCase(name);

    string clean;
    if (ext.Length == 0)
    {
        // No extension means a directory.
        clean = titled;
    }
    else
    {
        clean = titled + ext;
        // Pocket exports carry the service name in front of every article.
        clean = clean.Replace("Pocket ", string.Empty);
        // TitleCase capitalises after the dot; ".tar" must stay lowercase.
        clean = clean.Replace(".Tar", ".tar");
    }

    if (file == clean) continue;

    try { Fs.Move(file, clean); }
    catch (Exception ex) { Ui.Err($"Could not rename {file}: {ex.Message}"); }
}

return 0;
